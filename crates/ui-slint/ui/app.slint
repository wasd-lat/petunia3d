import { Icon, IconDisplay, IconSet } from "@lucide";
import { ScrollView, Slider } from "std-widgets.slint";
import { DesignTokens } from "tokens.slint";
export { DesignTokens }

export struct CommandItem {
    id: string,
    label: string,
    shortcut: string,
    available: bool,
    disabled-reason: string,
}

export struct SceneItem {
    id: string,
    name: string,
    visible: bool,
    locked: bool,
    selected: bool,
    verts: int,
    tris: int,
}

component TopAction inherits Rectangle {
    in property <Icon> icon;
    in property <string> semantic-label;
    callback clicked;

    accessible-role: button;
    accessible-label: root.semantic-label;
    width: 32px;
    height: 28px;
    border-radius: 5px;
    background: (touch-area.pressed || touch-area.has-hover) ? DesignTokens.surface-hover : transparent;
    border-width: touch-area.has-hover ? 1px : 0px;
    border-color: DesignTokens.focus-ring;

    IconDisplay {
        icon: root.icon;
        size: 16px;
        stroke: DesignTokens.text-secondary;
    }

    touch-area := TouchArea {
        clicked => { root.clicked(); }
    }
}

component ToolButton inherits Rectangle {
    in property <Icon> icon;
    in property <string> semantic-label;
    in property <bool> active;
    callback clicked;

    accessible-role: button;
    accessible-label: root.semantic-label;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: active ? DesignTokens.accent : (touch-area.has-hover ? DesignTokens.surface-hover : transparent);
    border-width: !active && touch-area.has-hover ? 1px : 0px;
    border-color: DesignTokens.focus-ring;

    IconDisplay {
        icon: root.icon;
        size: 16px;
        stroke: active ? DesignTokens.canvas : DesignTokens.text-primary;
    }

    touch-area := TouchArea {
        clicked => { root.clicked(); }
    }
}

component ColorSwatch inherits Rectangle {
    in property <color> swatch-color;
    in property <bool> selected;
    callback clicked;

    accessible-role: button;
    accessible-label: "Color Swatch";
    width: 24px;
    height: 24px;
    border-radius: 4px;
    background: root.swatch-color;
    border-width: selected ? 2px : 1px;
    border-color: selected ? DesignTokens.accent : DesignTokens.border;

    TouchArea {
        clicked => { root.clicked(); }
    }
}

component NumericField inherits Rectangle {
    in property <string> label: "X";
    in property <float> value: 0.0;
    in property <color> label-color: DesignTokens.axis-x;
    callback scrubbed(float, bool);
    callback scrub-started;
    callback scrub-finished;
    callback text-committed(string);
    property <bool> editing: false;

    accessible-role: spinbox;
    accessible-label: root.label;
    accessible-value: Math.round(root.value * 100) / 100;

    height: 24px;
    border-radius: 4px;
    background: touch.pressed ? DesignTokens.surface-hover : DesignTokens.surface-raised;
    border-width: 1px;
    border-color: touch.pressed ? DesignTokens.accent : DesignTokens.border;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 4px;
        alignment: center;

        Text {
            text: root.label;
            color: root.label-color;
            font-size: 10px;
            font-weight: 700;
            vertical-alignment: center;
            width: 10px;
        }

        if !root.editing: Text {
            text: Math.round(root.value * 100) / 100;
            color: DesignTokens.text-primary;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-alignment: right;
            horizontal-stretch: 1;
        }

        if root.editing: TextInput {
            text: root.value;
            color: DesignTokens.text-primary;
            font-size: 11px;
            horizontal-stretch: 1;
            vertical-alignment: center;
            accepted => {
                root.text-committed(self.text);
                root.editing = false;
            }
        }
    }

    touch := TouchArea {
        property <length> start-x;
        property <bool> is-fine: false;
        pointer-event(event) => {
            is-fine = event.modifiers.shift;
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                start-x = self.mouse-x;
                root.scrub-started();
            } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                root.scrub-finished();
            }
        }
        moved => {
            if self.pressed {
                root.scrubbed((self.mouse-x - start-x) / 1px, is-fine);
                start-x = self.mouse-x;
            }
        }
        clicked => { root.editing = true; }
    }
}

component Vector3Field inherits HorizontalLayout {
    in property <string> row-label: "Position";
    in property <float> x-value: 0.0;
    in property <float> y-value: 0.0;
    in property <float> z-value: 0.0;
    callback scrubbed(int, float, bool);
    callback scrub-started;
    callback scrub-finished;
    callback text-committed(int, string);

    spacing: 6px;
    alignment: center;

    Text {
        text: root.row-label;
        color: DesignTokens.text-secondary;
        font-size: 11px;
        width: 52px;
        vertical-alignment: center;
    }

    NumericField {
        label: "X";
        value: root.x-value;
        label-color: DesignTokens.axis-x;
        horizontal-stretch: 1;
        scrubbed(delta, fine) => { root.scrubbed(0, delta, fine); }
        scrub-started => { root.scrub-started(); }
        scrub-finished => { root.scrub-finished(); }
        text-committed(text) => { root.text-committed(0, text); }
    }
    NumericField {
        label: "Y";
        value: root.y-value;
        label-color: DesignTokens.axis-y;
        horizontal-stretch: 1;
        scrubbed(delta, fine) => { root.scrubbed(1, delta, fine); }
        scrub-started => { root.scrub-started(); }
        scrub-finished => { root.scrub-finished(); }
        text-committed(text) => { root.text-committed(1, text); }
    }
    NumericField {
        label: "Z";
        value: root.z-value;
        label-color: DesignTokens.axis-z;
        horizontal-stretch: 1;
        scrubbed(delta, fine) => { root.scrubbed(2, delta, fine); }
        scrub-started => { root.scrub-started(); }
        scrub-finished => { root.scrub-finished(); }
        text-committed(text) => { root.text-committed(2, text); }
    }
}

component InspectorSection inherits Rectangle {
    in property <string> title;
    in property <bool> open: true;
    callback toggled;

    accessible-role: button;
    accessible-label: root.title;

    width: 100%;
    border-radius: 6px;
    background: DesignTokens.surface;
    border-width: 1px;
    border-color: DesignTokens.border;

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        HorizontalLayout {
            height: 20px;
            alignment: center;

            Text {
                text: root.title;
                color: DesignTokens.text-primary;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            IconDisplay {
                icon: root.open ? IconSet.ChevronDown : IconSet.ChevronRight;
                size: 12px;
                stroke: DesignTokens.text-muted;
            }

            TouchArea {
                clicked => { root.toggled(); }
            }
        }

        if root.open: Rectangle {
            height: 1px;
            background: DesignTokens.border;
        }

        VerticalLayout {
            visible: root.open;
            @children
        }
    }
}

export component PetuniaSlintShell inherits Window {
    title: "Petunia3D";
    preferred-width: 1280px;
    preferred-height: 800px;
    background: DesignTokens.canvas;
    forward-focus: root-focus;

    in-out property <string> active-workspace: "MODEL";
    in-out property <bool> inspector-visible: true;
    in-out property <bool> compact-shell: false;
    in-out property <bool> command-search-visible: false;
    in-out property <bool> scene-drawer-visible: false;
    in-out property <bool> scene-drawer-pinned: false;
    in-out property <bool> settings-visible: false;
    in-out property <bool> saved: true;
    in-out property <image> viewport-image;
    in-out property <bool> has-gpu-viewport: false;

    in-out property <[CommandItem]> command-results: [];
    in-out property <string> command-query: "";
    property <int> command-selection: 0;
    in-out property <float> pos-x: 0.0;
    in-out property <float> pos-y: 0.0;
    in-out property <float> pos-z: 0.0;
    in-out property <float> rot-x: 0.0;
    in-out property <float> rot-y: 0.0;
    in-out property <float> rot-z: 0.0;
    in-out property <float> scale-x: 1.0;
    in-out property <float> scale-y: 1.0;
    in-out property <float> scale-z: 1.0;

    in-out property <[SceneItem]> scene-items: [];
    in-out property <string> active-object-title: "Default Cube";
    in-out property <string> active-object-details: "Vertices: 8  ·  Faces: 6";
    in-out property <string> active-material-name: "Default Material";
    in-out property <string> scene-stats: "12 tris  ·  8 verts";
    in-out property <string> current-theme: "petunia-dark";

    in-out property <string> selection-domain: "OBJECT";
    in-out property <string> active-tool: "select";
    in-out property <bool> can-undo: false;
    in-out property <bool> can-redo: false;
    in-out property <string> status-message: "Ready";
    in-out property <color> paint-color: #b58cff;
    in-out property <float> brush-size: 0.8;
    in-out property <float> brush-opacity: 1.0;
    in-out property <bool> asset-library-visible: false;
    in-out property <bool> is-orthographic: false;
    in-out property <bool> is-wireframe: false;
    in-out property <bool> gizmo-visible: false;
    in-out property <length> gizmo-origin-x: 0px;
    in-out property <length> gizmo-origin-y: 0px;
    in-out property <length> gizmo-x-end-x: 0px;
    in-out property <length> gizmo-x-end-y: 0px;
    in-out property <length> gizmo-y-end-x: 0px;
    in-out property <length> gizmo-y-end-y: 0px;
    in-out property <length> gizmo-z-end-x: 0px;
    in-out property <length> gizmo-z-end-y: 0px;
    in-out property <bool> add-menu-open: false;

    callback workspace-changed(string);
    callback save-requested;
    callback search-requested;
    callback settings-requested;
    callback scene-requested;
    callback scene-pin-requested(bool);
    callback command-query-changed(string);
    callback command-executed(string);
    callback command-file-action(string);
    callback escape-requested;
    callback click-away-requested;
    callback transform-scrubbed(string, int, float, bool);
    callback transform-scrub-started(string);
    callback transform-scrub-finished;
    callback transform-text-committed(string, int, string);
    callback viewport-orbit(float, float);
    callback viewport-pan(float, float);
    callback viewport-zoom(float);
    callback viewport-resized(float, float);
    callback viewport-select(float, float, bool);
    callback viewport-transform-begin(string, float, float);
    callback viewport-transform-update(float, float);
    callback viewport-transform-end;
    callback viewport-paint-begin(float, float);
    callback viewport-paint-update(float, float);
    callback viewport-paint-end;
    callback add-menu-changed(bool);
    callback open-project-requested;
    callback scene-select(string);
    callback scene-toggle-visibility(string);
    callback scene-toggle-lock(string);
    callback theme-changed(string);

    callback undo-requested;
    callback redo-requested;
    callback selection-domain-changed(string);
    callback active-tool-changed(string);
    callback add-primitive-requested(string);
    callback delete-requested;
    callback duplicate-requested;
    callback asset-library-requested;
    callback toggle-projection-requested;
    callback toggle-wireframe-requested;
    callback reset-camera-requested;
    callback save-active-as-asset-requested;
    callback paint-color-changed(float, float, float);
    callback brush-size-changed(float);
    callback brush-opacity-changed(float);
    callback shortcut-requested(string, bool, bool, bool);

    changed command-search-visible => { root.command-selection = 0; }
    changed width => { root.compact-shell = self.width < 1100px; }

    root-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.escape-requested();
                return accept;
            }
            if !root.command-search-visible && !root.settings-visible && event.text != Key.Tab {
                root.shortcut-requested(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt);
                return accept;
            }
            reject
        }

        VerticalLayout {
            spacing: 0px;

            Rectangle {
                height: 42px;
                background: DesignTokens.surface;
                border-width: 1px;
                border-color: DesignTokens.border;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 10px;
                    alignment: center;
                    spacing: 12px;

                    Text {
                        text: "Petunia";
                        color: DesignTokens.text-primary;
                        font-size: 14px;
                        font-weight: 700;
                        width: 84px;
                    }

                    Rectangle {
                        height: 28px;
                        width: 96px;
                        border-radius: 6px;
                        background: active-workspace == "MODEL" ? DesignTokens.accent : DesignTokens.surface-raised;
                        Text {
                            text: "MODEL";
                            color: active-workspace == "MODEL" ? DesignTokens.canvas : DesignTokens.text-secondary;
                            font-size: 11px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.workspace-changed("MODEL"); } }
                    }

                    Rectangle {
                        height: 28px;
                        width: 96px;
                        border-radius: 6px;
                        background: active-workspace == "PAINT" ? DesignTokens.accent : DesignTokens.surface-raised;
                        Text {
                            text: "PAINT";
                            color: active-workspace == "PAINT" ? DesignTokens.canvas : DesignTokens.text-secondary;
                            font-size: 11px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.workspace-changed("PAINT"); } }
                    }

                    Rectangle {
                        height: 28px;
                        width: 96px;
                        border-radius: 6px;
                        background: active-workspace == "UV" ? DesignTokens.accent : DesignTokens.surface-raised;
                        Text {
                            text: "UV";
                            color: active-workspace == "UV" ? DesignTokens.canvas : DesignTokens.text-secondary;
                            font-size: 11px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.workspace-changed("UV"); } }
                    }

                    TopAction {
                        icon: IconSet.Undo;
                        semantic-label: "Undo";
                        clicked => { root.undo-requested(); }
                    }
                    TopAction {
                        icon: IconSet.Redo;
                        semantic-label: "Redo";
                        clicked => { root.redo-requested(); }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    if active-workspace == "MODEL": HorizontalLayout {
                        spacing: 3px;
                        alignment: center;

                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 4px;
                            background: selection-domain == "OBJECT" ? DesignTokens.accent : DesignTokens.surface-raised;
                            IconDisplay {
                                icon: IconSet.Box;
                                size: 15px;
                                stroke: selection-domain == "OBJECT" ? DesignTokens.canvas : DesignTokens.text-secondary;
                            }
                            TouchArea { clicked => { root.selection-domain-changed("OBJECT"); } }
                        }
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 4px;
                            background: selection-domain == "POINT" ? DesignTokens.accent : DesignTokens.surface-raised;
                            IconDisplay {
                                icon: IconSet.CircleDot;
                                size: 15px;
                                stroke: selection-domain == "POINT" ? DesignTokens.canvas : DesignTokens.text-secondary;
                            }
                            TouchArea { clicked => { root.selection-domain-changed("POINT"); } }
                        }
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 4px;
                            background: selection-domain == "EDGE" ? DesignTokens.accent : DesignTokens.surface-raised;
                            IconDisplay {
                                icon: IconSet.Minus;
                                size: 15px;
                                stroke: selection-domain == "EDGE" ? DesignTokens.canvas : DesignTokens.text-secondary;
                            }
                            TouchArea { clicked => { root.selection-domain-changed("EDGE"); } }
                        }
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 4px;
                            background: selection-domain == "FACE" ? DesignTokens.accent : DesignTokens.surface-raised;
                            IconDisplay {
                                icon: IconSet.Square;
                                size: 15px;
                                stroke: selection-domain == "FACE" ? DesignTokens.canvas : DesignTokens.text-secondary;
                            }
                            TouchArea { clicked => { root.selection-domain-changed("FACE"); } }
                        }
                    }

                    if active-workspace == "MODEL": Rectangle { horizontal-stretch: 1; }

                    TopAction {
                        icon: IconSet.Plus;
                        semantic-label: "Add Primitive";
                        clicked => { root.add-primitive-requested("cube"); }
                    }

                    Text {
                        text: saved ? "Saved" : "Unsaved";
                        color: saved ? DesignTokens.success : DesignTokens.text-secondary;
                        font-size: 11px;
                    }
                    TopAction {
                        icon: IconSet.PanelLeft;
                        semantic-label: "Parts";
                        clicked => { root.scene-requested(); }
                    }
                    TopAction {
                        icon: IconSet.FolderOpen;
                        semantic-label: "Open project";
                        clicked => { root.open-project-requested(); }
                    }
                    TopAction {
                        icon: IconSet.Save;
                        semantic-label: "Save project";
                        clicked => { root.save-requested(); }
                    }
                    TopAction {
                        icon: IconSet.Search;
                        semantic-label: "Command search";
                        clicked => { root.search-requested(); }
                    }
                    TopAction {
                        icon: IconSet.Settings;
                        semantic-label: "Settings";
                        clicked => { root.settings-requested(); }
                    }
                }
            }

            HorizontalLayout {
                spacing: 0px;
                horizontal-stretch: 1;
                vertical-stretch: 1;

                // Contextual Tool Tray. Workspaces live only in the header.
                Rectangle {
                    width: 40px;
                    background: DesignTokens.surface-raised;
                    border-width: 1px;
                    border-color: DesignTokens.border;

                    VerticalLayout {
                        padding-top: 10px;
                        padding-bottom: 10px;
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 6px;
                        alignment: start;

                        if active-workspace == "MODEL": VerticalLayout {
                            spacing: 6px;
                            ToolButton {
                                icon: IconSet.MousePointer2;
                                semantic-label: "Select";
                                active: active-tool == "select";
                                clicked => { root.active-tool-changed("select"); }
                            }
                            ToolButton {
                                icon: IconSet.Move;
                                semantic-label: "Move";
                                active: active-tool == "move";
                                clicked => { root.active-tool-changed("move"); }
                            }
                            ToolButton {
                                icon: IconSet.RotateCw;
                                semantic-label: "Rotate";
                                active: active-tool == "rotate";
                                clicked => { root.active-tool-changed("rotate"); }
                            }
                            ToolButton {
                                icon: IconSet.Scale3d;
                                semantic-label: "Scale";
                                active: active-tool == "scale";
                                clicked => { root.active-tool-changed("scale"); }
                            }
                            ToolButton {
                                icon: IconSet.Box;
                                semantic-label: "Add Cube";
                                active: false;
                                clicked => { root.add-primitive-requested("cube"); }
                            }
                            ToolButton {
                                icon: IconSet.CircleDot;
                                semantic-label: "Add Sphere";
                                active: false;
                                clicked => { root.add-primitive-requested("sphere"); }
                            }
                            ToolButton {
                                icon: IconSet.Scissors;
                                semantic-label: "Cut / Knife";
                                active: active-tool == "cut";
                                clicked => { root.active-tool-changed("cut"); }
                            }
                            ToolButton {
                                icon: IconSet.Maximize2;
                                semantic-label: "Frame Selection";
                                active: false;
                                clicked => { root.command-executed("view.frame_selection"); }
                            }
                        }

                        if active-workspace == "PAINT": VerticalLayout {
                            spacing: 6px;
                            ToolButton {
                                icon: IconSet.Paintbrush;
                                semantic-label: "Brush";
                                active: active-tool == "brush";
                                clicked => { root.active-tool-changed("brush"); }
                            }
                            ToolButton {
                                icon: IconSet.Eraser;
                                semantic-label: "Eraser";
                                active: active-tool == "eraser";
                                clicked => { root.active-tool-changed("eraser"); }
                            }
                            ToolButton {
                                icon: IconSet.Pipette;
                                semantic-label: "Color Picker";
                                active: active-tool == "picker";
                                clicked => { root.active-tool-changed("picker"); }
                            }
                            ToolButton {
                                icon: IconSet.PaintBucket;
                                semantic-label: "Fill Bucket";
                                active: active-tool == "fill";
                                clicked => { root.active-tool-changed("fill"); }
                            }
                        }

                        if active-workspace == "UV": VerticalLayout {
                            spacing: 6px;
                            ToolButton {
                                icon: IconSet.MousePointer2;
                                semantic-label: "UV Select";
                                active: active-tool == "uv_select";
                                clicked => { root.active-tool-changed("uv_select"); }
                            }
                            ToolButton {
                                icon: IconSet.Maximize2;
                                semantic-label: "Unwrap";
                                active: false;
                                clicked => { root.command-executed("uv.unwrap"); }
                            }
                            ToolButton {
                                icon: IconSet.Grid2x2;
                                semantic-label: "Pack Islands";
                                active: false;
                                clicked => { root.command-executed("uv.pack_islands"); }
                            }
                        }
                    }
                }

                viewport-region := Rectangle {
                    horizontal-stretch: 1;
                    background: DesignTokens.canvas;
                    border-width: 1px;
                    border-color: DesignTokens.border;

                    changed width => {
                        root.viewport-resized(self.width / 1px, self.height / 1px);
                    }
                    changed height => {
                        root.viewport-resized(self.width / 1px, self.height / 1px);
                    }

                    if has-gpu-viewport: Image {
                        width: 100%;
                        height: 100%;
                        image-fit: contain;
                        source: root.viewport-image;
                    }

                    if !has-gpu-viewport: Text {
                        text: "VIEWPORT\n\nSlint shell bootstrap\nGPU viewport remains behind PetuniaViewport";
                        color: DesignTokens.text-muted;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    viewport-touch := TouchArea {
                        property <length> last-x;
                        property <length> last-y;
                        property <bool> is-orbit: false;
                        property <bool> is-pan: false;
                        property <bool> moved-since-down: false;
                        property <bool> extend-selection: false;
                        property <bool> is-transform: false;
                        property <bool> is-painting: false;
                        property <string> local-kind: "";

                        function transform-tool() -> string {
                            if root.active-workspace != "MODEL" {
                                return "";
                            }
                            if root.active-tool == "move" {
                                return "pos";
                            }
                            if root.active-tool == "rotate" {
                                return "rot";
                            }
                            if root.active-tool == "scale" {
                                return "scale";
                            }
                            return "";
                        }

                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down {
                                last-x = self.mouse-x;
                                last-y = self.mouse-y;
                                moved-since-down = false;
                                extend-selection = event.modifiers.shift;
                                is-transform = false;
                                if event.button == PointerEventButton.middle {
                                    if event.modifiers.shift {
                                        is-pan = true;
                                        is-orbit = false;
                                    } else {
                                        is-orbit = true;
                                        is-pan = false;
                                    }
                                } else if event.button == PointerEventButton.left && event.modifiers.alt {
                                    is-orbit = true;
                                    is-pan = false;
                                } else if event.button == PointerEventButton.left
                                    && !event.modifiers.shift
                                    && !event.modifiers.alt {
                                    if root.active-workspace == "PAINT" {
                                        is-painting = true;
                                        root.viewport-paint-begin(self.mouse-x / 1px, self.mouse-y / 1px);
                                    } else {
                                        local-kind = self.transform-tool();
                                        if local-kind != "" {
                                            is-transform = true;
                                            root.viewport-transform-begin(local-kind, self.mouse-x / 1px, self.mouse-y / 1px);
                                        }
                                    }
                                }
                            } else if event.kind == PointerEventKind.up {
                                is-orbit = false;
                                is-pan = false;
                                if is-transform {
                                    root.viewport-transform-end();
                                    is-transform = false;
                                }
                                if is-painting {
                                    root.viewport-paint-end();
                                    is-painting = false;
                                }
                            }
                        }

                        moved => {
                            if is-orbit {
                                moved-since-down = true;
                                root.viewport-orbit((self.mouse-x - last-x) / 1px, (self.mouse-y - last-y) / 1px);
                                last-x = self.mouse-x;
                                last-y = self.mouse-y;
                            } else if is-pan {
                                moved-since-down = true;
                                root.viewport-pan((self.mouse-x - last-x) / 1px, (self.mouse-y - last-y) / 1px);
                                last-x = self.mouse-x;
                                last-y = self.mouse-y;
                            } else if is-transform {
                                moved-since-down = true;
                                root.viewport-transform-update(self.mouse-x / 1px, self.mouse-y / 1px);
                            } else if is-painting {
                                moved-since-down = true;
                                root.viewport-paint-update(self.mouse-x / 1px, self.mouse-y / 1px);
                            }
                        }

                        clicked => {
                            if !moved-since-down && !is-transform && !is-painting
                                && root.active-workspace != "PAINT" {
                                root.viewport-select(self.mouse-x / self.width, self.mouse-y / self.height, extend-selection);
                            }
                        }

                        scroll-event(event) => {
                            root.viewport-zoom(event.delta-y / 1px);
                            accept
                        }
                    }

                    Rectangle {
                        x: 14px;
                        y: 14px;
                        height: 28px;
                        border-radius: 5px;
                        background: DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            alignment: center;

                            Text {
                                text: active-workspace == "UV" ? "UV Dual View" : (active-workspace == "PAINT" ? "Texture Paint" : (is-orthographic ? "Orthographic" : "Perspective"));
                                color: DesignTokens.text-primary;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }

                            Rectangle { width: 1px; height: 16px; background: DesignTokens.border; }

                            Rectangle {
                                width: 22px;
                                height: 22px;
                                border-radius: 3px;
                                background: is-orthographic ? DesignTokens.accent : transparent;
                                IconDisplay {
                                    icon: IconSet.Camera;
                                    size: 13px;
                                    stroke: is-orthographic ? DesignTokens.canvas : DesignTokens.text-secondary;
                                }
                                TouchArea { clicked => { root.toggle-projection-requested(); } }
                            }

                            Rectangle {
                                width: 22px;
                                height: 22px;
                                border-radius: 3px;
                                background: is-wireframe ? DesignTokens.accent : transparent;
                                IconDisplay {
                                    icon: IconSet.Box;
                                    size: 13px;
                                    stroke: is-wireframe ? DesignTokens.canvas : DesignTokens.text-secondary;
                                }
                                TouchArea { clicked => { root.toggle-wireframe-requested(); } }
                            }

                            Rectangle {
                                width: 22px;
                                height: 22px;
                                border-radius: 3px;
                                IconDisplay {
                                    icon: IconSet.RotateCcw;
                                    size: 13px;
                                    stroke: DesignTokens.text-secondary;
                                }
                                TouchArea { clicked => { root.reset-camera-requested(); } }
                            }
                        }
                    }

                    Rectangle {
                        x: 14px;
                        y: parent.height - 48px;
                        width: 180px;
                        height: 28px;
                        border-radius: 5px;
                        background: DesignTokens.surface-raised;
                        Text {
                            text: "\{active-tool}  ·  \{active-workspace}";
                            color: DesignTokens.text-secondary;
                            font-size: 11px;
                            vertical-alignment: center;
                            x: 10px;
                        }
                    }

                    // Gizmo 3D projetado: três hastes do pivô da seleção.
                    if gizmo-visible && active-workspace == "MODEL": Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        background: transparent;

                        Path {
                            commands: "M \{gizmo-origin-x / 1px} \{gizmo-origin-y / 1px} L \{gizmo-x-end-x / 1px} \{gizmo-x-end-y / 1px}";
                            stroke: DesignTokens.axis-x;
                            stroke-width: 3px;
                            fill: transparent;
                        }
                        Path {
                            commands: "M \{gizmo-origin-x / 1px} \{gizmo-origin-y / 1px} L \{gizmo-y-end-x / 1px} \{gizmo-y-end-y / 1px}";
                            stroke: DesignTokens.axis-y;
                            stroke-width: 3px;
                            fill: transparent;
                        }
                        Path {
                            commands: "M \{gizmo-origin-x / 1px} \{gizmo-origin-y / 1px} L \{gizmo-z-end-x / 1px} \{gizmo-z-end-y / 1px}";
                            stroke: DesignTokens.axis-z;
                            stroke-width: 3px;
                            fill: transparent;
                        }
                        Rectangle {
                            x: gizmo-origin-x - 5px;
                            y: gizmo-origin-y - 5px;
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: DesignTokens.text-primary;
                            border-width: 1px;
                            border-color: DesignTokens.canvas;
                        }
                    }

                    // Barra contextual flutuante na base da viewport.
                    context-bar := Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: parent.height - self.height - 14px;
                        width: bar-row.preferred-width + 16px;
                        height: 40px;
                        border-radius: 10px;
                        background: DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        drop-shadow-blur: 12px;
                        drop-shadow-color: #00000066;
                        drop-shadow-offset-y: 3px;

                        bar-row := HorizontalLayout {
                            x: 8px;
                            y: 4px;
                            width: self.preferred-width;
                            height: self.preferred-height;
                            spacing: 4px;
                            alignment: center;

                            ToolButton {
                                icon: IconSet.MousePointer2;
                                semantic-label: "Select";
                                active: active-tool == "select";
                                clicked => { root.active-tool-changed("select"); }
                            }

                            if active-workspace != "PAINT": ToolButton {
                                icon: IconSet.Move;
                                semantic-label: "Move";
                                active: active-tool == "move";
                                clicked => { root.active-tool-changed("move"); }
                            }
                            if active-workspace != "PAINT": ToolButton {
                                icon: IconSet.RotateCw;
                                semantic-label: "Rotate";
                                active: active-tool == "rotate";
                                clicked => { root.active-tool-changed("rotate"); }
                            }
                            if active-workspace != "PAINT": ToolButton {
                                icon: IconSet.Scale3d;
                                semantic-label: "Scale";
                                active: active-tool == "scale";
                                clicked => { root.active-tool-changed("scale"); }
                            }

                            if active-workspace == "MODEL" && selection-domain == "OBJECT": Rectangle {
                                width: 1px;
                                height: 22px;
                                background: DesignTokens.border;
                            }
                            if active-workspace == "MODEL" && selection-domain == "OBJECT": ToolButton {
                                icon: IconSet.Plus;
                                semantic-label: "Add Primitive";
                                active: root.add-menu-open;
                                clicked => {
                                    root.add-menu-open = !root.add-menu-open;
                                    root.add-menu-changed(root.add-menu-open);
                                }
                            }
                            if active-workspace == "MODEL" && selection-domain == "OBJECT": ToolButton {
                                icon: IconSet.Copy;
                                semantic-label: "Duplicate";
                                clicked => { root.duplicate-requested(); }
                            }

                            if active-workspace == "MODEL" && selection-domain != "OBJECT": Rectangle {
                                width: 1px;
                                height: 22px;
                                background: DesignTokens.border;
                            }
                            if active-workspace == "MODEL" && selection-domain != "OBJECT": ToolButton {
                                icon: IconSet.Move3d;
                                semantic-label: "Extrude";
                                clicked => { root.command-executed("model.extrude"); }
                            }
                            if active-workspace == "MODEL" && selection-domain != "OBJECT": ToolButton {
                                icon: IconSet.SquareDashed;
                                semantic-label: "Inset";
                                clicked => { root.command-executed("model.inset"); }
                            }
                            if active-workspace == "MODEL" && selection-domain != "OBJECT": ToolButton {
                                icon: IconSet.CircleDot;
                                semantic-label: "Merge Center";
                                clicked => { root.command-executed("model.merge"); }
                            }

                            if active-workspace == "PAINT": ToolButton {
                                icon: IconSet.Paintbrush;
                                semantic-label: "Brush";
                                active: active-tool == "brush";
                                clicked => { root.active-tool-changed("brush"); }
                            }
                            if active-workspace == "PAINT": ToolButton {
                                icon: IconSet.Eraser;
                                semantic-label: "Eraser";
                                active: active-tool == "eraser";
                                clicked => { root.active-tool-changed("eraser"); }
                            }
                            if active-workspace == "PAINT": ToolButton {
                                icon: IconSet.Pipette;
                                semantic-label: "Color Picker";
                                active: active-tool == "picker";
                                clicked => { root.active-tool-changed("picker"); }
                            }
                            if active-workspace == "PAINT": ToolButton {
                                icon: IconSet.PaintBucket;
                                semantic-label: "Fill";
                                active: active-tool == "fill";
                                clicked => { root.active-tool-changed("fill"); }
                            }

                            if active-workspace == "UV": ToolButton {
                                icon: IconSet.Maximize2;
                                semantic-label: "Unwrap";
                                clicked => { root.command-executed("uv.unwrap_auto"); }
                            }
                            if active-workspace == "UV": ToolButton {
                                icon: IconSet.Grid2x2;
                                semantic-label: "Pack Islands";
                                clicked => { root.command-executed("uv.pack_islands"); }
                            }

                            Rectangle {
                                width: 1px;
                                height: 22px;
                                background: DesignTokens.border;
                            }
                            ToolButton {
                                icon: IconSet.Trash2;
                                semantic-label: "Delete";
                                clicked => { root.delete-requested(); }
                            }
                        }
                    }

                    // Menu de primitivas ancorado acima da barra contextual.
                    if add-menu-open && active-workspace == "MODEL": Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: context-bar.y - self.height - 8px;
                        width: 2 * 34px + 216px;
                        height: 88px;
                        border-radius: 10px;
                        background: DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        drop-shadow-blur: 12px;
                        drop-shadow-color: #00000066;
                        drop-shadow-offset-y: 3px;

                        HorizontalLayout {
                            padding: 8px;
                            spacing: 6px;
                            alignment: center;

                            ToolButton {
                                icon: IconSet.Box;
                                semantic-label: "Cube";
                                clicked => { root.add-primitive-requested("cube"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon: IconSet.CircleDot;
                                semantic-label: "Sphere";
                                clicked => { root.add-primitive-requested("sphere"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon: IconSet.Cylinder;
                                semantic-label: "Cylinder";
                                clicked => { root.add-primitive-requested("cylinder"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon: IconSet.Square;
                                semantic-label: "Plane";
                                clicked => { root.add-primitive-requested("plane"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon: IconSet.Triangle;
                                semantic-label: "Cone";
                                clicked => { root.add-primitive-requested("cone"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon: IconSet.Pill;
                                semantic-label: "Capsule";
                                clicked => { root.add-primitive-requested("capsule"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon: IconSet.Torus;
                                semantic-label: "Torus";
                                clicked => { root.add-primitive-requested("torus"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon: IconSet.Circle;
                                semantic-label: "Circle";
                                clicked => { root.add-primitive-requested("circle"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon: IconSet.Diamond;
                                semantic-label: "Icosphere";
                                clicked => { root.add-primitive-requested("icosphere"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon: IconSet.Pyramid;
                                semantic-label: "Wedge";
                                clicked => { root.add-primitive-requested("wedge"); root.add-menu-changed(false); }
                            }
                        }
                    }
                }

                Rectangle {
                    width: inspector-visible && !compact-shell ? 288px : 0px;
                    visible: inspector-visible && !compact-shell;
                    background: DesignTokens.surface;
                    border-width: 1px;
                    border-color: DesignTokens.border;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;
                        HorizontalLayout {
                            height: 28px;
                            Text {
                                text: active-workspace == "PAINT" ? "Paint Inspector" : (active-workspace == "UV" ? "UV Inspector" : "Context");
                                color: DesignTokens.text-primary;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text {
                                text: active-workspace;
                                color: DesignTokens.accent;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }

                        if active-workspace == "MODEL": VerticalLayout {
                            spacing: 10px;

                            if selection-domain == "OBJECT": InspectorSection {
                                title: "Transform";
                                toggled => { self.open = !self.open; }

                                VerticalLayout {
                                    spacing: 6px;
                                    padding-top: 4px;
                                    Vector3Field {
                                        row-label: "Position";
                                        x-value: root.pos-x;
                                        y-value: root.pos-y;
                                        z-value: root.pos-z;
                                        scrubbed(axis, delta, fine) => { root.transform-scrubbed("pos", axis, delta, fine); }
                                        scrub-started => { root.transform-scrub-started("pos"); }
                                        scrub-finished => { root.transform-scrub-finished(); }
                                        text-committed(axis, text) => { root.transform-text-committed("pos", axis, text); }
                                    }
                                    Vector3Field {
                                        row-label: "Rotation";
                                        x-value: root.rot-x;
                                        y-value: root.rot-y;
                                        z-value: root.rot-z;
                                        scrubbed(axis, delta, fine) => { root.transform-scrubbed("rot", axis, delta, fine); }
                                        scrub-started => { root.transform-scrub-started("rot"); }
                                        scrub-finished => { root.transform-scrub-finished(); }
                                        text-committed(axis, text) => { root.transform-text-committed("rot", axis, text); }
                                    }
                                    Vector3Field {
                                        row-label: "Scale";
                                        x-value: root.scale-x;
                                        y-value: root.scale-y;
                                        z-value: root.scale-z;
                                        scrubbed(axis, delta, fine) => { root.transform-scrubbed("scale", axis, delta, fine); }
                                        scrub-started => { root.transform-scrub-started("scale"); }
                                        scrub-finished => { root.transform-scrub-finished(); }
                                        text-committed(axis, text) => { root.transform-text-committed("scale", axis, text); }
                                    }
                                }
                            }
                            if selection-domain != "OBJECT": InspectorSection {
                                title: selection-domain == "POINT" ? "Point Selection" : (selection-domain == "EDGE" ? "Edge Selection" : "Face Selection");
                                open: true;
                                toggled => { self.open = !self.open; }
                                Text {
                                    text: root.active-object-details;
                                    color: DesignTokens.text-secondary;
                                    font-size: 11px;
                                }
                            }
                            InspectorSection {
                                title: "Object";
                                open: true;
                                toggled => { self.open = !self.open; }

                                Text {
                                    text: "\{root.active-object-title}\n\{root.active-object-details}";
                                    color: DesignTokens.text-secondary;
                                    font-size: 11px;
                                }
                            }
                            InspectorSection {
                                title: "Material";
                                open: false;
                                toggled => { self.open = !self.open; }

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: center;

                                    Rectangle {
                                        width: 12px;
                                        height: 12px;
                                        border-radius: 3px;
                                        background: DesignTokens.accent;
                                    }

                                    Text {
                                        text: root.active-material-name;
                                        color: DesignTokens.text-secondary;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                height: 32px;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 5px;
                                    background: DesignTokens.surface-raised;
                                    border-width: 1px;
                                    border-color: DesignTokens.border;
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 6px;
                                        IconDisplay {
                                            icon: IconSet.Copy;
                                            size: 13px;
                                            stroke: DesignTokens.text-primary;
                                        }
                                        Text {
                                            text: "Duplicate";
                                            color: DesignTokens.text-primary;
                                            font-size: 11px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Slider {
                                        minimum: 0.1;
                                        maximum: 100;
                                        value: root.brush-size;
                                        changed(value) => { root.brush-size-changed(value); }
                                    }
                                    TouchArea {
                                        clicked => { root.duplicate-requested(); }
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 5px;
                                    background: DesignTokens.surface-raised;
                                    border-width: 1px;
                                    border-color: DesignTokens.border;
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 6px;
                                        IconDisplay {
                                            icon: IconSet.Trash2;
                                            size: 13px;
                                            stroke: DesignTokens.danger;
                                        }
                                        Text {
                                            text: "Delete";
                                            color: DesignTokens.danger;
                                            font-size: 11px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Slider {
                                        minimum: 0;
                                        maximum: 1;
                                        value: root.brush-opacity;
                                        changed(value) => { root.brush-opacity-changed(value); }
                                    }
                                    TouchArea {
                                        clicked => { root.delete-requested(); }
                                    }
                                }
                            }
                        }

                        if active-workspace == "PAINT": VerticalLayout {
                            spacing: 10px;

                            InspectorSection {
                                title: "Color Palette";
                                open: true;
                                toggled => { self.open = !self.open; }

                                VerticalLayout {
                                    spacing: 8px;
                                    padding-top: 4px;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: center;

                                        Rectangle {
                                            width: 36px;
                                            height: 36px;
                                            border-radius: 6px;
                                            background: root.paint-color;
                                            border-width: 2px;
                                            border-color: DesignTokens.accent;
                                        }

                                        Text {
                                            text: "Active Brush Color";
                                            color: DesignTokens.text-primary;
                                            font-size: 11px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: center;

                                        ColorSwatch {
                                            swatch-color: #b58cff;
                                            selected: root.paint-color == #b58cff;
                                            clicked => { root.paint-color-changed(0.71, 0.55, 1.0); }
                                        }
                                        ColorSwatch {
                                            swatch-color: #ef4444;
                                            selected: root.paint-color == #ef4444;
                                            clicked => { root.paint-color-changed(0.93, 0.27, 0.27); }
                                        }
                                        ColorSwatch {
                                            swatch-color: #22c55e;
                                            selected: root.paint-color == #22c55e;
                                            clicked => { root.paint-color-changed(0.13, 0.77, 0.37); }
                                        }
                                        ColorSwatch {
                                            swatch-color: #3b82f6;
                                            selected: root.paint-color == #3b82f6;
                                            clicked => { root.paint-color-changed(0.23, 0.51, 0.96); }
                                        }
                                        ColorSwatch {
                                            swatch-color: #eab308;
                                            selected: root.paint-color == #eab308;
                                            clicked => { root.paint-color-changed(0.92, 0.70, 0.03); }
                                        }
                                        ColorSwatch {
                                            swatch-color: #ffffff;
                                            selected: root.paint-color == #ffffff;
                                            clicked => { root.paint-color-changed(1.0, 1.0, 1.0); }
                                        }
                                        ColorSwatch {
                                            swatch-color: #6b7280;
                                            selected: root.paint-color == #6b7280;
                                            clicked => { root.paint-color-changed(0.42, 0.45, 0.50); }
                                        }
                                        ColorSwatch {
                                            swatch-color: #111111;
                                            selected: root.paint-color == #111111;
                                            clicked => { root.paint-color-changed(0.07, 0.07, 0.07); }
                                        }
                                    }
                                }
                            }

                            InspectorSection {
                                title: "Brush Settings";
                                open: true;
                                toggled => { self.open = !self.open; }

                                VerticalLayout {
                                    spacing: 8px;
                                    padding-top: 4px;

                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: "Size: \{Math.round(root.brush-size * 10) / 10}";
                                            color: DesignTokens.text-secondary;
                                            font-size: 11px;
                                            horizontal-stretch: 1;
                                        }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            Text { text: "-"; color: DesignTokens.text-primary; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.brush-size-changed(Math.max(0.1, root.brush-size - 0.2)); } }
                                        }
                                        Rectangle { width: 4px; }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            Text { text: "+"; color: DesignTokens.text-primary; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.brush-size-changed(Math.min(10.0, root.brush-size + 0.2)); } }
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: "Opacity: \{Math.round(root.brush-opacity * 100)}%";
                                            color: DesignTokens.text-secondary;
                                            font-size: 11px;
                                            horizontal-stretch: 1;
                                        }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            Text { text: "-"; color: DesignTokens.text-primary; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.brush-opacity-changed(Math.max(0.05, root.brush-opacity - 0.1)); } }
                                        }
                                        Rectangle { width: 4px; }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            Text { text: "+"; color: DesignTokens.text-primary; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.brush-opacity-changed(Math.min(1.0, root.brush-opacity + 0.1)); } }
                                        }
                                    }
                                }
                            }

                            InspectorSection {
                                title: "Texture Layers";
                                open: true;
                                toggled => { self.open = !self.open; }

                                VerticalLayout {
                                    spacing: 4px;
                                    Rectangle {
                                        height: 28px;
                                        background: DesignTokens.surface-raised;
                                        border-radius: 4px;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 6px;
                                            alignment: center;
                                            IconDisplay { icon: IconSet.Layers3; size: 14px; stroke: DesignTokens.accent; }
                                            Text { text: "Albedo (Base Color)"; color: DesignTokens.text-primary; font-size: 11px; vertical-alignment: center; }
                                            Rectangle { horizontal-stretch: 1; }
                                            Text { text: "Active"; color: DesignTokens.success; font-size: 10px; font-weight: 700; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }
                        }

                        if active-workspace == "UV": VerticalLayout {
                            spacing: 10px;

                            InspectorSection {
                                title: "UV Operations";
                                open: true;
                                toggled => { self.open = !self.open; }

                                VerticalLayout {
                                    spacing: 8px;
                                    padding-top: 4px;

                                    Rectangle {
                                        height: 32px;
                                        border-radius: 5px;
                                        background: DesignTokens.accent;
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            IconDisplay { icon: IconSet.Maximize2; size: 14px; stroke: DesignTokens.canvas; }
                                            Text { text: "Unwrap Mesh"; color: DesignTokens.canvas; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                        }
                                        TouchArea { clicked => { root.command-executed("uv.unwrap"); } }
                                    }

                                    Rectangle {
                                        height: 32px;
                                        border-radius: 5px;
                                        background: DesignTokens.surface-raised;
                                        border-width: 1px;
                                        border-color: DesignTokens.border;
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            IconDisplay { icon: IconSet.Grid2x2; size: 14px; stroke: DesignTokens.text-primary; }
                                            Text { text: "Pack Islands"; color: DesignTokens.text-primary; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                                        }
                                        TouchArea { clicked => { root.command-executed("uv.pack_islands"); } }
                                    }
                                }
                            }

                            InspectorSection {
                                title: "UV Statistics";
                                open: true;
                                toggled => { self.open = !self.open; }

                                Text {
                                    text: "Algorithm: LSCM / ABF++ Conformal\nTarget: \{root.active-object-title}\nTexel Density: Auto";
                                    color: DesignTokens.text-secondary;
                                    font-size: 11px;
                                }
                            }
                        }

                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }

            Rectangle {
                height: 30px;
                background: DesignTokens.surface;
                border-width: 1px;
                border-color: DesignTokens.border;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 14px;
                    alignment: center;

                    Text { text: root.status-message; color: DesignTokens.text-primary; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                    Text { text: "LMB select   ·   MMB orbit   ·   Esc cancel"; color: DesignTokens.text-muted; font-size: 11px; vertical-alignment: center; }

                    Rectangle { horizontal-stretch: 1; }

                    Rectangle {
                        height: 22px;
                        border-radius: 4px;
                        background: asset-library-visible ? DesignTokens.accent : DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 5px;
                            alignment: center;
                            IconDisplay {
                                icon: IconSet.FolderArchive;
                                size: 12px;
                                stroke: asset-library-visible ? DesignTokens.canvas : DesignTokens.text-primary;
                            }
                            Text {
                                text: "Asset Library";
                                color: asset-library-visible ? DesignTokens.canvas : DesignTokens.text-primary;
                                font-size: 10px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.asset-library-requested(); } }
                    }

                    Text { text: root.scene-stats; color: DesignTokens.text-muted; font-size: 11px; vertical-alignment: center; }
                }
            }
        }

        // Overlay: Scene Drawer
        if scene-drawer-visible: Rectangle {
            x: 8px;
            y: 42px;
            width: 250px;
            height: parent.height - 72px;
            background: DesignTokens.surface-raised;
            border-width: 1px;
            border-color: DesignTokens.border;
            border-radius: 6px;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    Text {
                        text: "Parts";
                        color: DesignTokens.text-primary;
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    TopAction {
                        icon: IconSet.Pin;
                        semantic-label: scene-drawer-pinned ? "Unpin Parts" : "Pin Parts";
                        clicked => {
                            root.scene-drawer-pinned = !root.scene-drawer-pinned;
                            root.scene-pin-requested(root.scene-drawer-pinned);
                        }
                    }
                    TopAction {
                        icon: IconSet.X;
                        semantic-label: "Close scene drawer";
                        clicked => { root.scene-requested(); }
                    }
                }

                Rectangle { height: 1px; background: DesignTokens.border; }

                ScrollView {
                    VerticalLayout {
                        spacing: 4px;
                        alignment: start;

                        for item in root.scene-items: Rectangle {
                            height: 28px;
                            border-radius: 4px;
                            background: item.selected ? DesignTokens.surface-hover : transparent;
                            border-width: item.selected ? 1px : 0px;
                            border-color: DesignTokens.accent;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 6px;
                                alignment: center;

                                TouchArea {
                                    clicked => { root.scene-select(item.id); }
                                    horizontal-stretch: 1;

                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: center;

                                        IconDisplay {
                                            icon: IconSet.Box;
                                            size: 12px;
                                            stroke: item.selected ? DesignTokens.accent : DesignTokens.text-muted;
                                        }

                                        Text {
                                            text: item.name;
                                            color: item.selected ? DesignTokens.text-primary : DesignTokens.text-secondary;
                                            font-size: 12px;
                                            font-weight: item.selected ? 600 : 400;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: "\{item.tris}t";
                                            color: DesignTokens.text-muted;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    IconDisplay {
                                        icon: item.visible ? IconSet.Eye : IconSet.EyeOff;
                                        size: 13px;
                                        stroke: item.visible ? DesignTokens.text-secondary : DesignTokens.text-muted;
                                    }
                                    TouchArea {
                                        clicked => { root.scene-toggle-visibility(item.id); }
                                    }
                                }

                                Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    IconDisplay {
                                        icon: item.locked ? IconSet.Lock : IconSet.LockOpen;
                                        size: 13px;
                                        stroke: item.locked ? DesignTokens.accent : DesignTokens.text-muted;
                                    }
                                    TouchArea {
                                        clicked => { root.scene-toggle-lock(item.id); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Overlay / Bottom Drawer: Asset Library (AGENTS.md §3: Asset Library-abaixo)
        if asset-library-visible: Rectangle {
            x: 8px;
            y: parent.height - 230px;
            width: parent.width - 16px - (inspector-visible && !compact-shell ? 296px : 0px);
            height: 200px;
            background: DesignTokens.surface-raised;
            border-width: 1px;
            border-color: DesignTokens.border;
            border-radius: 6px;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;

                    IconDisplay {
                        icon: IconSet.FolderArchive;
                        size: 16px;
                        stroke: DesignTokens.accent;
                    }

                    Text {
                        text: "Project Asset Library";
                        color: DesignTokens.text-primary;
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "(\{root.scene-items.length} assets)";
                        color: DesignTokens.text-muted;
                        font-size: 11px;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Rectangle {
                        height: 24px;
                        border-radius: 4px;
                        background: DesignTokens.surface;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            alignment: center;
                            IconDisplay { icon: IconSet.BookmarkPlus; size: 12px; stroke: DesignTokens.text-primary; }
                            Text { text: "Save Active as Asset"; color: DesignTokens.text-primary; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                        }
                        TouchArea { clicked => { root.save-active-as-asset-requested(); } }
                    }

                    TopAction {
                        icon: IconSet.X;
                        semantic-label: "Close asset library";
                        clicked => { root.asset-library-requested(); }
                    }
                }

                Rectangle { height: 1px; background: DesignTokens.border; }

                ScrollView {
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        for item in root.scene-items: Rectangle {
                            width: 160px;
                            height: 120px;
                            border-radius: 6px;
                            background: item.selected ? DesignTokens.surface-hover : DesignTokens.surface;
                            border-width: item.selected ? 2px : 1px;
                            border-color: item.selected ? DesignTokens.accent : DesignTokens.border;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 6px;

                                HorizontalLayout {
                                    alignment: center;
                                    IconDisplay { icon: IconSet.Box; size: 14px; stroke: item.selected ? DesignTokens.accent : DesignTokens.text-secondary; }
                                    Rectangle { width: 4px; }
                                    Text {
                                        text: item.name;
                                        color: DesignTokens.text-primary;
                                        font-size: 12px;
                                        font-weight: item.selected ? 700 : 500;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                }

                                Text {
                                    text: "\{item.tris} tris  ·  \{item.verts} verts";
                                    color: DesignTokens.text-muted;
                                    font-size: 10px;
                                }

                                Rectangle { vertical-stretch: 1; }

                                HorizontalLayout {
                                    spacing: 4px;

                                    Rectangle {
                                        height: 22px;
                                        horizontal-stretch: 1;
                                        border-radius: 3px;
                                        background: item.selected ? DesignTokens.accent : DesignTokens.surface-raised;
                                        Text {
                                            text: item.selected ? "Active" : "Select";
                                            color: item.selected ? DesignTokens.canvas : DesignTokens.text-primary;
                                            font-size: 10px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        TouchArea { clicked => { root.scene-select(item.id); } }
                                    }

                                    Rectangle {
                                        width: 22px;
                                        height: 22px;
                                        border-radius: 3px;
                                        background: DesignTokens.surface-raised;
                                        IconDisplay { icon: IconSet.Copy; size: 12px; stroke: DesignTokens.text-secondary; }
                                        TouchArea {
                                            clicked => {
                                                root.scene-select(item.id);
                                                root.duplicate-requested();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Overlay: Command Search Modal
        if command-search-visible: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: DesignTokens.scrim;

            TouchArea {
                clicked => { root.click-away-requested(); }
            }

            Rectangle {
                width: 480px;
                height: 320px;
                x: (parent.width - self.width) / 2;
                y: 80px;
                border-radius: 8px;
                background: DesignTokens.surface-raised;
                border-width: 1px;
                border-color: DesignTokens.border;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    HorizontalLayout {
                        height: 36px;
                        spacing: 8px;
                        alignment: center;

                        IconDisplay {
                            icon: IconSet.Search;
                            size: 16px;
                            stroke: DesignTokens.text-secondary;
                        }

                        search-input := TextInput {
                            accessible-role: text-input;
                            accessible-label: "Search commands";
                            font-size: 14px;
                            color: DesignTokens.text-primary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            text <=> root.command-query;
                            edited => { root.command-query-changed(self.text); }
                            key-pressed(event) => {
                                if event.text == Key.DownArrow && root.command-results.length > 0 {
                                    root.command-selection = Math.min(root.command-selection + 1, root.command-results.length - 1);
                                    return accept;
                                }
                                if event.text == Key.UpArrow && root.command-results.length > 0 {
                                    root.command-selection = Math.max(root.command-selection - 1, 0);
                                    return accept;
                                }
                                reject
                            }
                            accepted => {
                                if root.command-results.length > 0 {
                                    if !root.command-results[root.command-selection].available {
                                    } else if root.command-results[root.command-selection].id == "file.save" || root.command-results[root.command-selection].id == "file.save_as" || root.command-results[root.command-selection].id == "file.open" {
                                        root.command-file-action(root.command-results[root.command-selection].id);
                                    } else {
                                        root.command-executed(root.command-results[root.command-selection].id);
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: DesignTokens.border;
                    }

                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 2px;
                            for cmd[index] in root.command-results: Rectangle {
                                height: 32px;
                                border-radius: 4px;
                                background: index == root.command-selection || item-touch.has-hover ? DesignTokens.surface-hover : transparent;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: center;

                                    Text {
                                        text: cmd.label;
                                        color: DesignTokens.text-primary;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }

                                    Rectangle { horizontal-stretch: 1; }

                                    if cmd.shortcut != "": Text {
                                        text: cmd.shortcut;
                                        color: DesignTokens.text-muted;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }
                                }

                                item-touch := TouchArea {
                                    clicked => {
                                        root.command-selection = index;
                                        if !cmd.available {
                                        } else if cmd.id == "file.save" || cmd.id == "file.save_as" || cmd.id == "file.open" {
                                            root.command-file-action(cmd.id);
                                        } else {
                                            root.command-executed(cmd.id);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Overlay: Settings Modal
        if settings-visible: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: DesignTokens.scrim;

            TouchArea {
                clicked => { root.click-away-requested(); }
            }

            Rectangle {
                width: 420px;
                height: 260px;
                x: (parent.width - self.width) / 2;
                y: 100px;
                border-radius: 8px;
                background: DesignTokens.surface-raised;
                border-width: 1px;
                border-color: DesignTokens.border;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    HorizontalLayout {
                        Text {
                            text: "Preferences";
                            color: DesignTokens.text-primary;
                            font-size: 14px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        TopAction {
                            icon: IconSet.X;
                            semantic-label: "Close settings";
                            clicked => { root.click-away-requested(); }
                        }
                    }

                    Rectangle { height: 1px; background: DesignTokens.border; }

                    Text {
                        text: "Theme (P3D-085)";
                        color: DesignTokens.text-primary;
                        font-size: 12px;
                        font-weight: 600;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Rectangle {
                            width: 120px;
                            height: 28px;
                            border-radius: 4px;
                            background: root.current-theme == "petunia-dark" ? DesignTokens.accent : DesignTokens.surface;
                            border-width: 1px;
                            border-color: DesignTokens.border;

                            Text {
                                text: "Petunia Dark";
                                color: root.current-theme == "petunia-dark" ? DesignTokens.canvas : DesignTokens.text-primary;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                            TouchArea {
                                clicked => { root.theme-changed("petunia-dark"); }
                            }
                        }

                        Rectangle {
                            width: 140px;
                            height: 28px;
                            border-radius: 4px;
                            background: root.current-theme == "petunia-high-contrast" ? DesignTokens.accent : DesignTokens.surface;
                            border-width: 1px;
                            border-color: DesignTokens.border;

                            Text {
                                text: "High Contrast";
                                color: root.current-theme == "petunia-high-contrast" ? DesignTokens.canvas : DesignTokens.text-primary;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                            TouchArea {
                                clicked => { root.theme-changed("petunia-high-contrast"); }
                            }
                        }
                    }

                    Text {
                        text: "Keymap: Standard  ·  Language: English\nTheme tokens dynamically synchronized with ThemeRegistry.";
                        color: DesignTokens.text-muted;
                        font-size: 11px;
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }
        }
    }
}
