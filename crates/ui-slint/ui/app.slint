    // Cor e espessura de um handle do gizmo conforme o estado da interação.
    function gizmo-handle-color(axis: int, base: color) -> color {
        if root.gizmo-constraint-axis-a == axis || root.gizmo-constraint-axis-b == axis {
            return base;
        }
        if root.gizmo-constraint-axis-a >= 0 {
            return base.transparentize(0.72);
        }
        if root.gizmo-active-axis == axis {
            return base;
        }
        if root.gizmo-active-axis >= 0 {
            // Durante o arrasto os outros eixos perdem presença.
            return base.transparentize(0.72);
        }
        if root.gizmo-hover-axis == axis {
            return base.transparentize(0.18);
        }
        return base;
    }

    function gizmo-handle-width(axis: int) -> length {
        if root.gizmo-constraint-axis-a == axis || root.gizmo-constraint-axis-b == axis {
            return 4px;
        }
        if root.gizmo-constraint-axis-a >= 0 {
            return 2px;
        }
        if root.gizmo-active-axis == axis {
            return 4px;
        }
        if root.gizmo-hover-axis == axis {
            return 3.5px;
        }
        return 2.5px;
    }

    changed command-search-visible => { root.command-selection = 0; }
    changed tool-modal-active => { if (root.tool-modal-active) { root.tool-properties-collapsed = false; } }
    changed loop-cut-active => { if (root.loop-cut-active) { root.tool-properties-collapsed = false; } }
    changed width => {
        root.compact-shell = self.width < 900px;
        if !root.compact-shell && root.scene-drawer-visible {
            root.scene-requested();
            root.model-parts-open = true;
        }
    }

    root-focus := FocusScope {
        init => { self.focus(); }
        key-released(event) => {
            root.precision-mode = event.modifiers.shift;
            root.snap-mode = event.modifiers.control;
            reject
        }
        key-pressed(event) => {
            root.precision-mode = event.modifiers.shift;
            root.snap-mode = event.modifiers.control;
            if event.text == Key.Escape {
                viewport-touch.clear-gesture();
                root.escape-requested();
                return accept;
            }
            if !root.command-search-visible && !root.settings-visible && event.text != Key.Tab {
                root.shortcut-requested(
                    event.text == Key.Return ? "Enter" : event.text == Key.Backspace ? "Backspace" : event.text == Key.Delete ? "Delete" : event.text == Key.Home ? "Home" : event.text,
                    event.modifiers.control, event.modifiers.shift, event.modifiers.alt);
                return accept;
            }
            reject
        }

        VerticalLayout {
            spacing: 0px;

            Rectangle {
                height: 42px;
                background: DesignTokens.surface;
                border-width: 1px;
                border-color: DesignTokens.border;

                HorizontalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding-left: 14px;
                    padding-right: 10px;
                    alignment: center;
                    spacing: 12px;

                    Text {
                        text: "Petunia";
                        color: DesignTokens.text-primary;
                        font-size: 14px;
                        font-weight: 700;
                        width: 62px;
                    }

                    MenuButton {
                        label: root.menu-file-label;
                        open: root.menu-open == "file";
                        clicked => {
                            root.menu-anchor-x = self.absolute-position.x;
                            root.menu-toggled("file");
                        }
                    }
                    MenuButton {
                        label: root.menu-edit-label;
                        open: root.menu-open == "edit";
                        clicked => {
                            root.menu-anchor-x = self.absolute-position.x;
                            root.menu-toggled("edit");
                        }
                    }
                    MenuButton {
                        label: root.menu-view-label;
                        open: root.menu-open == "view";
                        clicked => {
                            root.menu-anchor-x = self.absolute-position.x;
                            root.menu-toggled("view");
                        }
                    }
                    MenuButton {
                        label: root.menu-window-label;
                        open: root.menu-open == "window";
                        clicked => {
                            root.menu-anchor-x = self.absolute-position.x;
                            root.menu-toggled("window");
                        }
                    }

                    Rectangle {
                        height: 28px;
                        width: 96px;
                        border-radius: 6px;
                        background: active-workspace == "MODEL" ? DesignTokens.accent : DesignTokens.surface-raised;
                        Text {
                            text: "MODEL";
                            color: active-workspace == "MODEL" ? DesignTokens.canvas : DesignTokens.text-secondary;
                            font-size: 11px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.workspace-changed("MODEL"); } }
                    }

                    Rectangle {
                        height: 28px;
                        width: 96px;
                        border-radius: 6px;
                        background: active-workspace == "PAINT" ? DesignTokens.accent : DesignTokens.surface-raised;
                        Text {
                            text: "PAINT";
                            color: active-workspace == "PAINT" ? DesignTokens.canvas : DesignTokens.text-secondary;
                            font-size: 11px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.workspace-changed("PAINT"); } }
                    }

                    Rectangle {
                        height: 28px;
                        width: 96px;
                        border-radius: 6px;
                        background: active-workspace == "UV" ? DesignTokens.accent : DesignTokens.surface-raised;
                        Text {
                            text: "UV";
                            color: active-workspace == "UV" ? DesignTokens.canvas : DesignTokens.text-secondary;
                            font-size: 11px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.workspace-changed("UV"); } }
                    }

                    TopAction {
                        icon: IconSet.Undo;
                        semantic-label: "Undo";
                        clicked => { root.undo-requested(); }
                    }
                    TopAction {
                        icon: IconSet.Redo;
                        semantic-label: "Redo";
                        clicked => { root.redo-requested(); }
                    }

                    Rectangle { horizontal-stretch: 1; }


                    if active-workspace == "MODEL": Rectangle { horizontal-stretch: 1; }

                    Text {
                        text: saved ? "Saved" : "Unsaved";
                        color: saved ? DesignTokens.success : DesignTokens.text-secondary;
                        font-size: 11px;
                    }
                    TopAction {
                        icon: IconSet.PanelLeft;
                        semantic-label: "Parts";
                        clicked => { root.scene-requested(); }
                    }
                    TopAction {
                        icon: IconSet.FolderOpen;
                        semantic-label: "Open project";
                        clicked => { root.open-project-requested(); }
                    }
                    TopAction {
                        icon: IconSet.Save;
                        semantic-label: "Save project";
                        clicked => { root.save-requested(); }
                    }
                    TopAction {
                        icon: IconSet.Search;
                        semantic-label: "Command search";
                        clicked => { root.search-requested(); }
                    }
                    TopAction {
                        icon: IconSet.Settings;
                        semantic-label: "Settings";
                        clicked => { root.settings-requested(); }
                    }
                }
            }

            HorizontalLayout {
                spacing: 0px;
                horizontal-stretch: 1;
                vertical-stretch: 1;

                // Contextual Tool Tray. Workspaces live only in the header.
                Rectangle {
                    width: 40px;
                    background: DesignTokens.surface-raised;
                    border-width: 1px;
                    border-color: DesignTokens.border;

                    VerticalLayout {
                        padding-top: 10px;
                        padding-bottom: 10px;
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 6px;
                        alignment: start;

                        if active-workspace == "MODEL": VerticalLayout {
                            spacing: 6px;
                            ToolButton {
                                icon: IconSet.Plus;
                                semantic-label: "Add Primitive";
                                active: root.add-menu-open;
                                clicked => {
                                    root.add-menu-open = !root.add-menu-open;
                                    root.add-menu-changed(root.add-menu-open);
                                }
                            }
                            ToolButton {
                                icon: IconSet.Box;
                                semantic-label: "Add Cube";
                                active: false;
                                clicked => { root.add-primitive-requested("cube"); }
                            }
                            ToolButton {
                                icon: IconSet.CircleDot;
                                semantic-label: "Add Sphere";
                                active: false;
                                clicked => { root.add-primitive-requested("sphere"); }
                            }
                        }

                        if active-workspace == "PAINT": VerticalLayout {
                            spacing: 6px;
                            ToolButton {
                                icon: IconSet.Paintbrush;
                                semantic-label: "Brush";
                                active: active-tool == "brush";
                                clicked => { root.active-tool-changed("brush"); }
                            }
                            ToolButton {
                                icon: IconSet.Eraser;
                                semantic-label: "Eraser";
                                active: active-tool == "eraser";
                                clicked => { root.active-tool-changed("eraser"); }
                            }
                            ToolButton {
                                icon: IconSet.Pipette;
                                semantic-label: "Color Picker";
                                active: active-tool == "picker";
                                clicked => { root.active-tool-changed("picker"); }
                            }
                            ToolButton {
                                icon: IconSet.PaintBucket;
                                semantic-label: "Fill Bucket";
                                active: active-tool == "fill";
                                clicked => { root.active-tool-changed("fill"); }
                            }
                            ToolButton {
                                icon: IconSet.SquareDashed;
                                semantic-label: "Line";
                                active: active-tool == "line";
                                clicked => { root.active-tool-changed("line"); }
                            }
                            ToolButton {
                                icon: IconSet.Square;
                                semantic-label: "Rectangle";
                                active: active-tool == "rectangle";
                                clicked => { root.active-tool-changed("rectangle"); }
                            }
                        }

                        if active-workspace == "UV": VerticalLayout {
                            spacing: 6px;
                            ToolButton {
                                icon: IconSet.MousePointer2;
                                semantic-label: "UV Select";
                                active: active-tool == "uv_select";
                                clicked => { root.active-tool-changed("uv_select"); }
                            }
                            ToolButton {
                                icon: IconSet.Maximize2;
                                semantic-label: "Unwrap";
                                active: false;
                                clicked => { root.command-executed("uv.unwrap"); }
                            }
                            ToolButton {
                                icon: IconSet.Grid2x2;
                                semantic-label: "Pack Islands";
                                active: false;
                                clicked => { root.command-executed("uv.pack_islands"); }
                            }
                        }
                    }
                }

                viewport-region := Rectangle {
                    horizontal-stretch: 1;
                    clip: true;
                    background: DesignTokens.canvas;
                    border-width: 1px;
                    border-color: DesignTokens.border;

                    changed width => {
                        root.viewport-resized(self.width / 1px, self.height / 1px);
                    }
                    changed height => {
                        root.viewport-resized(self.width / 1px, self.height / 1px);
                    }

                    if has-gpu-viewport: Image {
                        width: 100%;
                        height: 100%;
                        image-fit: contain;
                        source: root.viewport-image;
                    }

                    if !has-gpu-viewport: Text {
                        text: "VIEWPORT\n\nSlint shell bootstrap\nGPU viewport remains behind PetuniaViewport";
                        color: DesignTokens.text-muted;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    // Coordenadas já projetadas em pixels da viewport. Não
                    // normalizar os paths à caixa do item (fit padrão).
                    if selection-overlay-visible: Path {
                        fit: ImageFit.preserve;
                        fill: transparent;
                        stroke: DesignTokens.text-secondary;
                        stroke-width: 1.25px;
                        commands: root.selection-unselected-outline-commands;
                    }
                    if selection-overlay-visible: Path {
                        fit: ImageFit.preserve;
                        fill: transparent;
                        // Modo componente usa o mesmo laranja da seleção
                        // (Blender não pinta seleção de edit-mode de azul):
                        // o accent virou vestígio e sai na próxima limpeza.
                        stroke: root.selection-color;
                        stroke-width: max(2px, root.selection-thickness * 1px);
                        commands: root.selection-outline-commands;
                    }
                    if selection-overlay-visible: Path {
                        fit: ImageFit.preserve;
                        fill: transparent;
                        stroke: DesignTokens.selection-active;
                        stroke-width: root.selection-thickness * 1.2 * 1px;
                        commands: root.selection-active-outline-commands;
                    }
                    if selection-overlay-visible: Path {
                        fit: ImageFit.preserve;
                        fill: DesignTokens.text-muted;
                        stroke: transparent;
                        commands: root.selection-unselected-point-commands;
                    }
                    if selection-overlay-visible: Path {
                        fit: ImageFit.preserve;
                        fill: root.selection-color;
                        stroke: transparent;
                        commands: root.selection-point-commands;
                    }

                    Path {
                        fit: ImageFit.preserve;
                        commands: root.operation-preview-commands;
                        fill: transparent;
                        stroke: DesignTokens.accent;
                        stroke-width: 2px;
                    }
                    Path {
                        fit: ImageFit.preserve;
                        commands: root.loop-cut-preview-commands;
                        fill: transparent;
                        stroke: DesignTokens.selection-active;
                        stroke-width: 2px;
                    }
                    Path {
                        fit: ImageFit.preserve;
                        commands: root.profile-preview-commands;
                        fill: transparent;
                        stroke: DesignTokens.selection;
                        stroke-width: 2px;
                    }

                    // Cordão da ferramenta ativa: tracejado amarelo da base da
                    // seleção até o mouse. Cresce/encolhe com a distância.
                    if root.drag-link-commands != "": Path {
                        fit: ImageFit.preserve;
                        commands: root.drag-link-commands;
                        fill: transparent;
                        stroke: DesignTokens.selection-active;
                        stroke-width: 1.5px;
                    }

                    viewport-touch := TouchArea {
                        property <length> last-x;
                        property <length> last-y;
                        property <bool> is-box-select: false;
                        property <bool> is-lasso-select: false;
                        property <string> lasso-points: "";
                        property <string> lasso-commands: "";
                        property <length> lasso-last-x;
                        property <length> lasso-last-y;
                        property <int> lasso-count: 0;
                        property <bool> subtract-selection: false;
                        property <bool> is-orbit: false;
                        property <bool> is-pan: false;
                        property <bool> moved-since-down: false;
                        property <bool> extend-selection: false;
                        property <bool> is-transform: false;
                        property <bool> pending-transform: false;
                        // Tweak do Blender: com a tool Select, o arrasto vira
                        // box select; o clique (sem arrasto) só seleciona.
                        property <bool> pending-box-select: false;
                        property <bool> is-painting: false;
                        property <bool> is-tool-drag: false;
                        property <bool> is-loop-drag: false;
                        property <bool> is-loop-place: false;
                        property <bool> is-slice-drag: false;
                        property <bool> is-gizmo-drag: false;
                        property <bool> is-keyboard-transform-drag: false;
                        property <bool> consume-click: false;
                        property <bool> tool-drag-fine: false;
                        property <bool> loop-selection: false;
                        property <string> local-kind: "";

                        function clear-gesture() {
                            self.is-box-select = false;
                            self.is-lasso-select = false;
                            self.lasso-points = "";
                            self.lasso-commands = "";
                            self.is-transform = false;
                            self.pending-transform = false;
                            self.pending-box-select = false;
                            self.is-tool-drag = false;
                            self.is-loop-drag = false;
                            self.is-loop-place = false;
                            self.is-slice-drag = false;
                            self.is-gizmo-drag = false;
                            self.is-keyboard-transform-drag = false;
                            self.consume-click = false;
                            self.loop-selection = false;
                            self.is-painting = false;
                            self.is-orbit = false;
                            self.is-pan = false;
                            self.moved-since-down = true;
                        }

                        function transform-tool() -> string {
                            if root.active-workspace != "MODEL" {
                                return "";
                            }
                            if root.active-tool == "move" || root.active-tool == "transform" {
                                return "pos";
                            }
                            if root.active-tool == "rotate" {
                                return "rot";
                            }
                            if root.active-tool == "scale" {
                                return "scale";
                            }
                            return "";
                        }

                        pointer-event(event) => {
                            root.precision-mode = event.modifiers.shift;
                            root.snap-mode = event.modifiers.control;
                            if event.kind == PointerEventKind.cancel || (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                self.clear-gesture();
                                // Blender: com sessão ativa o botão direito
                                // cancela; sem sessão abre o menu da viewport.
                                root.viewport-context-requested(self.mouse-x / 1px, self.mouse-y / 1px);
                            } else if event.kind == PointerEventKind.down {
                                root-focus.focus();
                                last-x = self.mouse-x;
                                last-y = self.mouse-y;
                                moved-since-down = false;
                                consume-click = false;
                                extend-selection = event.modifiers.shift;
                                loop-selection = event.modifiers.alt;
                                is-transform = false;
                                pending-transform = false;
                                pending-box-select = false;
                                if event.button == PointerEventButton.left && root.active-tool == "draw_profile" {
                                    consume-click = true;
                                    root.viewport-select(self.mouse-x / self.width, self.mouse-y / self.height, false, false);
                                } else if event.button == PointerEventButton.middle
                                    && !root.tool-modal-active && !root.loop-cut-active && !root.loop-cut-armed
                                    && !root.profile-active && root.active-tool != "slice" {
                                    if event.modifiers.shift {
                                        is-pan = true;
                                        is-orbit = false;
                                    } else {
                                        is-orbit = true;
                                        is-pan = false;
                                    }
                                } else if event.button == PointerEventButton.left && event.modifiers.alt
                                    && !root.tool-modal-active && !root.loop-cut-active && !root.loop-cut-armed
                                    && !root.profile-active && root.active-tool != "slice" {
                                    is-orbit = true;
                                    is-pan = false;
                                } else if event.button == PointerEventButton.left && root.active-tool == "box_select" && !event.modifiers.alt {
                                    is-box-select = true;
                                    subtract-selection = event.modifiers.control;
                                } else if event.button == PointerEventButton.left && root.active-tool == "lasso_select" && !event.modifiers.alt {
                                    is-lasso-select = true;
                                    subtract-selection = event.modifiers.control;
                                    lasso-last-x = self.mouse-x;
                                    lasso-last-y = self.mouse-y;
                                    lasso-count = 1;
                                    lasso-points = "\{self.mouse-x / self.width},\{self.mouse-y / self.height};";
                                    lasso-commands = "M \{self.mouse-x / 1px} \{self.mouse-y / 1px} ";
                                    moved-since-down = true;
                                } else if event.button == PointerEventButton.left
                                    && !event.modifiers.shift
                                    && !event.modifiers.alt {
                                    // O gizmo tem picking próprio: clicar num
                                    // handle restringe a transformação ao eixo.
                                    if root.gizmo-hover-axis >= 0 {
                                        is-gizmo-drag = true;
                                        root.gizmo-drag-begin(self.mouse-x / 1px, self.mouse-y / 1px);
                                    } else if root.transform-instant-active {
                                        // O atalho já abriu a operação modal. O mesmo
                                        // clique pode confirmar ou iniciar um arrasto;
                                        // não exigir um primeiro clique descartável.
                                        is-keyboard-transform-drag = true;
                                        consume-click = true;
                                    } else if root.active-workspace == "PAINT" {
                                        is-painting = true;
                                        root.viewport-paint-begin(self.mouse-x / 1px, self.mouse-y / 1px);
                                    } else if root.active-tool == "slice" {
                                        is-slice-drag = true;
                                        root.viewport-transform-begin("slice", self.mouse-x / 1px, self.mouse-y / 1px);
                                    } else if root.active-tool == "loop_cut" && !root.loop-cut-active {
                                        is-loop-place = true;
                                        consume-click = true;
                                    } else if root.loop-cut-active {
                                        is-loop-drag = true;
                                        tool-drag-fine = event.modifiers.shift;
                                    } else if root.tool-modal-active {
                                        is-tool-drag = true;
                                        tool-drag-fine = event.modifiers.shift;
                                    } else {
                                        local-kind = self.transform-tool();
                                        if local-kind != "" {
                                            // A ferramenta só inicia uma operação após um
                                            // arrasto real; um clique continua selecionando.
                                            pending-transform = true;
                                        } else if root.active-tool == "select"
                                            && root.active-workspace == "MODEL"
                                            && root.gizmo-hover-axis < 0
                                            && !root.transform-instant-active
                                            && !root.tool-modal-active
                                            && !root.loop-cut-active {
                                            // Tweak (Blender): arrastar com Select
                                            // vira box select; o clique (sem
                                            // arrasto) cai no viewport-select.
                                            pending-box-select = true;
                                            subtract-selection = event.modifiers.control;
                                        }
                                    }
                                }
                            } else if event.kind == PointerEventKind.move {
                                if !self.pressed {
                                    // TouchArea.moved só dispara durante um grab. O
                                    // pointer-event Move também cobre hover livre,
                                    // necessário para operações iniciadas por atalho.
                                    root.gizmo-hover(self.mouse-x / 1px, self.mouse-y / 1px);
                                    if root.gizmo-hover-axis < 0 {
                                        root.viewport-hover(self.mouse-x / self.width, self.mouse-y / self.height);
                                    } else {
                                        root.viewport-hover-clear();
                                    }
                                }
                                if is-box-select {
                                    if abs(self.mouse-x - last-x) > 4px || abs(self.mouse-y - last-y) > 4px { moved-since-down = true; }
                                } else if is-lasso-select && self.pressed && lasso-count < 4096
                                    && (abs(self.mouse-x - lasso-last-x) > 3px || abs(self.mouse-y - lasso-last-y) > 3px) {
                                    lasso-last-x = self.mouse-x;
                                    lasso-last-y = self.mouse-y;
                                    lasso-count += 1;
                                    lasso-points += "\{self.mouse-x / self.width},\{self.mouse-y / self.height};";
                                    lasso-commands += "L \{self.mouse-x / 1px} \{self.mouse-y / 1px} ";
                                } else if pending-box-select && self.pressed
                                    && (self.mouse-x - last-x > 4px || last-x - self.mouse-x > 4px
                                        || self.mouse-y - last-y > 4px || last-y - self.mouse-y > 4px) {
                                    pending-box-select = false;
                                    is-box-select = true;
                                    moved-since-down = true;
                                } else if is-orbit && !root.tool-modal-active && !root.loop-cut-active && !root.loop-cut-armed
                                    && !root.profile-active && root.active-tool != "slice" {
                                    moved-since-down = true;
                                    root.viewport-orbit((self.mouse-x - last-x) / 1px, (self.mouse-y - last-y) / 1px);
                                    last-x = self.mouse-x;
                                    last-y = self.mouse-y;
                                } else if is-pan && !root.tool-modal-active && !root.loop-cut-active && !root.loop-cut-armed
                                    && !root.profile-active && root.active-tool != "slice" {
                                    moved-since-down = true;
                                    root.viewport-pan((self.mouse-x - last-x) / 1px, (self.mouse-y - last-y) / 1px);
                                    last-x = self.mouse-x;
                                    last-y = self.mouse-y;
                                } else if root.transform-instant-active && (!self.pressed || is-keyboard-transform-drag) {
                                    if is-keyboard-transform-drag { moved-since-down = true; }
                                    root.viewport-transform-update(self.mouse-x / 1px, self.mouse-y / 1px, root.precision-mode, root.snap-mode);
                                } else if is-gizmo-drag {
                                    moved-since-down = true;
                                    root.viewport-transform-update(self.mouse-x / 1px, self.mouse-y / 1px, root.precision-mode, root.snap-mode);
                                } else if root.tool-modal-active && (root.tool-activation == "instant" || root.keyboard-tool-modal-active) && !self.pressed {
                                    root.tool-modal-hovered((self.mouse-y - last-y) / 1px, self.mouse-x / 1px, self.mouse-y / 1px);
                                    last-x = self.mouse-x;
                                    last-y = self.mouse-y;
                                } else if is-transform {
                                    moved-since-down = true;
                                    root.viewport-transform-update(self.mouse-x / 1px, self.mouse-y / 1px, root.precision-mode, root.snap-mode);
                                } else if pending-transform && self.pressed
                                    && (self.mouse-x - last-x > 4px || last-x - self.mouse-x > 4px
                                        || self.mouse-y - last-y > 4px || last-y - self.mouse-y > 4px) {
                                    pending-transform = false;
                                    is-transform = true;
                                    moved-since-down = true;
                                    root.viewport-transform-begin(local-kind, last-x / 1px, last-y / 1px);
                                    root.viewport-transform-update(self.mouse-x / 1px, self.mouse-y / 1px, root.precision-mode, root.snap-mode);
                                } else if is-painting {
                                    moved-since-down = true;
                                    root.viewport-paint-update(self.mouse-x / 1px, self.mouse-y / 1px);
                                } else if is-tool-drag {
                                    moved-since-down = true;
                                    root.tool-modal-scrubbed((self.mouse-y - last-y) / 1px, tool-drag-fine, self.mouse-x / 1px, self.mouse-y / 1px);
                                    last-x = self.mouse-x;
                                    last-y = self.mouse-y;
                                } else if is-loop-drag {
                                    moved-since-down = true;
                                    root.loop-cut-scrubbed((self.mouse-x - last-x) / 1px);
                                    last-x = self.mouse-x;
                                    last-y = self.mouse-y;
                                } else if is-loop-place {
                                    root.viewport-hover(self.mouse-x / self.width, self.mouse-y / self.height);
                                } else if is-slice-drag {
                                    moved-since-down = true;
                                    root.viewport-transform-update(self.mouse-x / 1px, self.mouse-y / 1px, root.precision-mode, root.snap-mode);
                                }
                            } else if event.kind == PointerEventKind.up {
                                if is-box-select {
                                    if moved-since-down {
                                        root.viewport-box-select(last-x / self.width, last-y / self.height, self.mouse-x / self.width, self.mouse-y / self.height, extend-selection, subtract-selection);
                                    }
                                    is-box-select = false;
                                }
                                if is-lasso-select {
                                    if lasso-count >= 3 {
                                        root.viewport-lasso-select(lasso-points, extend-selection, subtract-selection);
                                    }
                                    is-lasso-select = false;
                                    lasso-points = "";
                                    lasso-commands = "";
                                }
                                is-orbit = false;
                                is-pan = false;
                                if is-transform {
                                    root.viewport-transform-end();
                                    is-transform = false;
                                }
                                if is-keyboard-transform-drag {
                                    // No modal por atalho, clique confirma e
                                    // clique-arrasto edita sem clique preparatório.
                                    root.viewport-transform-end();
                                    is-keyboard-transform-drag = false;
                                }
                                pending-transform = false;
                                pending-box-select = false;
                                if is-painting {
                                    root.viewport-paint-end(self.mouse-x / 1px, self.mouse-y / 1px);
                                    is-painting = false;
                                }
                                if is-tool-drag {
                                    if moved-since-down {
                                        root.tool-modal-apply();
                                    }
                                    is-tool-drag = false;
                                }
                                if is-loop-drag {
                                    root.loop-cut-apply();
                                    is-loop-drag = false;
                                }
                                if is-loop-place {
                                    root.loop-cut-place();
                                    is-loop-place = false;
                                }
                                if is-slice-drag {
                                    root.viewport-transform-end();
                                    is-slice-drag = false;
                                }
                                if is-gizmo-drag {
                                    root.gizmo-drag-end();
                                    is-gizmo-drag = false;
                                }
                                root.viewport-hover(self.mouse-x / self.width, self.mouse-y / self.height);
                            }
                        }

                        clicked => {
                            if !consume-click && !moved-since-down && !is-transform && !is-painting
                                && root.active-workspace != "PAINT" {
                                root.viewport-select(self.mouse-x / self.width, self.mouse-y / self.height, extend-selection, loop-selection);
                            }
                            consume-click = false;
                        }

                        scroll-event(event) => {
                            if root.active-tool == "loop_cut" {
                                root.loop-cut-count-committed("\{root.loop-cut-cuts + (event.delta-y > 0px ? 1 : -1)}");
                            } else if !root.tool-modal-active && !root.profile-active && root.active-tool != "slice" && root.active-tool != "loop_cut" {
                                root.viewport-zoom(event.delta-y / 1px);
                            }
                            accept
                        }
                    }

                    if viewport-touch.is-box-select: Rectangle {
                        x: min(viewport-touch.last-x, viewport-touch.mouse-x);
                        y: min(viewport-touch.last-y, viewport-touch.mouse-y);
                        width: abs(viewport-touch.mouse-x - viewport-touch.last-x);
                        height: abs(viewport-touch.mouse-y - viewport-touch.last-y);
                        background: DesignTokens.selection.transparentize(0.9);
                        border-color: DesignTokens.selection;
                        border-width: 1px;
                    }
                    if viewport-touch.is-lasso-select: Path {
                        commands: viewport-touch.lasso-commands;
                        fill: transparent;
                        stroke: DesignTokens.selection;
                        stroke-width: 1.5px;
                    }

                    // Pill de preselection (Object Info do Blender, topo-esquerda):
                    // rótulo do alvo sob o cursor + dica contextual do domínio.
                    // Sem hover, a primeira linha vira o resumo da seleção para
                    // o feedback nunca sumir da tela. Texto não consome
                    // ponteiro: o TouchArea abaixo segue livre.
                    if root.hover-label != "" || root.selection-summary != "" || root.context-hint != "": Rectangle {
                        x: 14px;
                        y: 56px;
                        width: min(280px, parent.width * 0.4);
                        height: preselection-content.preferred-height;
                        border-radius: 8px;
                        background: DesignTokens.scrim;
                        border-width: 1px;
                        border-color: DesignTokens.border;

                        preselection-content := VerticalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 2px;
                            alignment: start;

                            if root.hover-label != "": Text {
                                text: root.hover-label;
                                color: DesignTokens.hover;
                                font-size: 11px;
                                font-weight: 700;
                                overflow: elide;
                            }
                            if root.hover-label == "" && root.selection-summary != "": Text {
                                text: root.selection-summary;
                                color: DesignTokens.text-primary;
                                font-size: 11px;
                                font-weight: 700;
                                overflow: elide;
                            }
                            if root.context-hint != "": Text {
                                text: root.context-hint;
                                color: DesignTokens.text-secondary;
                                font-size: 10px;
                                overflow: elide;
                            }
                        }
                    }

                    // Grupos semânticos da viewport: não comprimir a barra a
                    // 60% quando há espaço útil disponível.
                    viewport-bar := Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: 14px;
                        width: min(max(viewport-bar-row.preferred-width + 28px, 360px), parent.width - 28px);
                        height: 38px;
                        border-radius: 8px;
                        background: DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: DesignTokens.border;

                        viewport-bar-row := HorizontalLayout {
                            x: 14px;
                            y: 5px;
                            width: parent.width - 28px;
                            height: self.preferred-height;
                            spacing: 8px;
                            alignment: start;

                            // --- Visão (esquerda) ---
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                            if root.viewport-region-width >= 600: Text {
                                text: is-orthographic ? "Ortho" : "Persp";
                                color: DesignTokens.text-primary;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            Rectangle { width: 1px; height: 18px; background: DesignTokens.border; }

                            ViewportBarButton {
                                icon: IconSet.Camera;
                                label: "Projection";
                                active: is-orthographic;
                                clicked => { root.toggle-projection-requested(); }
                            }
                            if root.viewport-region-width >= 600: ViewportBarButton {
                                icon: IconSet.Maximize2;
                                label: "Frame";
                                active: false;
                                clicked => { root.command-executed("view.frame_selection"); }
                            }
                            if root.viewport-region-width >= 600: ViewportBarButton {
                                icon: IconSet.RotateCcw;
                                label: "Reset view";
                                active: false;
                                clicked => { root.reset-camera-requested(); }
                            }
                            }

                            Rectangle { width: 1px; height: 18px; background: DesignTokens.border; }

                            // Ícones vetoriais de modo: estrutura, volume,
                            // material e iluminação são visualmente distintos.
                            HorizontalLayout {
                                spacing: 3px;
                                alignment: start;
                                ViewportSvgButton { glyph: @image-url("icons/view-wire.svg"); label: root.label-view-wireframe; description: root.label-view-wireframe-hint; active: root.shading-mode == "wireframe"; clicked => { root.shading-mode-set("wireframe"); } }
                                ViewportSvgButton { glyph: @image-url("icons/view-solid.svg"); label: root.label-view-solid; description: root.label-view-solid-hint; active: root.shading-mode == "solid"; clicked => { root.shading-mode-set("solid"); } }
                                ViewportSvgButton { glyph: @image-url("icons/view-material.svg"); label: root.label-view-material; description: root.label-view-material-hint; active: root.shading-mode == "material"; clicked => { root.shading-mode-set("material"); } }
                                ViewportSvgButton { glyph: @image-url("icons/view-lit.svg"); label: root.label-view-lit; description: root.label-view-lit-hint; active: root.shading-mode == "rendered"; clicked => { root.shading-mode-set("rendered"); } }
                            }

                            Rectangle { width: 1px; height: 18px; background: DesignTokens.border; }

                            ViewportBarButton {
                                icon: IconSet.Eye;
                                label: "X-Ray";
                                active: root.show-xray;
                                clicked => { root.toggle-xray-requested(); }
                            }
                            ViewportBarButton {
                                icon: IconSet.Settings2;
                                label: "Shading options";
                                active: root.shading-popover-open;
                                clicked => { root.shading-popover-toggled(!root.shading-popover-open); }
                            }
                            if root.viewport-region-width >= 600: ViewportBarButton {
                                icon: IconSet.Crosshair;
                                label: "\{root.label-model-pivot}: \{root.pivot-label}";
                                description: root.hint-model-pivot;
                                active: root.pivot-menu-open;
                                clicked => { root.pivot-menu-toggled(!root.pivot-menu-open); }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            // --- Domínio de seleção (centro) ---
                            HorizontalLayout {
                                spacing: 3px;
                                alignment: center;
                            for domain in [
                                { id: "OBJECT", icon: IconSet.Box, label: "Object" },
                                { id: "POINT", icon: IconSet.CircleDot, label: "Point" },
                                { id: "EDGE", icon: IconSet.SquareDashed, label: "Edge" },
                                { id: "FACE", icon: IconSet.Square, label: "Face" },
                            ]: ViewportBarButton {
                                icon: domain.icon;
                                label: domain.label;
                                active: selection-domain == domain.id;
                                emphasized: true;
                                clicked => { root.selection-domain-changed(domain.id); }
                            }
                            }

                            Rectangle { horizontal-stretch: 1; }
                        }
                    }

                    Rectangle {
                        x: 14px;
                        y: parent.height - 48px;
                        width: 180px;
                        height: 28px;
                        border-radius: 5px;
                        background: DesignTokens.surface-raised;
                        Text {
                            text: "\{active-tool}  ·  \{active-workspace}";
                            color: DesignTokens.text-secondary;
                            font-size: 11px;
                            vertical-alignment: center;
                            x: 10px;
                        }
                    }

                    // Gizmo de transformação: hastes curtas de tamanho fixo em
                    // tela, com setas, só com Move/Rotate/Scale. Nunca linhas
                    // infinitas: o padrão é controle de tamanho aparente constante.
                    if gizmo-visible && active-workspace == "MODEL": Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        background: transparent;

                        // Hierarquia do gizmo: o eixo ativo domina, o eixo sob o
                        // cursor clareia, os demais esmaecem durante o arrasto.
                        Path {
                            commands: root.gizmo-x-commands;
                            fit: ImageFit.preserve;
                            stroke: root.gizmo-handle-color(0, DesignTokens.axis-x);
                            stroke-width: root.gizmo-handle-width(0);
                            fill: transparent;
                        }
                        Path {
                            commands: root.gizmo-y-commands;
                            fit: ImageFit.preserve;
                            stroke: root.gizmo-handle-color(1, DesignTokens.axis-y);
                            stroke-width: root.gizmo-handle-width(1);
                            fill: transparent;
                        }
                        Path {
                            commands: root.gizmo-z-commands;
                            fit: ImageFit.preserve;
                            stroke: root.gizmo-handle-color(2, DesignTokens.axis-z);
                            stroke-width: root.gizmo-handle-width(2);
                            fill: transparent;
                        }
                        Path {
                            commands: root.gizmo-x-arrow-commands;
                            fit: ImageFit.preserve;
                            stroke: transparent;
                            fill: root.gizmo-handle-color(0, DesignTokens.axis-x);
                        }
                        Path {
                            commands: root.gizmo-y-arrow-commands;
                            fit: ImageFit.preserve;
                            stroke: transparent;
                            fill: root.gizmo-handle-color(1, DesignTokens.axis-y);
                        }
                        Path {
                            commands: root.gizmo-z-arrow-commands;
                            fit: ImageFit.preserve;
                            stroke: transparent;
                            fill: root.gizmo-handle-color(2, DesignTokens.axis-z);
                        }
                        Path { commands: root.gizmo-x-scale-commands; fit: ImageFit.preserve; stroke: DesignTokens.canvas; stroke-width: 1px; fill: root.gizmo-handle-color(0, DesignTokens.axis-x); }
                        Path { commands: root.gizmo-y-scale-commands; fit: ImageFit.preserve; stroke: DesignTokens.canvas; stroke-width: 1px; fill: root.gizmo-handle-color(1, DesignTokens.axis-y); }
                        Path { commands: root.gizmo-z-scale-commands; fit: ImageFit.preserve; stroke: DesignTokens.canvas; stroke-width: 1px; fill: root.gizmo-handle-color(2, DesignTokens.axis-z); }
                        Path { commands: root.gizmo-x-rotate-commands; fit: ImageFit.preserve; stroke: root.gizmo-handle-color(0, DesignTokens.axis-x).transparentize(0.32); stroke-width: 1.5px; fill: transparent; }
                        Path { commands: root.gizmo-y-rotate-commands; fit: ImageFit.preserve; stroke: root.gizmo-handle-color(1, DesignTokens.axis-y).transparentize(0.32); stroke-width: 1.5px; fill: transparent; }
                        Path { commands: root.gizmo-z-rotate-commands; fit: ImageFit.preserve; stroke: root.gizmo-handle-color(2, DesignTokens.axis-z).transparentize(0.32); stroke-width: 1.5px; fill: transparent; }
                        Rectangle {
                            x: gizmo-origin-x - 4px;
                            y: gizmo-origin-y - 4px;
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: DesignTokens.text-primary;
                            border-width: 1px;
                            border-color: DesignTokens.canvas;
                        }
                    }

                    // Tripé de navegação no alto à direita. Arrastar orbita a
                    // câmera; clicar em um eixo mantém o alinhamento da vista.
                    Rectangle {
                        x: view-gizmo-origin-x - 54px;
                        y: view-gizmo-origin-y - 54px;
                        width: 108px;
                        height: 108px;
                        clip: true;
                        background: transparent;

                        TouchArea {
                            property <length> last-x;
                            property <length> last-y;
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                    self.last-x = self.mouse-x;
                                    self.last-y = self.mouse-y;
                                }
                            }
                            moved => {
                                if self.pressed {
                                    root.viewport-orbit((self.mouse-x - self.last-x) / 1px, (self.mouse-y - self.last-y) / 1px);
                                    self.last-x = self.mouse-x;
                                    self.last-y = self.mouse-y;
                                }
                            }
                        }

                        Path {
                            commands: root.view-gizmo-x-commands;
                            fit: ImageFit.preserve;
                            stroke: DesignTokens.axis-x;
                            stroke-width: 2px;
                            fill: transparent;
                        }
                        Path {
                            commands: root.view-gizmo-y-commands;
                            fit: ImageFit.preserve;
                            stroke: DesignTokens.axis-y;
                            stroke-width: 2px;
                            fill: transparent;
                        }
                        Path {
                            commands: root.view-gizmo-z-commands;
                            fit: ImageFit.preserve;
                            stroke: DesignTokens.axis-z;
                            stroke-width: 2px;
                            fill: transparent;
                        }
                        for axis in [
                            { id: "x", label: "X", x: root.view-gizmo-x-end-x, y: root.view-gizmo-x-end-y, tint: DesignTokens.axis-x },
                            { id: "y", label: "Y", x: root.view-gizmo-y-end-x, y: root.view-gizmo-y-end-y, tint: DesignTokens.axis-y },
                            { id: "z", label: "Z", x: root.view-gizmo-z-end-x, y: root.view-gizmo-z-end-y, tint: DesignTokens.axis-z },
                        ]: Rectangle {
                            x: axis.x - 10px;
                            y: axis.y - 10px;
                            width: 20px;
                            height: 20px;
                            border-radius: 10px;
                            background: DesignTokens.surface-raised;
                            border-width: 1px;
                            border-color: axis.tint;
                            accessible-role: button;
                            accessible-label: axis.label;
                            Text { text: axis.label; color: axis.tint; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea {
                                property <length> last-x;
                                property <length> last-y;
                                property <bool> dragged: false;
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                        self.last-x = self.mouse-x;
                                        self.last-y = self.mouse-y;
                                        self.dragged = false;
                                    }
                                }
                                moved => {
                                    if self.pressed {
                                        if abs(self.mouse-x - self.last-x) > 1px || abs(self.mouse-y - self.last-y) > 1px {
                                            self.dragged = true;
                                            root.viewport-orbit((self.mouse-x - self.last-x) / 1px, (self.mouse-y - self.last-y) / 1px);
                                            self.last-x = self.mouse-x;
                                            self.last-y = self.mouse-y;
                                        }
                                    }
                                }
                                clicked => { if !self.dragged { root.view-axis-clicked(axis.id); } }
                            }
                        }
                    }

                    // Barra contextual flutuante na base da viewport.
                    context-bar := Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: parent.height - self.height - 14px;
                        width: bar-row.preferred-width + 16px;
                        height: 40px;
                        border-radius: 10px;
                        background: DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        drop-shadow-blur: 12px;
                        drop-shadow-color: #00000066;
                        drop-shadow-offset-y: 3px;

                        bar-row := HorizontalLayout {
                            x: 8px;
                            y: 4px;
                            width: self.preferred-width;
                            height: self.preferred-height;
                            spacing: 4px;
                            alignment: center;

                            ToolButton {
                                icon: IconSet.MousePointer2;
                                semantic-label: root.label-model-select;
                                description: root.hint-model-select;
                                active: active-tool == "select";
                                clicked => { root.active-tool-changed("select"); }
                            }

                            if active-workspace != "PAINT": ViewportSvgButton {
                                glyph: @image-url("icons/tool-position.svg");
                                label: root.label-model-position;
                                description: root.hint-model-position;
                                active: active-tool == "move";
                                clicked => { root.active-tool-changed("move"); }
                            }
                            if active-workspace != "PAINT": ViewportSvgButton {
                                glyph: @image-url("icons/tool-rotate.svg");
                                label: root.label-model-rotate;
                                description: root.hint-model-rotate;
                                active: active-tool == "rotate";
                                clicked => { root.active-tool-changed("rotate"); }
                            }
                            if active-workspace != "PAINT": ViewportSvgButton {
                                glyph: @image-url("icons/tool-scale.svg");
                                label: root.label-model-scale;
                                description: root.hint-model-scale;
                                active: active-tool == "scale";
                                clicked => { root.active-tool-changed("scale"); }
                            }
                            if active-workspace == "MODEL": ViewportSvgButton {
                                glyph: @image-url("icons/tool-transform.svg");
                                label: root.label-model-transform;
                                description: root.hint-model-transform;
                                active: active-tool == "transform";
                                clicked => { root.command-executed("model.tool_transform"); }
                            }

                            if active-workspace == "MODEL": Rectangle {
                                width: 1px;
                                height: 22px;
                                background: DesignTokens.border;
                            }
                            if active-workspace == "MODEL": ToolButton {
                                icon: IconSet.Spline;
                                semantic-label: root.label-model-lasso;
                                description: root.hint-model-lasso;
                                active: active-tool == "lasso_select";
                                clicked => { root.command-executed("model.tool_lasso"); }
                            }
                            if active-workspace == "MODEL" && root.viewport-region-width >= 760: ToolButton {
                                icon: IconSet.Copy;
                                semantic-label: "Duplicate";
                                clicked => { root.duplicate-requested(); }
                            }
                            if active-workspace == "MODEL": ToolButton {
                                icon: IconSet.Move3d;
                                semantic-label: "Extrude";
                                clicked => { root.command-executed("model.extrude"); }
                            }
                            if active-workspace == "MODEL" && root.viewport-region-width >= 760: ToolButton {
                                icon: IconSet.ArrowUpDown;
                                semantic-label: root.label-model-push-pull;
                                description: root.hint-model-push-pull;
                                clicked => { root.command-executed("model.push_pull"); }
                            }
                            if active-workspace == "MODEL": ToolButton {
                                icon: IconSet.SquareDashed;
                                semantic-label: "Inset";
                                clicked => { root.command-executed("model.inset"); }
                            }
                            if active-workspace == "MODEL": ToolButton {
                                icon: IconSet.CircleDot;
                                semantic-label: "Bevel";
                                clicked => { root.command-executed("model.bevel"); }
                            }
                            if active-workspace == "MODEL": ToolButton {
                                icon: IconSet.Scissors;
                                semantic-label: "Knife";
                                clicked => { root.command-executed("model.knife"); }
                            }
                            if active-workspace == "MODEL" && root.viewport-region-width >= 760: ToolButton {
                                icon: IconSet.Grid2x2;
                                semantic-label: root.label-model-loop-cut;
                                description: root.hint-model-loop-cut;
                                active: active-tool == "loop_cut";
                                clicked => { root.active-tool-changed("loop_cut"); }
                            }
                            if active-workspace == "MODEL" && root.viewport-region-width >= 760: ToolButton {
                                icon: IconSet.PenLine;
                                semantic-label: root.label-model-profile;
                                description: root.hint-model-profile;
                                active: active-tool == "draw_profile";
                                clicked => { root.active-tool-changed("draw_profile"); }
                            }
                            if active-workspace == "MODEL" && root.viewport-region-width >= 760: ToolButton {
                                icon: IconSet.Square;
                                semantic-label: "Subdivide";
                                clicked => { root.command-executed("model.subdivide"); }
                            }
                            if active-workspace == "MODEL" && root.viewport-region-width >= 760: ToolButton {
                                icon: IconSet.Merge;
                                semantic-label: "Merge Center";
                                clicked => { root.command-executed("model.merge"); }
                            }
                            if active-workspace == "MODEL" && root.viewport-region-width >= 760: ToolButton {
                                icon: IconSet.Slice;
                                semantic-label: root.label-model-slice;
                                description: root.hint-model-slice;
                                active: active-tool == "slice";
                                clicked => { root.active-tool-changed("slice"); }
                            }

                            if active-workspace == "PAINT": ToolButton {
                                icon: IconSet.Paintbrush;
                                semantic-label: "Brush";
                                active: active-tool == "brush";
                                clicked => { root.active-tool-changed("brush"); }
                            }
                            if active-workspace == "PAINT": ToolButton {
                                icon: IconSet.Eraser;
                                semantic-label: "Eraser";
                                active: active-tool == "eraser";
                                clicked => { root.active-tool-changed("eraser"); }
                            }
                            if active-workspace == "PAINT": ToolButton {
                                icon: IconSet.Pipette;
                                semantic-label: "Color Picker";
                                active: active-tool == "picker";
                                clicked => { root.active-tool-changed("picker"); }
                            }
                            if active-workspace == "PAINT": ToolButton {
                                icon: IconSet.PaintBucket;
                                semantic-label: "Fill";
                                active: active-tool == "fill";
                                clicked => { root.active-tool-changed("fill"); }
                            }
                            if active-workspace == "PAINT": ToolButton {
                                icon: IconSet.SquareDashed;
                                semantic-label: "Line";
                                active: active-tool == "line";
                                clicked => { root.active-tool-changed("line"); }
                            }
                            if active-workspace == "PAINT": ToolButton {
                                icon: IconSet.Square;
                                semantic-label: "Rectangle";
                                active: active-tool == "rectangle";
                                clicked => { root.active-tool-changed("rectangle"); }
                            }

                            if active-workspace == "UV": ToolButton {
                                icon: IconSet.Maximize2;
                                semantic-label: "Unwrap";
                                clicked => { root.command-executed("uv.unwrap_auto"); }
                            }
                            if active-workspace == "UV": ToolButton {
                                icon: IconSet.Grid2x2;
                                semantic-label: "Pack Islands";
                                clicked => { root.command-executed("uv.pack_islands"); }
                            }

                            Rectangle {
                                width: 1px;
                                height: 22px;
                                background: DesignTokens.border;
                            }
                            if active-workspace != "MODEL" || root.viewport-region-width >= 760: ToolButton {
                                icon: IconSet.Trash2;
                                semantic-label: "Delete";
                                clicked => { root.delete-requested(); }
                            }
                            if active-workspace == "MODEL" && root.viewport-region-width < 760: ToolButton {
                                icon: IconSet.MoreHorizontal;
                                semantic-label: root.label-more-model-tools;
                                active: root.shelf-overflow-open;
                                clicked => { root.shelf-overflow-open = !root.shelf-overflow-open; }
                            }
                        }
                    }

                    if root.pivot-menu-open: Rectangle {
                        x: min(max(8px, (parent.width - self.width) / 2), parent.width - self.width - 8px);
                        y: 54px;
                        width: 240px;
                        height: 176px;
                        border-radius: 8px;
                        background: DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        drop-shadow-blur: 12px;
                        drop-shadow-color: #00000080;
                        VerticalLayout {
                            padding: 10px; spacing: 4px;
                            Text { text: root.label-model-pivot; color: DesignTokens.text-primary; font-size: 11px; font-weight: 700; }
                            for item in [
                                { id: "median", label: root.pivot-median-label },
                                { id: "bounds", label: root.pivot-bounds-label },
                                { id: "cursor", label: root.pivot-cursor-label },
                                { id: "individual", label: root.pivot-individual-label },
                            ]: Rectangle {
                                height: 28px; border-radius: 4px;
                                background: root.pivot-id == item.id ? DesignTokens.surface-hover : transparent;
                                Text { text: item.label; x: 8px; color: root.pivot-id == item.id ? DesignTokens.accent : DesignTokens.text-primary; font-size: 10px; vertical-alignment: center; }
                                TouchArea { clicked => { root.pivot-set(item.id); root.pivot-menu-toggled(false); } }
                            }
                        }
                    }

                    if root.shelf-overflow-open && active-workspace == "MODEL" && root.viewport-region-width < 760: Rectangle {
                        x: min(parent.width - self.width - 14px, context-bar.x + context-bar.width - self.width);
                        y: context-bar.y - self.height - 8px;
                        width: 190px;
                        height: 292px;
                        border-radius: 8px;
                        background: DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 2px;
                            ContextMenuItem { label: "Duplicate"; clicked => { root.shelf-overflow-open = false; root.duplicate-requested(); } }
                            ContextMenuItem { label: "Loop Cut"; clicked => { root.shelf-overflow-open = false; root.command-executed("model.loop_cut"); } }
                            ContextMenuItem { label: root.label-model-push-pull; clicked => { root.shelf-overflow-open = false; root.command-executed("model.push_pull"); } }
                            ContextMenuItem { label: root.label-model-profile; clicked => { root.shelf-overflow-open = false; root.active-tool-changed("draw_profile"); } }
                            ContextMenuItem { label: root.label-model-slice; clicked => { root.shelf-overflow-open = false; root.active-tool-changed("slice"); } }
                            ContextMenuItem { label: "Subdivide"; clicked => { root.shelf-overflow-open = false; root.command-executed("model.subdivide"); } }
                            ContextMenuItem { label: "Merge Center"; clicked => { root.shelf-overflow-open = false; root.command-executed("model.merge"); } }
                            ContextMenuItem { label: "Slice"; clicked => { root.shelf-overflow-open = false; root.command-executed("model.slice"); } }
                            ContextMenuItem { label: "Delete"; danger: true; clicked => { root.shelf-overflow-open = false; root.delete-requested(); } }
                        }
                    }

                    // Menu de criação aberto a partir do trilho esquerdo.
                    if add-menu-open && active-workspace == "MODEL": Rectangle {
                        x: 14px;
                        y: 58px;
                        width: 2 * 34px + 216px;
                        height: 88px;
                        border-radius: 10px;
                        background: DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        drop-shadow-blur: 12px;
                        drop-shadow-color: #00000066;
                        drop-shadow-offset-y: 3px;

                        HorizontalLayout {
                            padding: 8px;
                            spacing: 6px;
                            alignment: center;

                            ToolButton {
                                icon: IconSet.Box;
                                semantic-label: "Cube";
                                clicked => { root.add-primitive-requested("cube"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon: IconSet.CircleDot;
                                semantic-label: "Sphere";
                                clicked => { root.add-primitive-requested("sphere"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon: IconSet.Cylinder;
                                semantic-label: "Cylinder";
                                clicked => { root.add-primitive-requested("cylinder"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon: IconSet.Square;
                                semantic-label: "Plane";
                                clicked => { root.add-primitive-requested("plane"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon: IconSet.Triangle;
                                semantic-label: "Cone";
                                clicked => { root.add-primitive-requested("cone"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon: IconSet.Pill;
                                semantic-label: "Capsule";
                                clicked => { root.add-primitive-requested("capsule"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon: IconSet.Torus;
                                semantic-label: "Torus";
                                clicked => { root.add-primitive-requested("torus"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon: IconSet.Circle;
                                semantic-label: "Circle";
                                clicked => { root.add-primitive-requested("circle"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon: IconSet.Diamond;
                                semantic-label: "Icosphere";
                                clicked => { root.add-primitive-requested("icosphere"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon: IconSet.Pyramid;
                                semantic-label: "Wedge";
                                clicked => { root.add-primitive-requested("wedge"); root.add-menu-changed(false); }
                            }
                        }
                    }
                }

                if inspector-visible && !compact-shell: SplitterVertical {
                    value: root.inspector-width;
                    direction: -1.0;
                    moved(width) => { root.inspector-width-changed(width / 1px); }
                }

                if inspector-visible && !compact-shell: Rectangle {
                    width: inspector-collapsed ? 48px : inspector-width;
                    y: 0;
                    height: 100%;
                    background: transparent;

                    if inspector-collapsed: Rectangle {
                        x: 0;
                        width: 48px;
                        height: 100%;
                        background: DesignTokens.surface;
                        border-width: 1px;
                        border-color: DesignTokens.border;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 16px;
                            alignment: start;

                            Rectangle {
                                width: 24px;
                                height: 24px;
                                accessible-role: button;
                                accessible-label: root.label-expand-inspector;
                                IconDisplay {
                                    icon: IconSet.ChevronLeft;
                                    size: 16px;
                                    stroke: DesignTokens.text-secondary;
                                }
                                TouchArea {
                                    clicked => { root.inspector-collapsed = false; }
                                }
                            }

                            Text {
                                text: root.label-tab-parts;
                                color: DesignTokens.text-muted;
                                font-size: 10px;
                                font-weight: 600;
                                transform-rotation: -90deg;
                                TouchArea {
                                    clicked => {
                                        root.inspector-collapsed = false;
                                        root.model-parts-open = true;
                                    }
                                }
                            }
                            Text {
                                text: root.label-tab-transform;
                                color: DesignTokens.text-muted;
                                font-size: 10px;
                                font-weight: 600;
                                transform-rotation: -90deg;
                                TouchArea {
                                    clicked => {
                                        root.inspector-collapsed = false;
                                        root.model-transform-open = true;
                                    }
                                }
                            }
                            Text {
                                text: root.label-tab-material;
                                color: DesignTokens.text-muted;
                                font-size: 10px;
                                font-weight: 600;
                                transform-rotation: -90deg;
                                TouchArea {
                                    clicked => {
                                        root.inspector-collapsed = false;
                                        root.model-material-open = true;
                                    }
                                }
                            }
                            Text {
                                text: root.label-tab-object;
                                color: DesignTokens.text-muted;
                                font-size: 10px;
                                font-weight: 600;
                                transform-rotation: -90deg;
                                TouchArea {
                                    clicked => {
                                        root.inspector-collapsed = false;
                                        root.model-object-open = true;
                                    }
                                }
                            }
                        }
                    }

                    if !inspector-collapsed: VerticalLayout {
                        padding-left: 8px;
                        padding-right: 12px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 10px;
                        HorizontalLayout {
                            height: 28px;
                            Text {
                                text: root.label-inspector;
                                color: DesignTokens.text-primary;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            TopAction {
                                icon: IconSet.ChevronRight;
                                semantic-label: root.label-collapse-inspector;
                                active: false;
                                clicked => { root.inspector-collapsed = true; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text {
                                text: active-workspace;
                                color: DesignTokens.accent;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }

                        ScrollView {
                            vertical-stretch: 1;
                            horizontal-scrollbar-policy: always-off;
                            vertical-scrollbar-policy: as-needed;
                            VerticalLayout {
                                spacing: 10px;
                                width: parent.width;
                                vertical-stretch: 0;

                        if active-workspace == "MODEL": VerticalLayout {
                            spacing: 10px;
                            vertical-stretch: 0;

                            InspectorSection {
                                title: root.label-parts;
                                open: root.model-parts-open;
                                toggled => { root.model-parts-open = !root.model-parts-open; }
                                toggle-all => {
                                    root.model-parts-open = !root.model-parts-open;
                                    root.model-transform-open = root.model-parts-open;
                                    root.model-material-open = root.model-parts-open;
                                    root.model-object-open = root.model-parts-open;
                                }

                                VerticalLayout {
                                    spacing: 6px;
                                    PartsFilterRow {
                                        horizontal-stretch: 1;
                                        search-label: root.label-search-parts;
                                        selected-only-label: root.label-selected-parts-only;
                                        sort-label: root.label-sort-parts;
                                        query <=> root.parts-query;
                                        selected-only <=> root.parts-selected-only;
                                        sort-by-name <=> root.parts-sort-by-name;
                                        visible-count: root.parts-items.length;
                                        total-count: root.scene-items.length;
                                        query-changed(query) => { root.parts-query-changed(query); }
                                        selected-only-changed(enabled) => { root.parts-selected-only-changed(enabled); }
                                        sort-changed(enabled) => { root.parts-sort-changed(enabled); }
                                    }
                                    PartsRowSizeControl {
                                        horizontal-stretch: 1;
                                        semantic-label: root.label-parts-row-size;
                                        accessibility-id: "model-inspector-parts-row-height";
                                        value <=> root.parts-row-height;
                                        value-changed(value) => { root.parts-row-height-changed(value); }
                                    }
                                    ListView {
                                        height: min(184px, max(32px, root.parts-items.length * root.parts-row-height * 1px));
                                        horizontal-scrollbar-policy: always-off;
                                        vertical-scrollbar-policy: as-needed;
                                        accessible-role: list;
                                        accessible-label: root.label-parts;
                                        accessible-id: "model-inspector-parts-list";
                                        accessible-item-count: root.parts-items.length;
                                        for item in root.parts-items: Rectangle {
                                            height: root.parts-row-height * 1px;
                                            accessible-role: list-item;
                                            accessible-label: item.name;
                                            accessible-item-selectable: true;
                                            accessible-item-selected: item.selected;
                                            background: item.selected ? DesignTokens.surface-hover : transparent;
                                            border-width: item.active ? 1px : 0px;
                                            border-color: item.active ? DesignTokens.selection-active : DesignTokens.selection;
                                            border-radius: 4px;
                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 4px;
                                                spacing: 4px;
                                                alignment: center;
                                                TouchArea {
                                                    property <bool> extend: false;
                                                    horizontal-stretch: 1;
                                                    pointer-event(event) => {
                                                        self.extend = event.modifiers.shift;
                                                        if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                                                            root.scene-context-requested(item.id, (self.absolute-position.x + self.mouse-x) / 1px, (self.absolute-position.y + self.mouse-y) / 1px);
                                                        }
                                                    }
                                                    clicked => { root.scene-select(item.id, self.extend); }
                                                    HorizontalLayout {
                                                        spacing: 5px;
                                                        alignment: center;
                                                        IconDisplay { icon: IconSet.Box; size: 12px; stroke: item.selected ? DesignTokens.accent : DesignTokens.text-muted; }
                                                        if root.rename-active && item.selected: TextInput {
                                                            text: root.rename-value;
                                                            horizontal-stretch: 1;
                                                            font-size: 11px;
                                                            color: DesignTokens.text-primary;
                                                            single-line: true;
                                                            init => { self.focus(); }
                                                            edited => { root.rename-edited(self.text); }
                                                            accepted => { root.rename-committed(self.text); }
                                                        }
                                                        if !(root.rename-active && item.selected): Text {
                                                            text: item.name;
                                                            color: item.selected ? DesignTokens.text-primary : DesignTokens.text-secondary;
                                                            font-size: 11px;
                                                            font-weight: item.selected ? 600 : 400;
                                                            vertical-alignment: center;
                                                            horizontal-stretch: 1;
                                                            overflow: elide;
                                                        }
                                                    }
                                                }
                                                Rectangle {
                                                    width: 22px; height: 22px;
                                                    accessible-role: button;
                                                    accessible-label: item.visible ? root.label-hide-part : root.label-show-part;
                                                    IconDisplay { icon: item.visible ? IconSet.Eye : IconSet.EyeOff; size: 13px; stroke: item.visible ? DesignTokens.text-secondary : DesignTokens.text-muted; }
                                                    TouchArea { clicked => { root.scene-toggle-visibility(item.id); } }
                                                }
                                                Rectangle {
                                                    width: 22px; height: 22px;
                                                    accessible-role: button;
                                                    accessible-label: item.locked ? root.label-unlock-part : root.label-lock-part;
                                                    IconDisplay { icon: item.locked ? IconSet.Lock : IconSet.LockOpen; size: 13px; stroke: item.locked ? DesignTokens.accent : DesignTokens.text-muted; }
                                                    TouchArea { clicked => { root.scene-toggle-lock(item.id); } }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if selection-domain == "OBJECT": InspectorSection {
                                title: "Transform";
                                open: root.model-transform-open;
                                toggled => { root.model-transform-open = !root.model-transform-open; }
                                toggle-all => {
                                    root.model-transform-open = !root.model-transform-open;
                                    root.model-parts-open = root.model-transform-open;
                                    root.model-material-open = root.model-transform-open;
                                    root.model-object-open = root.model-transform-open;
                                }

                                VerticalLayout {
                                    spacing: 6px;
                                    padding-top: 4px;
                                    Vector3Field {
                                        row-label: "Position";
                                        field-hint: root.label-numeric-field-hint;
                                        x-value: root.pos-x;
                                        y-value: root.pos-y;
                                        z-value: root.pos-z;
                                        scrubbed(axis, delta, fine) => { root.transform-scrubbed("pos", axis, delta, fine); }
                                        scrub-started => { root.transform-scrub-started("pos"); }
                                        scrub-finished => { root.transform-scrub-finished(); }
                                        text-committed(axis, text) => { root.transform-text-committed("pos", axis, text) }
                                        scrub-cancelled => { root.transform-scrub-cancelled(); }
                                    }
                                    Vector3Field {
                                        row-label: "Rotation";
                                        field-hint: root.label-numeric-field-hint;
                                        step: 1;
                                        x-value: root.rot-x;
                                        y-value: root.rot-y;
                                        z-value: root.rot-z;
                                        scrubbed(axis, delta, fine) => { root.transform-scrubbed("rot", axis, delta, fine); }
                                        scrub-started => { root.transform-scrub-started("rot"); }
                                        scrub-finished => { root.transform-scrub-finished(); }
                                        text-committed(axis, text) => { root.transform-text-committed("rot", axis, text) }
                                        scrub-cancelled => { root.transform-scrub-cancelled(); }
                                    }
                                    Vector3Field {
                                        row-label: "Scale";
                                        field-hint: root.label-numeric-field-hint;
                                        x-value: root.scale-x;
                                        y-value: root.scale-y;
                                        z-value: root.scale-z;
                                        scrubbed(axis, delta, fine) => { root.transform-scrubbed("scale", axis, delta, fine); }
                                        scrub-started => { root.transform-scrub-started("scale"); }
                                        scrub-finished => { root.transform-scrub-finished(); }
                                        text-committed(axis, text) => { root.transform-text-committed("scale", axis, text) }
                                        scrub-cancelled => { root.transform-scrub-cancelled(); }
                                    }
                                }
                            }
                            InspectorSection {
                                title: "Material";
                                open: root.model-material-open;
                                toggled => { root.model-material-open = !root.model-material-open; }
                                toggle-all => {
                                    root.model-material-open = !root.model-material-open;
                                    root.model-parts-open = root.model-material-open;
                                    root.model-transform-open = root.model-material-open;
                                    root.model-object-open = root.model-material-open;
                                }

                                VerticalLayout {
                                    spacing: 8px;
                                    padding-top: 4px;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: center;

                                        Rectangle {
                                            width: 14px;
                                            height: 14px;
                                            border-radius: 3px;
                                            background: DesignTokens.accent;
                                        }

                                        Text {
                                            text: root.material-slots.length > 0 && root.active-material-slot < root.material-slots.length
                                                ? root.material-slots[root.active-material-slot]
                                                : root.active-material-name;
                                            color: DesignTokens.text-primary;
                                            font-size: 11px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                    }

                                    // Material slot selector list
                                    if root.material-slots.length > 1: VerticalLayout {
                                        spacing: 4px;
                                        for slot[index] in root.material-slots: Rectangle {
                                            height: 24px;
                                            border-radius: 4px;
                                            background: index == root.active-material-slot ? DesignTokens.surface-hover : DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: index == root.active-material-slot ? DesignTokens.accent : DesignTokens.border;
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                alignment: center;
                                                spacing: 6px;
                                                Rectangle {
                                                    width: 8px;
                                                    height: 8px;
                                                    border-radius: 2px;
                                                    background: index == root.active-material-slot ? DesignTokens.accent : DesignTokens.text-muted;
                                                }
                                                Text {
                                                    text: slot;
                                                    color: index == root.active-material-slot ? DesignTokens.text-primary : DesignTokens.text-secondary;
                                                    font-size: 10px;
                                                    horizontal-stretch: 1;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            TouchArea {
                                                clicked => { root.active-material-slot = index; }
                                            }
                                        }
                                    }

                                    // Actions: Assign to Faces, + New, Duplicate
                                    HorizontalLayout {
                                        spacing: 6px;
                                        height: 28px;

                                        Rectangle {
                                            horizontal-stretch: 2;
                                            border-radius: 5px;
                                            background: DesignTokens.accent;
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 4px;
                                                IconDisplay {
                                                    icon: IconSet.Check;
                                                    size: 12px;
                                                    stroke: DesignTokens.canvas;
                                                }
                                                Text {
                                                    text: "Assign";
                                                    color: DesignTokens.canvas;
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            TouchArea {
                                                clicked => { root.assign-material-slot(root.active-material-slot); }
                                            }
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 5px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 4px;
                                                IconDisplay {
                                                    icon: IconSet.Plus;
                                                    size: 12px;
                                                    stroke: DesignTokens.text-primary;
                                                }
                                                Text {
                                                    text: "New";
                                                    color: DesignTokens.text-primary;
                                                    font-size: 10px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            TouchArea {
                                                clicked => { root.create-material(); }
                                            }
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 5px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 4px;
                                                IconDisplay {
                                                    icon: IconSet.Copy;
                                                    size: 12px;
                                                    stroke: DesignTokens.text-primary;
                                                }
                                                Text {
                                                    text: "Duplicate";
                                                    color: DesignTokens.text-primary;
                                                    font-size: 10px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            TouchArea {
                                                clicked => { root.duplicate-material(root.active-material-slot); }
                                            }
                                        }
                                    }
                                }
                            }
                            InspectorSection {
                                title: "Object";
                                open: root.model-object-open;
                                toggled => { root.model-object-open = !root.model-object-open; }
                                toggle-all => {
                                    root.model-object-open = !root.model-object-open;
                                    root.model-parts-open = root.model-object-open;
                                    root.model-transform-open = root.model-object-open;
                                    root.model-material-open = root.model-object-open;
                                }
                                VerticalLayout {
                                    spacing: 6px;
                                    vertical-stretch: 0;
                                    Text { text: root.active-object-title; color: DesignTokens.text-secondary; font-size: 10px; }
                                    Text { text: root.active-object-details; color: DesignTokens.text-muted; font-size: 9px; }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        height: 28px;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 5px;
                                    background: DesignTokens.surface-raised;
                                    border-width: 1px;
                                    border-color: DesignTokens.border;
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 6px;
                                        IconDisplay {
                                            icon: IconSet.Copy;
                                            size: 13px;
                                            stroke: DesignTokens.text-primary;
                                        }
                                        Text {
                                            text: root.label-duplicate;
                                            color: DesignTokens.text-primary;
                                            font-size: 11px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                    TouchArea {
                                        clicked => { root.duplicate-requested(); }
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 5px;
                                    background: DesignTokens.surface-raised;
                                    border-width: 1px;
                                    border-color: DesignTokens.border;
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 6px;
                                        IconDisplay {
                                            icon: IconSet.Trash2;
                                            size: 13px;
                                            stroke: DesignTokens.danger;
                                        }
                                        Text {
                                            text: root.label-delete;
                                            color: DesignTokens.danger;
                                            font-size: 11px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                    TouchArea {
                                        clicked => { root.delete-requested(); }
                                    }
                                }
                                    }
                                }
                            }
                            if boolean-operand-name != "": InspectorSection {
                                title: "Boolean";
                                toggled => { self.open = !self.open; }
                                VerticalLayout {
                                    spacing: 6px;
                                    Text { text: "Operand: \{root.boolean-operand-name}"; color: DesignTokens.text-muted; font-size: 10px; }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        ToolButton { icon: IconSet.Merge; semantic-label: "Fuse"; description: "Combine the active part with the operand"; clicked => { root.command-executed("model.fuse"); } }
                                        ToolButton { icon: IconSet.Scissors; semantic-label: "Cut"; description: "Subtract the operand from the active part"; clicked => { root.command-executed("model.cut"); } }
                                        ToolButton { icon: IconSet.CircleDot; semantic-label: "Intersect"; description: "Keep the overlapping volume"; clicked => { root.command-executed("model.intersect"); } }
                                        ToolButton { icon: IconSet.Link; semantic-label: "Join"; description: "Join the operand into the active part"; clicked => { root.join-requested(); } }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        Rectangle {
                                            horizontal-stretch: 1; height: 26px;
                                            background: root.boolean-keep-parts ? DesignTokens.accent : DesignTokens.surface-raised;
                                            border-radius: 4px;
                                            accessible-role: checkbox;
                                            accessible-label: "Keep Parts";
                                            accessible-checked: root.boolean-keep-parts;
                                            Text { text: root.boolean-keep-parts ? "Keep Parts: on" : "Keep Parts: off"; color: root.boolean-keep-parts ? DesignTokens.canvas : DesignTokens.text-secondary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.boolean-keep-parts-set(!root.boolean-keep-parts); } }
                                        }
                                        Rectangle {
                                            width: 92px; height: 26px;
                                            background: DesignTokens.surface-raised;
                                            border-radius: 4px;
                                            accessible-role: button;
                                            accessible-label: "Clear operand";
                                            Text { text: "Clear operand"; color: DesignTokens.text-secondary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.boolean-operand-cleared(); } }
                                        }
                                    }
                                }
                            }
                        }

                        if active-workspace == "PAINT": VerticalLayout {
                            spacing: 10px;

                            InspectorSection {
                                title: "Effects";
                                open: true;
                                toggled => { self.open = !self.open; }

                                VerticalLayout {
                                    spacing: 6px;
                                    padding-top: 4px;

                                    Text {
                                        text: "Add an effect layer";
                                        color: DesignTokens.text-secondary;
                                        font-size: 10px;
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        height: 26px;

                                        for effect in ["Pixelate", "Posterize", "Invert"]: Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            accessible-role: button;
                                            accessible-label: effect;
                                            Text { text: effect; color: DesignTokens.text-primary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                            TouchArea { clicked => { root.paint-effect-layer-added(effect); } }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        height: 26px;

                                        for effect in ["Grain", "BrightnessContrast", "HueSaturation"]: Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            accessible-role: button;
                                            accessible-label: effect;
                                            Text { text: effect; color: DesignTokens.text-primary; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                            TouchArea { clicked => { root.paint-effect-layer-added(effect); } }
                                        }
                                    }

                                    if paint-effect-kind != "": Text {
                                        text: "Active effect: \{root.paint-effect-kind}";
                                        color: DesignTokens.accent;
                                        font-size: 10px;
                                        font-weight: 600;
                                    }
                                    if paint-effect-kind != "" && paint-effect-params.length == 0: Text {
                                        text: "This effect has no parameters.";
                                        color: DesignTokens.text-muted;
                                        font-size: 10px;
                                    }

                                    for param in root.paint-effect-params: HorizontalLayout {
                                        spacing: 6px;
                                        height: 24px;

                                        Text {
                                            text: param.label;
                                            color: DesignTokens.text-secondary;
                                            font-size: 10px;
                                            width: 78px;
                                            vertical-alignment: center;
                                        }
                                        Slider {
                                            horizontal-stretch: 1;
                                            minimum: param.minimum;
                                            maximum: param.maximum;
                                            value: param.value;
                                            changed(value) => { root.paint-effect-param-set(param.key, value); }
                                        }
                                    }
                                }
                            }

                            InspectorSection {
                                title: "Canvas";
                                open: true;
                                toggled => { self.open = !self.open; }

                                VerticalLayout {
                                    spacing: 6px;
                                    padding-top: 4px;

                                    Text {
                                        text: root.paint-canvas-size;
                                        color: DesignTokens.text-muted;
                                        font-size: 10px;
                                    }

                                    // Xadrez de transparência atrás do raster, para
                                    // que pixels com alfa zero não pareçam preto.
                                    Rectangle {
                                        height: 200px;
                                        background: DesignTokens.canvas;
                                        border-width: 1px;
                                        border-color: DesignTokens.border;

                                        Image {
                                            width: 100%;
                                            height: 100%;
                                            image-fit: contain;
                                            source: root.paint-canvas-image;
                                        }
                                    }
                                }
                            }

                            InspectorSection {
                                title: "Fill & Projection";
                                open: true;
                                toggled => { self.open = !self.open; }

                                VerticalLayout {
                                    spacing: 6px;
                                    padding-top: 4px;

                                    Text {
                                        text: "Fill scope";
                                        color: DesignTokens.text-secondary;
                                        font-size: 10px;
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        height: 26px;

                                        for scope in ["ConnectedPixels", "Face", "SelectedFaces", "UvIsland", "Object"]: Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: root.paint-fill-scope == scope ? DesignTokens.accent : DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            accessible-role: radio-button;
                                            accessible-label: scope;
                                            accessible-checked: root.paint-fill-scope == scope;
                                            Text {
                                                text: scope;
                                                color: root.paint-fill-scope == scope ? DesignTokens.canvas : DesignTokens.text-secondary;
                                                font-size: 9px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                            TouchArea { clicked => { root.paint-fill-scope-set(scope); } }
                                        }
                                    }

                                    Text {
                                        text: "Projection";
                                        color: DesignTokens.text-secondary;
                                        font-size: 10px;
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        height: 26px;

                                        for projection in ["Surface", "ScreenSpace"]: Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: root.paint-projection == projection ? DesignTokens.accent : DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            accessible-role: radio-button;
                                            accessible-label: projection;
                                            accessible-checked: root.paint-projection == projection;
                                            Text {
                                                text: projection;
                                                color: root.paint-projection == projection ? DesignTokens.canvas : DesignTokens.text-secondary;
                                                font-size: 10px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            TouchArea { clicked => { root.paint-projection-set(projection); } }
                                        }
                                    }

                                    Text {
                                        text: "Brush lock";
                                        color: DesignTokens.text-secondary;
                                        font-size: 10px;
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        height: 26px;

                                        for lock in ["None", "FirstObject", "FirstFace"]: Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: root.paint-lock == lock ? DesignTokens.accent : DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            accessible-role: radio-button;
                                            accessible-label: lock;
                                            accessible-checked: root.paint-lock == lock;
                                            Text {
                                                text: lock;
                                                color: root.paint-lock == lock ? DesignTokens.canvas : DesignTokens.text-secondary;
                                                font-size: 9px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                            TouchArea { clicked => { root.paint-lock-set(lock); } }
                                        }
                                    }
                                }
                            }

                            InspectorSection {
                                title: "Layers";
                                open: true;
                                toggled => { self.open = !self.open; }

                                VerticalLayout {
                                    spacing: 4px;
                                    padding-top: 4px;

                                    HorizontalLayout {
                                        spacing: 4px;
                                        height: 24px;

                                        Text {
                                            text: root.paint-layer-count;
                                            color: DesignTokens.text-muted;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 3px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            IconDisplay { icon: IconSet.Plus; size: 12px; stroke: DesignTokens.text-secondary; }
                                            accessible-role: button;
                                            accessible-label: "Add layer";
                                            TouchArea { clicked => { root.paint-layer-added(); } }
                                        }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 3px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            IconDisplay { icon: IconSet.FolderOpen; size: 12px; stroke: DesignTokens.text-secondary; }
                                            accessible-role: button;
                                            accessible-label: "Add group";
                                            TouchArea { clicked => { root.paint-layer-group-added(); } }
                                        }
                                    }

                                    for layer in root.paint-layers: Rectangle {
                                        height: 30px;
                                        border-radius: 4px;
                                        background: layer.active ? DesignTokens.surface-hover : transparent;
                                        border-width: layer.active ? 1px : 0px;
                                        border-color: DesignTokens.accent;

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 4px;
                                            alignment: center;

                                            TouchArea {
                                                horizontal-stretch: 1;
                                                clicked => { root.paint-layer-activated(layer.id); }

                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    alignment: center;

                                                    IconDisplay {
                                                        icon: layer.is-group ? IconSet.FolderOpen : IconSet.Square;
                                                        size: 12px;
                                                        stroke: layer.active ? DesignTokens.accent : DesignTokens.text-muted;
                                                    }
                                                    Text {
                                                        text: layer.name;
                                                        color: layer.active ? DesignTokens.text-primary : DesignTokens.text-secondary;
                                                        font-size: 11px;
                                                        font-weight: layer.active ? 600 : 400;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        text: layer.kind-label;
                                                        color: DesignTokens.text-muted;
                                                        font-size: 9px;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }

                                            Rectangle {
                                                width: 18px;
                                                height: 18px;
                                                IconDisplay { icon: IconSet.ChevronUp; size: 11px; stroke: DesignTokens.text-muted; }
                                                accessible-role: button;
                                                accessible-label: "Move layer up";
                                                TouchArea { clicked => { root.paint-layer-moved(layer.id, 1); } }
                                            }
                                            Rectangle {
                                                width: 18px;
                                                height: 18px;
                                                IconDisplay { icon: IconSet.ChevronDown; size: 11px; stroke: DesignTokens.text-muted; }
                                                accessible-role: button;
                                                accessible-label: "Move layer down";
                                                TouchArea { clicked => { root.paint-layer-moved(layer.id, -1); } }
                                            }
                                            Rectangle {
                                                width: 18px;
                                                height: 18px;
                                                IconDisplay {
                                                    icon: layer.visible ? IconSet.Eye : IconSet.EyeOff;
                                                    size: 12px;
                                                    stroke: layer.visible ? DesignTokens.text-secondary : DesignTokens.text-muted;
                                                }
                                                accessible-role: checkbox;
                                                accessible-label: "Layer visible";
                                                accessible-checked: layer.visible;
                                                TouchArea { clicked => { root.paint-layer-visibility-toggled(layer.id); } }
                                            }
                                            Rectangle {
                                                width: 18px;
                                                height: 18px;
                                                IconDisplay {
                                                    icon: layer.locked ? IconSet.Lock : IconSet.LockOpen;
                                                    size: 12px;
                                                    stroke: layer.locked ? DesignTokens.accent : DesignTokens.text-muted;
                                                }
                                                accessible-role: checkbox;
                                                accessible-label: "Layer locked";
                                                accessible-checked: layer.locked;
                                                TouchArea { clicked => { root.paint-layer-lock-toggled(layer.id); } }
                                            }
                                            Rectangle {
                                                width: 18px;
                                                height: 18px;
                                                IconDisplay { icon: IconSet.Trash2; size: 11px; stroke: DesignTokens.danger; }
                                                accessible-role: button;
                                                accessible-label: "Remove layer";
                                                TouchArea { clicked => { root.paint-layer-removed(layer.id); } }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        height: 22px;

                                        Text {
                                            text: "Opacity";
                                            color: DesignTokens.text-secondary;
                                            font-size: 10px;
                                            width: 52px;
                                            vertical-alignment: center;
                                        }
                                        for layer in root.paint-layers: Rectangle {
                                            visible: layer.active;
                                            horizontal-stretch: 1;
                                            height: 22px;

                                            Slider {
                                                minimum: 0.0;
                                                maximum: 1.0;
                                                value: layer.opacity;
                                                changed(value) => { root.paint-layer-opacity-set(layer.id, value); }
                                            }
                                        }
                                    }
                                }
                            }

                            InspectorSection {
                                title: "Color Palette";
                                open: true;
                                toggled => { self.open = !self.open; }

                                VerticalLayout {
                                    spacing: 8px;
                                    padding-top: 4px;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: center;

                                        Rectangle {
                                            width: 36px;
                                            height: 36px;
                                            border-radius: 6px;
                                            background: root.paint-color;
                                            border-width: 2px;
                                            border-color: DesignTokens.accent;
                                        }

                                        Text {
                                            text: root.label-active-brush-color;
                                            color: DesignTokens.text-primary;
                                            font-size: 11px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: center;

                                        ColorSwatch {
                                            swatch-color: #b58cff;
                                            selected: root.paint-color == #b58cff;
                                            clicked => { root.paint-color-changed(0.71, 0.55, 1.0); }
                                        }
                                        ColorSwatch {
                                            swatch-color: #ef4444;
                                            selected: root.paint-color == #ef4444;
                                            clicked => { root.paint-color-changed(0.93, 0.27, 0.27); }
                                        }
                                        ColorSwatch {
                                            swatch-color: #22c55e;
                                            selected: root.paint-color == #22c55e;
                                            clicked => { root.paint-color-changed(0.13, 0.77, 0.37); }
                                        }
                                        ColorSwatch {
                                            swatch-color: #3b82f6;
                                            selected: root.paint-color == #3b82f6;
                                            clicked => { root.paint-color-changed(0.23, 0.51, 0.96); }
                                        }
                                        ColorSwatch {
                                            swatch-color: #eab308;
                                            selected: root.paint-color == #eab308;
                                            clicked => { root.paint-color-changed(0.92, 0.70, 0.03); }
                                        }
                                        ColorSwatch {
                                            swatch-color: #ffffff;
                                            selected: root.paint-color == #ffffff;
                                            clicked => { root.paint-color-changed(1.0, 1.0, 1.0); }
                                        }
                                        ColorSwatch {
                                            swatch-color: #6b7280;
                                            selected: root.paint-color == #6b7280;
                                            clicked => { root.paint-color-changed(0.42, 0.45, 0.50); }
                                        }
                                        ColorSwatch {
                                            swatch-color: #111111;
                                            selected: root.paint-color == #111111;
                                            clicked => { root.paint-color-changed(0.07, 0.07, 0.07); }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        padding-top: 4px;
                                        Rectangle {
                                            height: 24px;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            horizontal-stretch: 1;
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 4px;
                                                IconDisplay { icon: IconSet.Download; size: 12px; stroke: DesignTokens.text-primary; }
                                                Text { text: "Import"; color: DesignTokens.text-primary; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                                            }
                                            TouchArea { clicked => { root.command-file-action("palette.import"); } }
                                        }
                                        Rectangle {
                                            height: 24px;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            horizontal-stretch: 1;
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 4px;
                                                IconDisplay { icon: IconSet.Upload; size: 12px; stroke: DesignTokens.text-primary; }
                                                Text { text: "Export"; color: DesignTokens.text-primary; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                                            }
                                            TouchArea { clicked => { root.command-file-action("palette.export"); } }
                                        }
                                    }
                                }
                            }

                            InspectorSection {
                                title: "Brush Settings";
                                open: true;
                                toggled => { self.open = !self.open; }

                                VerticalLayout {
                                    spacing: 8px;
                                    padding-top: 4px;

                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: "Size: \{Math.round(root.brush-size * 10) / 10}";
                                            color: DesignTokens.text-secondary;
                                            font-size: 11px;
                                            horizontal-stretch: 1;
                                        }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            Text { text: "-"; color: DesignTokens.text-primary; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.brush-size-changed(Math.max(0.1, root.brush-size - 0.2)); } }
                                        }
                                        Rectangle { width: 4px; }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            Text { text: "+"; color: DesignTokens.text-primary; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.brush-size-changed(Math.min(10.0, root.brush-size + 0.2)); } }
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: "Opacity: \{Math.round(root.brush-opacity * 100)}%";
                                            color: DesignTokens.text-secondary;
                                            font-size: 11px;
                                            horizontal-stretch: 1;
                                        }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            Text { text: "-"; color: DesignTokens.text-primary; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.brush-opacity-changed(Math.max(0.05, root.brush-opacity - 0.1)); } }
                                        }
                                        Rectangle { width: 4px; }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            Text { text: "+"; color: DesignTokens.text-primary; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.brush-opacity-changed(Math.min(1.0, root.brush-opacity + 0.1)); } }
                                        }
                                    }
                                }
                            }

                            InspectorSection {
                                title: "Texture Layers";
                                open: true;
                                toggled => { self.open = !self.open; }

                                VerticalLayout {
                                    spacing: 4px;
                                    Rectangle {
                                        height: 28px;
                                        background: DesignTokens.surface-raised;
                                        border-radius: 4px;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 6px;
                                            alignment: center;
                                            IconDisplay { icon: IconSet.Layers3; size: 14px; stroke: DesignTokens.accent; }
                                            Text { text: root.label-albedo-base-color; color: DesignTokens.text-primary; font-size: 11px; vertical-alignment: center; }
                                            Rectangle { horizontal-stretch: 1; }
                                            Text { text: "Active"; color: DesignTokens.success; font-size: 10px; font-weight: 700; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }
                        }

                        if active-workspace == "UV": VerticalLayout {
                            spacing: 10px;

                            InspectorSection {
                                title: "UV Operations";
                                open: true;
                                toggled => { self.open = !self.open; }

                                VerticalLayout {
                                    spacing: 8px;
                                    padding-top: 4px;

                                    Rectangle {
                                        height: 32px;
                                        border-radius: 5px;
                                        background: DesignTokens.accent;
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            IconDisplay { icon: IconSet.Maximize2; size: 14px; stroke: DesignTokens.canvas; }
                                            Text { text: root.label-unwrap-mesh; color: DesignTokens.canvas; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                        }
                                        TouchArea { clicked => { root.command-executed("uv.unwrap"); } }
                                    }

                                    Rectangle {
                                        height: 32px;
                                        border-radius: 5px;
                                        background: DesignTokens.surface-raised;
                                        border-width: 1px;
                                        border-color: DesignTokens.border;
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            IconDisplay { icon: IconSet.Grid2x2; size: 14px; stroke: DesignTokens.text-primary; }
                                            Text { text: root.label-pack-islands; color: DesignTokens.text-primary; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                                        }
                                        TouchArea { clicked => { root.command-executed("uv.pack_islands"); } }
                                    }
                                }
                            }

                            InspectorSection {
                                title: "UV Editor";
                                open: true;
                                toggled => { self.open = !self.open; }

                                VerticalLayout {
                                    spacing: 6px;
                                    padding-top: 4px;

                                    // Caixa 0..1 com o layout real das UVs.
                                    uv-box := Rectangle {
                                        height: 256px;
                                        background: DesignTokens.canvas;
                                        border-width: 1px;
                                        border-color: DesignTokens.border;

                                        Path {
                                            fill: transparent;
                                            stroke: DesignTokens.accent;
                                            stroke-width: 1px;
                                            commands: root.uv-layout-commands;
                                        }

                                        TouchArea {
                                            property <bool> extend: false;
                                            pointer-event(event) => {
                                                extend = event.modifiers.shift;
                                                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                                    // O domínio usa UV com origem embaixo; a caixa desenha
                                                    // com origem em cima, então o V é invertido aqui.
                                                    root.uv-editor-clicked(
                                                        self.mouse-x / self.width,
                                                        1.0 - self.mouse-y / self.height,
                                                        extend,
                                                    );
                                                }
                                            }
                                        }

                                        // Contorno do espaço 0..1.
                                        Rectangle { x: 0; y: 0; width: 100%; height: 1px; background: DesignTokens.border; }
                                        Rectangle { x: 0; y: parent.height - 1px; width: 100%; height: 1px; background: DesignTokens.border; }
                                        Rectangle { x: 0; y: 0; width: 1px; height: 100%; background: DesignTokens.border; }
                                        Rectangle { x: parent.width - 1px; y: 0; width: 1px; height: 100%; background: DesignTokens.border; }
                                    }

                                    Text {
                                        text: "\{root.uv-island-count} island(s)  ·  \{root.uv-face-count} face(s)  ·  selected: \{root.uv-selected-face}  ·  UV set: \{root.uv-selected-count}";
                                        color: DesignTokens.text-secondary;
                                        font-size: 10px;
                                    }

                                    HorizontalLayout {
                                        spacing: 4px;
                                        height: 26px;

                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            Text { text: "← U"; color: DesignTokens.text-primary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                            accessible-role: button;
                                            accessible-label: "Move UV left";
                                            TouchArea { clicked => { root.uv-moved(-0.05, 0.0); } }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            Text { text: "U →"; color: DesignTokens.text-primary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                            accessible-role: button;
                                            accessible-label: "Move UV right";
                                            TouchArea { clicked => { root.uv-moved(0.05, 0.0); } }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            Text { text: "↓ V"; color: DesignTokens.text-primary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                            accessible-role: button;
                                            accessible-label: "Move UV down";
                                            TouchArea { clicked => { root.uv-moved(0.0, -0.05); } }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            Text { text: "V ↑"; color: DesignTokens.text-primary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                            accessible-role: button;
                                            accessible-label: "Move UV up";
                                            TouchArea { clicked => { root.uv-moved(0.0, 0.05); } }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 4px;
                                        height: 26px;

                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            Text { text: "Scale −"; color: DesignTokens.text-primary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                            accessible-role: button;
                                            accessible-label: "Scale UV down";
                                            TouchArea { clicked => { root.uv-scaled(0.9); } }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            Text { text: "Scale +"; color: DesignTokens.text-primary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                            accessible-role: button;
                                            accessible-label: "Scale UV up";
                                            TouchArea { clicked => { root.uv-scaled(1.1); } }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            Text { text: "Rotate −"; color: DesignTokens.text-primary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                            accessible-role: button;
                                            accessible-label: "Rotate UV counter-clockwise";
                                            TouchArea { clicked => { root.uv-rotated(-15.0); } }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            Text { text: "Rotate +"; color: DesignTokens.text-primary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                            accessible-role: button;
                                            accessible-label: "Rotate UV clockwise";
                                            TouchArea { clicked => { root.uv-rotated(15.0); } }
                                        }
                                    }
                                    if root.uv-layout-truncated: Text {
                                        text: "Layout truncated: only the first 2000 faces are drawn.";
                                        color: DesignTokens.text-muted;
                                        font-size: 10px;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        height: 28px;

                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            Text { text: "Mark/Unmark Seams"; color: DesignTokens.text-primary; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                            accessible-role: button;
                                            accessible-label: "Toggle seams on the selected face";
                                            TouchArea { clicked => { root.uv-seam-toggled(); } }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            Text { text: "Clear Seams"; color: DesignTokens.danger; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                            accessible-role: button;
                                            accessible-label: "Clear all seams";
                                            TouchArea { clicked => { root.uv-seams-cleared(); } }
                                        }
                                    }
                                }
                            }

                            InspectorSection {
                                title: "UV Statistics";
                                open: true;
                                toggled => { self.open = !self.open; }

                                Text {
                                    text: root.uv-stats;
                                    color: DesignTokens.text-secondary;
                                    font-size: 11px;
                                }
                            }
                        }

                        }
                        }
                    }
                }
            }

            Rectangle {
                height: 32px;
                background: DesignTokens.surface;
                border-width: 1px;
                border-color: DesignTokens.border;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 14px;
                    alignment: center;

                    Text { text: root.status-message; color: DesignTokens.text-primary; font-size: 11px; font-weight: 600; vertical-alignment: center; overflow: elide; max-width: 300px; }
                    Text { text: root.label-status-hint; color: DesignTokens.text-muted; font-size: 11px; vertical-alignment: center; overflow: elide; max-width: 180px; }

                    Rectangle { horizontal-stretch: 1; }

                    Rectangle {
                        height: 28px;
                        border-radius: 4px;
                        background: scene-drawer-visible ? DesignTokens.accent : DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: parts-footer-focus.has-focus ? DesignTokens.focus-ring : DesignTokens.border;
                        accessible-role: button;
                        accessible-label: root.label-parts;
                        accessible-expanded: scene-drawer-visible;
                        forward-focus: parts-footer-focus;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 5px;
                            alignment: center;
                            IconDisplay { icon: IconSet.Layers3; size: 12px; stroke: scene-drawer-visible ? DesignTokens.canvas : DesignTokens.text-primary; }
                            Text { text: root.label-parts; color: scene-drawer-visible ? DesignTokens.canvas : DesignTokens.text-primary; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                        }
                        parts-footer-focus := FocusScope {
                            key-pressed(event) => {
                                if event.text == Key.Return || event.text == " " {
                                    root.scene-requested();
                                    return accept;
                                }
                                reject
                            }
                            TouchArea { clicked => { parts-footer-focus.focus(); root.scene-requested(); } }
                        }
                    }

                    Rectangle {
                        height: 28px;
                        border-radius: 4px;
                        background: asset-library-visible ? DesignTokens.accent : DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: assets-footer-focus.has-focus ? DesignTokens.focus-ring : DesignTokens.border;
                        accessible-role: button;
                        accessible-label: root.label-asset-library;
                        accessible-expanded: asset-library-visible;
                        forward-focus: assets-footer-focus;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 5px;
                            alignment: center;
                            IconDisplay {
                                icon: IconSet.FolderArchive;
                                size: 12px;
                                stroke: asset-library-visible ? DesignTokens.canvas : DesignTokens.text-primary;
                            }
                            Text {
                                text: root.label-asset-library;
                                color: asset-library-visible ? DesignTokens.canvas : DesignTokens.text-primary;
                                font-size: 10px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                        assets-footer-focus := FocusScope {
                            key-pressed(event) => {
                                if event.text == Key.Return || event.text == " " {
                                    root.asset-library-requested();
                                    return accept;
                                }
                                reject
                            }
                            TouchArea { clicked => { assets-footer-focus.focus(); root.asset-library-requested(); } }
                        }
                    }

                    Rectangle { width: 1px; height: 16px; background: DesignTokens.border; }
                    Text { text: root.scene-stats; color: DesignTokens.text-muted; font-size: 11px; vertical-alignment: center; }
                }
            }
        }

        // Overlay: Scene Drawer
        if scene-drawer-visible && compact-shell: Rectangle {
            x: parent.width - self.width - 8px;
            y: 42px;
            width: 250px;
            height: parent.height - 72px;
            background: DesignTokens.surface-raised;
            border-width: 1px;
            border-color: DesignTokens.border;
            border-radius: 6px;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    Text {
                        text: root.label-parts;
                        color: DesignTokens.text-primary;
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    TopAction {
                        icon: IconSet.Pin;
                        semantic-label: scene-drawer-pinned ? "Unpin Parts" : "Pin Parts";
                        clicked => {
                            root.scene-drawer-pinned = !root.scene-drawer-pinned;
                            root.scene-pin-requested(root.scene-drawer-pinned);
                        }
                    }
                    TopAction {
                        icon: IconSet.X;
                        semantic-label: "Close scene drawer";
                        clicked => { root.scene-requested(); }
                    }
                }

                Rectangle { height: 1px; background: DesignTokens.border; }

                PartsFilterRow {
                    horizontal-stretch: 1;
                    search-label: root.label-search-parts;
                    search-id: "compact-parts-search";
                    selected-only-label: root.label-selected-parts-only;
                    sort-label: root.label-sort-parts;
                    query <=> root.parts-query;
                    selected-only <=> root.parts-selected-only;
                    sort-by-name <=> root.parts-sort-by-name;
                    visible-count: root.parts-items.length;
                    total-count: root.scene-items.length;
                    query-changed(query) => { root.parts-query-changed(query); }
                    selected-only-changed(enabled) => { root.parts-selected-only-changed(enabled); }
                    sort-changed(enabled) => { root.parts-sort-changed(enabled); }
                }
                PartsRowSizeControl {
                    horizontal-stretch: 1;
                    semantic-label: root.label-parts-row-size;
                    accessibility-id: "compact-parts-row-height";
                    value <=> root.parts-row-height;
                    value-changed(value) => { root.parts-row-height-changed(value); }
                }

                ScrollView {
                    accessible-role: list;
                    accessible-label: root.label-parts;
                    accessible-item-count: root.parts-items.length;
                    VerticalLayout {
                        spacing: 4px;
                        alignment: start;

                        for item in root.parts-items: Rectangle {
                            height: root.parts-row-height * 1px;
                            accessible-role: list-item;
                            accessible-label: item.name;
                            accessible-item-selectable: true;
                            accessible-item-selected: item.selected;
                            border-radius: 4px;
                            background: item.selected ? DesignTokens.surface-hover : transparent;
                            border-width: item.selected ? 1px : 0px;
                            // Ativo (amarelo) ≠ selecionado (laranja): a
                            // referência das operações sempre identificável.
                            border-color: item.active ? DesignTokens.selection-active : DesignTokens.selection;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 6px;
                                alignment: center;

                                TouchArea {
                                    property <bool> extend: false;
                                    pointer-event(event) => {
                                        self.extend = event.modifiers.shift;
                                        if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                                            root.scene-context-requested(
                                                item.id,
                                                (self.absolute-position.x + self.mouse-x) / 1px,
                                                (self.absolute-position.y + self.mouse-y) / 1px,
                                            );
                                        }
                                    }
                                    clicked => { root.scene-select(item.id, self.extend); }
                                    horizontal-stretch: 1;

                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: center;

                                        IconDisplay {
                                            icon: IconSet.Box;
                                            size: 12px;
                                            stroke: item.selected ? DesignTokens.accent : DesignTokens.text-muted;
                                        }

                                        if root.rename-active && item.selected: TextInput {
                                            text: root.rename-value;
                                            horizontal-stretch: 1;
                                            font-size: 12px;
                                            color: DesignTokens.text-primary;
                                            single-line: true;
                                            init => { self.focus(); }
                                            edited => { root.rename-edited(self.text); }
                                            accepted => { root.rename-committed(self.text); }
                                        }

                                        if !(root.rename-active && item.selected): Text {
                                            text: item.name;
                                            color: item.selected ? DesignTokens.text-primary : DesignTokens.text-secondary;
                                            font-size: 12px;
                                            font-weight: item.selected ? 600 : 400;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: "\{item.tris}t";
                                            color: DesignTokens.text-muted;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    IconDisplay {
                                        icon: item.visible ? IconSet.Eye : IconSet.EyeOff;
                                        size: 13px;
                                        stroke: item.visible ? DesignTokens.text-secondary : DesignTokens.text-muted;
                                    }
                                    TouchArea {
                                        clicked => { root.scene-toggle-visibility(item.id); }
                                    }
                                }

                                Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    IconDisplay {
                                        icon: item.locked ? IconSet.Lock : IconSet.LockOpen;
                                        size: 13px;
                                        stroke: item.locked ? DesignTokens.accent : DesignTokens.text-muted;
                                    }
                                    TouchArea {
                                        clicked => { root.scene-toggle-lock(item.id); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Painel flutuante de Tool Properties (P3D-083): as configurações da
        // ferramenta ativa ficam fora do Object Inspector, ancoradas na viewport.
        if tool-modal-active || loop-cut-active || loop-cut-armed || profile-active: Rectangle {
            x: parent.width - self.width - 16px;
            y: parent.height - self.height - 16px;
            width: 236px;
            height: root.tool-properties-collapsed ? 40px : tool-properties-layout.preferred-height + 34px;
            border-radius: 8px;
            background: DesignTokens.surface-raised;
            border-width: 1px;
            border-color: DesignTokens.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000080;
            drop-shadow-offset-y: 4px;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                HorizontalLayout {
                    height: 20px;
                    Text {
                        text: tool-modal-active ? tool-modal-title : (profile-active ? root.label-model-profile : root.label-model-loop-cut);
                        color: DesignTokens.text-primary;
                        font-size: 12px;
                        font-weight: 700;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        accessible-role: button;
                        accessible-label: root.tool-properties-collapsed ? "Expand tool properties" : "Collapse tool properties";
                        IconDisplay {
                            icon: root.tool-properties-collapsed ? IconSet.ChevronDown : IconSet.ChevronUp;
                            size: 13px;
                            stroke: DesignTokens.text-secondary;
                        }
                        TouchArea { clicked => { root.tool-properties-collapsed = !root.tool-properties-collapsed; } }
                    }
                }

                tool-properties-layout := VerticalLayout {
                    visible: !root.tool-properties-collapsed;
                    spacing: 6px;

                if tool-modal-active: HorizontalLayout {
                    spacing: 6px;
                    height: 28px;

                    Text {
                        text: root.tool-modal-label;
                        color: DesignTokens.text-secondary;
                        font-size: 11px;
                        width: 72px;
                        vertical-alignment: center;
                    }
                    NumericField {
                        label: "";
                        value: root.tool-modal-value;
                        horizontal-stretch: 1;
                        step: root.tool-modal-step;
                        scrubbed(delta, fine) => { root.tool-modal-text-committed("\{root.tool-modal-value + delta * root.tool-modal-step * (fine ? 0.1 : 1)}"); }
                        scrub-cancelled(value) => { root.tool-modal-text-committed("\{value}"); }
                        text-committed(text) => { root.tool-modal-text-committed(text) }
                    }
                }

                if tool-modal-active: HorizontalLayout {
                    spacing: 6px;
                    height: 28px;

                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 4px;
                        background: DesignTokens.surface;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        Text { text: root.label-cancel; color: DesignTokens.text-primary; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.tool-modal-cancel(); } }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 4px;
                        background: DesignTokens.accent;
                        Text { text: root.label-apply; color: DesignTokens.canvas; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.tool-modal-apply(); } }
                    }
                }

                if loop-cut-active: HorizontalLayout {
                    spacing: 6px;
                    height: 28px;

                    Text {
                        text: "Slide";
                        color: DesignTokens.text-secondary;
                        font-size: 11px;
                        width: 72px;
                        vertical-alignment: center;
                    }
                    NumericField {
                        label: "";
                        value: root.loop-cut-slide;
                        horizontal-stretch: 1;
                        step: 0.01;
                        scrubbed(delta, fine) => { root.loop-cut-slide-committed("\{root.loop-cut-slide + delta * (fine ? 0.001 : 0.01)}"); }
                        scrub-cancelled(value) => { root.loop-cut-slide-committed("\{value}"); }
                        text-committed(text) => { root.loop-cut-slide-committed(text) }
                    }
                }

                if loop-cut-armed: HorizontalLayout {
                    spacing: 6px;
                    height: 28px;
                    Text { text: "Cuts"; color: DesignTokens.text-secondary; font-size: 11px; width: 72px; vertical-alignment: center; }
                    Text { text: "\{root.loop-cut-cuts}"; color: DesignTokens.text-primary; font-size: 12px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                    Text { text: root.hint-model-loop-cut; color: DesignTokens.text-muted; font-size: 9px; wrap: word-wrap; }
                }

                if loop-cut-active: HorizontalLayout {
                    spacing: 6px;
                    height: 28px;

                    Text {
                        text: "Cuts";
                        color: DesignTokens.text-secondary;
                        font-size: 11px;
                        width: 72px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 4px;
                        background: DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        Text {
                            text: "\{root.loop-cut-cuts}";
                            color: DesignTokens.text-primary;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 4px;
                        background: DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        Text { text: "-"; color: DesignTokens.text-primary; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.loop-cut-count-committed("\{root.loop-cut-cuts - 1}"); } }
                    }
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 4px;
                        background: DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        Text { text: "+"; color: DesignTokens.text-primary; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.loop-cut-count-committed("\{root.loop-cut-cuts + 1}"); } }
                    }
                }

                if profile-active: VerticalLayout {
                    spacing: 6px;
                    Text { text: "\{root.label-profile-points}: \{root.profile-point-count}"; color: DesignTokens.text-secondary; font-size: 10px; }
                    if !root.profile-closed: Rectangle {
                        height: 26px; border-radius: 4px; background: DesignTokens.surface;
                        Text { text: root.label-profile-close; color: DesignTokens.text-primary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.profile-close(); } }
                    }
                    if root.profile-closed: HorizontalLayout {
                        spacing: 5px; height: 28px;
                        Text { text: root.label-profile-depth; color: DesignTokens.text-secondary; font-size: 10px; width: 72px; vertical-alignment: center; }
                        NumericField {
                            label: ""; value: root.profile-depth; horizontal-stretch: 1; step: 0.1;
                            text-committed(text) => { root.profile-depth-set(text); }
                            scrubbed(delta, fine) => { root.profile-depth-set("\{root.profile-depth + delta * (fine ? 0.01 : 0.1)}"); }
                        }
                    }
                    if root.profile-closed: HorizontalLayout {
                        spacing: 5px; height: 28px;
                        Rectangle { horizontal-stretch: 1; border-radius: 4px; background: DesignTokens.surface; Text { text: root.label-profile-revolve; color: DesignTokens.text-primary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.profile-revolve(); } } }
                        Rectangle { horizontal-stretch: 1; border-radius: 4px; background: DesignTokens.accent; Text { text: root.label-profile-generate; color: DesignTokens.canvas; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.profile-generate(); } } }
                    }
                    Text { text: root.hint-model-profile; color: DesignTokens.text-muted; font-size: 9px; wrap: word-wrap; }
                }

                if loop-cut-active: HorizontalLayout {
                    spacing: 6px;
                    height: 28px;

                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 4px;
                        background: DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        Text { text: root.label-cancel; color: DesignTokens.text-primary; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.loop-cut-cancel(); } }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 4px;
                        background: DesignTokens.accent;
                        Text { text: root.label-apply; color: DesignTokens.canvas; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.loop-cut-apply(); } }
                    }
                }
                }
            }
        }

        // Overlay: recuperação de autosave (P3D-002 §Recuperação segura).
        if recovery-open: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: DesignTokens.scrim;

            Rectangle {
                width: 460px;
                height: recovery-layout.preferred-height;
                x: (parent.width - self.width) / 2;
                y: 96px;
                border-radius: 8px;
                background: DesignTokens.surface-raised;
                border-width: 1px;
                border-color: DesignTokens.border;

                recovery-layout := VerticalLayout {
                    padding: 18px;
                    spacing: 10px;

                    Text {
                        text: root.recovery-title;
                        color: DesignTokens.text-primary;
                        font-size: 14px;
                        font-weight: 700;
                    }
                    Text {
                        text: root.recovery-body;
                        color: DesignTokens.text-secondary;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.recovery-detail;
                        color: DesignTokens.text-muted;
                        font-size: 10px;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        height: 30px;

                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 4px;
                            background: DesignTokens.surface;
                            border-width: 1px;
                            border-color: DesignTokens.border;
                            Text { text: root.recovery-discard; color: DesignTokens.danger; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.recovery-discard-requested(); } }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 4px;
                            background: DesignTokens.surface;
                            border-width: 1px;
                            border-color: DesignTokens.border;
                            Text { text: root.recovery-keep; color: DesignTokens.text-primary; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.recovery-keep-requested(); } }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 4px;
                            background: DesignTokens.accent;
                            Text { text: root.recovery-recover; color: DesignTokens.canvas; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.recovery-recover-requested(); } }
                        }
                    }
                }
            }
        }

        // Overlay: dropdown de um menu da barra superior.
        if root.menu-open != "": Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;

            TouchArea {
                clicked => { root.click-away-requested(); }
            }

            MenuDropdown {
                x: min(max(8px, root.menu-anchor-x), max(8px, parent.width - self.width - 8px));
                y: 44px;
                entries: root.menu-open == "file"
                    ? root.menu-file-items
                    : (root.menu-open == "edit"
                        ? root.menu-edit-items
                        : (root.menu-open == "view" ? root.menu-view-items : root.menu-window-items));
                invoked(id) => { root.menu-item-invoked(id); }
            }
        }

        // Mini HUD da operação: o que está acontecendo, com que valor, e como
        // confirmar. Fica acima da status bar e nunca no centro da geometria.
        if operation-hud-active: Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - 48px;
            width: max(operation-hud-content.preferred-width + 24px, 220px);
            height: operation-hud-content.preferred-height + 20px;
            border-radius: 8px;
            background: DesignTokens.surface-raised;
            border-width: 1px;
            border-color: DesignTokens.accent;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000080;
            drop-shadow-offset-y: 3px;

            operation-hud-content := VerticalLayout {
                padding: 10px;
                spacing: 4px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    Text {
                        text: root.operation-hud-title;
                        color: DesignTokens.accent;
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.operation-hud-subject;
                        color: DesignTokens.text-muted;
                        font-size: 10px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }

                for line in root.operation-hud-lines: Text {
                    text: line;
                    color: DesignTokens.text-primary;
                    font-size: 12px;
                    font-weight: 600;
                    font-family: "monospace";
                }

                Text {
                    text: root.operation-hud-hint;
                    color: DesignTokens.text-muted;
                    font-size: 9px;
                }
            }
        }

        // Popover de shading: só opções com backend real.
        if shading-popover-open: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;

            TouchArea {
                clicked => { root.shading-popover-toggled(false); }
            }

            Rectangle {
                x: min(max(8px, (parent.width - self.width) / 2), parent.width - self.width - 8px);
                y: 54px;
                width: 280px;
                height: shading-options.preferred-height + 24px;
                border-radius: 8px;
                background: DesignTokens.surface-raised;
                border-width: 1px;
                border-color: DesignTokens.border;
                drop-shadow-blur: 14px;
                drop-shadow-color: #00000090;
                drop-shadow-offset-y: 4px;

                // O scrim só fecha ao clicar fora. Capturar o fundo do painel
                // evita que o clique no slider atravesse para a viewport.
                TouchArea { clicked => {} }

                shading-options := VerticalLayout {
                    width: parent.width;
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: "Shading";
                        color: DesignTokens.text-primary;
                        font-size: 12px;
                        font-weight: 700;
                    }
                    Text {
                        text: "Mode: \{root.shading-mode}";
                        color: DesignTokens.text-muted;
                        font-size: 10px;
                    }

                    Rectangle { height: 1px; background: DesignTokens.border; }

                    Text {
                        text: "X-Ray";
                        color: DesignTokens.text-primary;
                        font-size: 11px;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        height: 24px;
                        alignment: center;
                        Text {
                            text: "Opacity";
                            color: DesignTokens.text-secondary;
                            font-size: 10px;
                            width: 56px;
                            vertical-alignment: center;
                        }
                        Slider {
                            horizontal-stretch: 1;
                            min-width: 110px;
                            minimum: 0.1;
                            maximum: 0.9;
                            value: root.xray-opacity;
                            accessible-label: root.label-xray-opacity;
                            changed(value) => { root.xray-opacity-set(value); }
                        }
                        Text {
                            text: "\{round(root.xray-opacity * 100)}%";
                            color: DesignTokens.text-muted;
                            font-size: 10px;
                            width: 36px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: root.show-xray ? DesignTokens.accent : DesignTokens.surface;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        accessible-role: checkbox;
                        accessible-label: "X-Ray enabled";
                        accessible-checked: root.show-xray;
                        Text {
                            text: root.show-xray ? "X-Ray on" : "X-Ray off";
                            color: root.show-xray ? DesignTokens.canvas : DesignTokens.text-primary;
                            font-size: 11px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.toggle-xray-requested(); } }
                    }

                    Rectangle { height: 1px; background: DesignTokens.border; }

                    Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: root.is-wireframe ? DesignTokens.accent : DesignTokens.surface;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        accessible-role: checkbox;
                        accessible-label: root.label-wire-overlay;
                        accessible-checked: root.is-wireframe;
                        Tooltip {
                            VerticalLayout {
                                padding: 8px;
                                spacing: 2px;
                                Text { text: root.label-wire-overlay; color: DesignTokens.text-primary; font-size: 11px; font-weight: 700; }
                                Text { text: root.label-wire-overlay-hint; color: DesignTokens.text-secondary; font-size: 10px; }
                            }
                        }
                        Text {
                            text: root.label-wire-overlay;
                            color: root.is-wireframe ? DesignTokens.canvas : DesignTokens.text-primary;
                            font-size: 11px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.toggle-wireframe-requested(); } }
                    }
                }
            }
        }

        // Overlay: menu de contexto do Outliner (botão direito numa linha).
        if context-menu-open: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;

            TouchArea {
                clicked => { root.click-away-requested(); }
            }

            context-menu-panel := Rectangle {
                x: min(root.context-menu-x, max(0px, parent.width - self.width - 8px));
                y: min(root.context-menu-y, max(0px, parent.height - self.height - 8px));
                width: 208px;
                height: context-menu-layout.preferred-height;
                background: DesignTokens.surface-raised;
                border-width: 1px;
                border-color: DesignTokens.border;
                border-radius: 6px;
                drop-shadow-blur: 12px;
                drop-shadow-color: #00000080;
                drop-shadow-offset-y: 4px;

                context-menu-layout := VerticalLayout {
                    padding: 4px;
                    spacing: 1px;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 4px;
                        padding-bottom: 4px;

                        Text {
                            text: root.context-menu-title;
                            color: DesignTokens.text-muted;
                            font-size: 10px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }

                    if root.context-menu-mode != "viewport": ContextMenuItem {
                        label: "Rename";
                        shortcut: "F2";
                        clicked => { root.context-menu-action("rename"); }
                    }
                    if root.context-menu-mode != "viewport": ContextMenuItem {
                        label: "Duplicate";
                        shortcut: "Shift+D";
                        clicked => { root.context-menu-action("duplicate"); }
                    }
                    if root.context-menu-mode != "viewport": ContextMenuItem {
                        label: root.context-menu-visible ? "Hide" : "Show";
                        shortcut: "";
                        clicked => { root.context-menu-action("visibility"); }
                    }
                    if root.context-menu-mode != "viewport": ContextMenuItem {
                        label: root.context-menu-locked ? "Unlock" : "Lock";
                        shortcut: "";
                        clicked => { root.context-menu-action("lock"); }
                    }
                    if root.context-menu-mode == "viewport": ContextMenuItem {
                        label: "Select All";
                        shortcut: "A";
                        clicked => { root.context-menu-action("select_all"); }
                    }
                    if root.context-menu-mode == "viewport": ContextMenuItem {
                        label: "Clear Selection";
                        shortcut: "Alt+A";
                        clicked => { root.context-menu-action("clear_selection"); }
                    }
                    if root.context-menu-mode == "viewport": ContextMenuItem {
                        label: "Invert Selection";
                        shortcut: "Ctrl+I";
                        clicked => { root.context-menu-action("invert_selection"); }
                    }
                    ContextMenuItem {
                        label: "Frame Selection";
                        shortcut: "F";
                        clicked => { root.context-menu-action("frame"); }
                    }
                    ContextMenuItem {
                        label: "Set as Boolean Operand";
                        shortcut: "";
                        clicked => { root.context-menu-action("boolean_operand"); }
                    }

                    Rectangle { height: 1px; background: DesignTokens.border; }

                    ContextMenuItem {
                        label: "Delete";
                        shortcut: "Del";
                        danger: true;
                        clicked => { root.context-menu-action("delete"); }
                    }
                }
            }
        }

        // Divisor da Asset Library: arrasta na vertical e devolve a altura.
        if asset-library-visible: SplitterHorizontal {
            x: 8px;
            y: parent.height - 36px - asset-library-height;
            width: parent.width - 16px - (inspector-visible && !compact-shell ? inspector-width + 8px : 0px);
            value: root.asset-library-height;
            direction: -1.0;
            moved(height) => { root.asset-library-height-changed(height / 1px); }
        }

        // Overlay / Bottom Drawer: Asset Library (AGENTS.md §3: Asset Library-abaixo)
        if asset-library-visible: Rectangle {
            x: 8px;
            y: parent.height - 30px - asset-library-height;
            width: parent.width - 16px - (inspector-visible && !compact-shell ? inspector-width + 8px : 0px);
            height: asset-library-height;
            background: DesignTokens.surface-raised;
            border-width: 1px;
            border-color: DesignTokens.border;
            border-radius: 6px;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;

                    IconDisplay {
                        icon: IconSet.FolderArchive;
                        size: 16px;
                        stroke: DesignTokens.accent;
                    }

                    Text {
                        text: root.label-project-asset-library;
                        color: DesignTokens.text-primary;
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "(\{root.asset-items.length}/\{root.scene-items.length})";
                        color: DesignTokens.text-muted;
                        font-size: 11px;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Rectangle {
                        height: 24px;
                        border-radius: 4px;
                        background: DesignTokens.surface;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            alignment: center;
                            IconDisplay { icon: IconSet.BookmarkPlus; size: 12px; stroke: DesignTokens.text-primary; }
                            Text { text: root.label-save-active-as-asset; color: DesignTokens.text-primary; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                        }
                        TouchArea { clicked => { root.save-active-as-asset-requested(); } }
                    }

                    TopAction {
                        icon: IconSet.X;
                        semantic-label: "Close asset library";
                        clicked => { root.asset-library-requested(); }
                    }
                }

                Rectangle { height: 1px; background: DesignTokens.border; }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    Rectangle {
                        height: 26px;
                        horizontal-stretch: 1;
                        border-radius: 4px;
                        background: DesignTokens.surface;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        accessible-role: search;
                        accessible-label: root.label-search-assets;
                        HorizontalLayout {
                            padding-left: 7px;
                            padding-right: 7px;
                            spacing: 5px;
                            alignment: center;
                            IconDisplay { icon: IconSet.Search; size: 13px; stroke: DesignTokens.text-muted; }
                            TextInput {
                                text: root.asset-query;
                                color: DesignTokens.text-primary;
                                font-size: 11px;
                                single-line: true;
                                horizontal-stretch: 1;
                                accessible-label: root.label-search-assets;
                                edited => { root.asset-query-changed(self.text); }
                            }
                        }
                    }
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 4px;
                        background: root.asset-sort-by-name ? DesignTokens.accent : DesignTokens.surface;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        accessible-role: button;
                        accessible-label: root.label-sort-assets;
                        accessible-checked: root.asset-sort-by-name;
                        IconDisplay { icon: IconSet.ArrowDownAz; size: 14px; stroke: root.asset-sort-by-name ? DesignTokens.canvas : DesignTokens.text-primary; }
                        TouchArea { clicked => { root.asset-sort-changed(!root.asset-sort-by-name); } }
                    }
                    Text { text: root.label-thumbnail-size; color: DesignTokens.text-secondary; font-size: 10px; vertical-alignment: center; }
                    Slider {
                        width: 100px;
                        minimum: 48;
                        maximum: 128;
                        value: root.asset-thumbnail-size;
                        changed(value) => { root.asset-thumbnail-size-changed(value); }
                    }
                    Text { text: "\{round(root.asset-thumbnail-size)}"; color: DesignTokens.text-muted; font-size: 10px; width: 24px; horizontal-alignment: right; vertical-alignment: center; }
                }

                ScrollView {
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        for item in root.asset-items: Rectangle {
                            width: root.asset-thumbnail-size * 1px + 96px;
                            height: root.asset-thumbnail-size * 1px + 56px;
                            border-radius: 6px;
                            background: item.selected ? DesignTokens.surface-hover : DesignTokens.surface;
                            border-width: item.selected ? 2px : 1px;
                            border-color: item.selected ? DesignTokens.accent : DesignTokens.border;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 6px;

                                HorizontalLayout {
                                    alignment: center;
                                    IconDisplay { icon: IconSet.Box; size: 14px; stroke: item.selected ? DesignTokens.accent : DesignTokens.text-secondary; }
                                    Rectangle { width: 4px; }
                                    Text {
                                        text: item.name;
                                        color: DesignTokens.text-primary;
                                        font-size: 12px;
                                        font-weight: item.selected ? 700 : 500;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                }

                                Text {
                                    text: "\{item.tris} tris  ·  \{item.verts} verts";
                                    color: DesignTokens.text-muted;
                                    font-size: 10px;
                                }

                                Rectangle { vertical-stretch: 1; }

                                HorizontalLayout {
                                    spacing: 4px;

                                    Rectangle {
                                        height: 22px;
                                        horizontal-stretch: 1;
                                        border-radius: 3px;
                                        background: item.selected ? DesignTokens.accent : DesignTokens.surface-raised;
                                        Text {
                                            text: item.selected ? "Active" : "Select";
                                            color: item.selected ? DesignTokens.canvas : DesignTokens.text-primary;
                                            font-size: 10px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        TouchArea { clicked => { root.scene-select(item.id, false); } }
                                    }

                                    Rectangle {
                                        width: 22px;
                                        height: 22px;
                                        border-radius: 3px;
                                        background: DesignTokens.surface-raised;
                                        IconDisplay { icon: IconSet.Copy; size: 12px; stroke: DesignTokens.text-secondary; }
                                        TouchArea {
                                            clicked => {
                                                root.scene-select(item.id, false);
                                                root.duplicate-requested();
                                            }
                                        }
                                    }

                                    // Coloca uma cópia do asset no cursor 3D (P3D-093).
                                    Rectangle {
                                        width: 22px;
                                        height: 22px;
                                        border-radius: 3px;
                                        background: DesignTokens.surface-raised;
                                        accessible-role: button;
                                        accessible-label: root.label-place-in-scene;
                                        IconDisplay { icon: IconSet.Plus; size: 12px; stroke: DesignTokens.text-secondary; }
                                        TouchArea {
                                            clicked => { root.place-asset-requested(item.id); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Overlay: Command Search Modal
        if command-search-visible: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: DesignTokens.scrim;

            TouchArea {
                clicked => { root.click-away-requested(); }
            }

            Rectangle {
                width: 480px;
                height: 320px;
                x: (parent.width - self.width) / 2;
                y: 80px;
                border-radius: 8px;
                background: DesignTokens.surface-raised;
                border-width: 1px;
                border-color: DesignTokens.border;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    HorizontalLayout {
                        height: 36px;
                        spacing: 8px;
                        alignment: center;

                        IconDisplay {
                            icon: IconSet.Search;
                            size: 16px;
                            stroke: DesignTokens.text-secondary;
                        }

                        search-input := TextInput {
                            accessible-role: text-input;
                            accessible-label: "Search commands";
                            font-size: 14px;
                            color: DesignTokens.text-primary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            text <=> root.command-query;
                            edited => { root.command-query-changed(self.text); }
                            key-pressed(event) => {
                                if event.text == Key.DownArrow && root.command-results.length > 0 {
                                    root.command-selection = Math.min(root.command-selection + 1, root.command-results.length - 1);
                                    return accept;
                                }
                                if event.text == Key.UpArrow && root.command-results.length > 0 {
                                    root.command-selection = Math.max(root.command-selection - 1, 0);
                                    return accept;
                                }
                                reject
                            }
                            accepted => {
                                if root.command-results.length > 0 {
                                    if !root.command-results[root.command-selection].available {
                                    } else if root.command-results[root.command-selection].id == "file.save" || root.command-results[root.command-selection].id == "file.save_as" || root.command-results[root.command-selection].id == "file.open" {
                                        root.command-file-action(root.command-results[root.command-selection].id);
                                    } else {
                                        root.command-executed(root.command-results[root.command-selection].id);
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: DesignTokens.border;
                    }

                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 2px;
                            for cmd[index] in root.command-results: Rectangle {
                                height: 32px;
                                border-radius: 4px;
                                background: index == root.command-selection || item-touch.has-hover ? DesignTokens.surface-hover : transparent;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: center;

                                    Text {
                                        text: cmd.label;
                                        color: DesignTokens.text-primary;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }

                                    Rectangle { horizontal-stretch: 1; }

                                    if cmd.shortcut != "": Text {
                                        text: cmd.shortcut;
                                        color: DesignTokens.text-muted;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }
                                }

                                item-touch := TouchArea {
                                    clicked => {
                                        root.command-selection = index;
                                        if !cmd.available {
                                        } else if cmd.id == "file.save" || cmd.id == "file.save_as" || cmd.id == "file.open" {
                                            root.command-file-action(cmd.id);
                                        } else {
                                            root.command-executed(cmd.id);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Overlay: Settings Modal
        if settings-visible: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: DesignTokens.scrim;

            TouchArea {
                clicked => { root.click-away-requested(); }
            }

            Rectangle {
                width: 440px;
                height: 496px;
                x: (parent.width - self.width) / 2;
                y: 100px;
                border-radius: 8px;
                background: DesignTokens.surface-raised;
                border-width: 1px;
                border-color: DesignTokens.border;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    HorizontalLayout {
                        Text {
                            text: root.label-preferences;
                            color: DesignTokens.text-primary;
                            font-size: 14px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        TopAction {
                            icon: IconSet.X;
                            semantic-label: "Close settings";
                            clicked => { root.click-away-requested(); }
                        }
                    }

                    Rectangle { height: 1px; background: DesignTokens.border; }

                    Text {
                        text: root.label-theme;
                        color: DesignTokens.text-primary;
                        font-size: 12px;
                        font-weight: 600;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        for theme in root.themes: Rectangle {
                            width: 140px;
                            height: 28px;
                            border-radius: 4px;
                            background: theme.active ? DesignTokens.accent : DesignTokens.surface;
                            border-width: 1px;
                            border-color: DesignTokens.border;

                            Text {
                                text: theme.name;
                                color: theme.active ? DesignTokens.canvas : DesignTokens.text-primary;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                overflow: elide;
                            }
                            TouchArea {
                                clicked => { root.theme-changed(theme.id); }
                            }
                        }
                    }

                    Text {
                        text: "Tool confirmation";
                        color: DesignTokens.text-primary;
                        font-size: 12px;
                        font-weight: 600;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Rectangle {
                            width: 200px;
                            height: 30px;
                            border-radius: 4px;
                            background: root.tool-activation == "drag" ? DesignTokens.accent : DesignTokens.surface;
                            border-width: 1px;
                            border-color: DesignTokens.border;
                            accessible-role: radio-button;
                            accessible-label: "Click and drag";
                            accessible-checked: root.tool-activation == "drag";
                            HorizontalLayout {
                                padding-left: 10px;
                                spacing: 6px;
                                alignment: center;
                                Text {
                                    text: "Click + drag";
                                    color: root.tool-activation == "drag" ? DesignTokens.canvas : DesignTokens.text-primary;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "release confirms";
                                    color: root.tool-activation == "drag" ? DesignTokens.canvas : DesignTokens.text-muted;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea { clicked => { root.tool-activation-set("drag"); } }
                        }

                        Rectangle {
                            width: 200px;
                            height: 30px;
                            border-radius: 4px;
                            background: root.tool-activation == "instant" ? DesignTokens.accent : DesignTokens.surface;
                            border-width: 1px;
                            border-color: DesignTokens.border;
                            accessible-role: radio-button;
                            accessible-label: "Shortcut without clicking";
                            accessible-checked: root.tool-activation == "instant";
                            HorizontalLayout {
                                padding-left: 10px;
                                spacing: 6px;
                                alignment: center;
                                Text {
                                    text: "Shortcut";
                                    color: root.tool-activation == "instant" ? DesignTokens.canvas : DesignTokens.text-primary;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "follows pointer, click confirms";
                                    color: root.tool-activation == "instant" ? DesignTokens.canvas : DesignTokens.text-muted;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea { clicked => { root.tool-activation-set("instant"); } }
                        }
                    }

                    Text {
                        text: root.label-vertical-tool-drag;
                        color: DesignTokens.text-primary;
                        font-size: 12px;
                        font-weight: 600;
                    }
                    Rectangle {
                        height: 30px;
                        border-radius: 4px;
                        background: root.invert-vertical-drag ? DesignTokens.accent : DesignTokens.surface;
                        border-width: 1px;
                        border-color: root.invert-vertical-drag ? DesignTokens.focus-ring : DesignTokens.border;
                        accessible-role: checkbox;
                        accessible-label: root.label-invert-vertical-drag;
                        accessible-checked: root.invert-vertical-drag;
                        HorizontalLayout {
                            padding-left: 10px;
                            spacing: 8px;
                            alignment: center;
                            Text {
                                text: root.label-invert-vertical-drag;
                                color: root.invert-vertical-drag ? DesignTokens.canvas : DesignTokens.text-primary;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.invert-vertical-drag-set(!root.invert-vertical-drag); } }
                    }

                    Text {
                        text: root.label-selection-color;
                        color: DesignTokens.text-primary;
                        font-size: 12px;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: 4px;
                            background: root.selection-color;
                            border-width: 1px;
                            border-color: DesignTokens.border;
                        }
                        Rectangle {
                            width: 110px;
                            height: 30px;
                            border-radius: 4px;
                            background: DesignTokens.surface;
                            border-width: 1px;
                            border-color: DesignTokens.border;
                            TextInput {
                                x: 8px;
                                y: 5px;
                                width: parent.width - 16px;
                                height: parent.height - 10px;
                                text: root.selection-color-hex;
                                color: DesignTokens.text-primary;
                                font-size: 11px;
                                single-line: true;
                                accessible-label: root.label-selection-color;
                                accepted => { root.selection-color-set(self.text); }
                            }
                        }
                    }
                    Text {
                        text: root.label-highlight-thickness;
                        color: DesignTokens.text-primary;
                        font-size: 12px;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        Slider {
                            horizontal-stretch: 1;
                            minimum: 1;
                            maximum: 6;
                            value: root.selection-thickness;
                            accessible-label: root.label-highlight-thickness;
                            changed(value) => { root.selection-thickness-set(value); }
                        }
                        Text { text: "\{round(root.selection-thickness * 10) / 10} px"; color: DesignTokens.text-secondary; font-size: 10px; width: 42px; horizontal-alignment: right; vertical-alignment: center; }
                    }

                    Text {
                        text: root.shell-info;
                        color: DesignTokens.text-muted;
                        font-size: 11px;
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }
        }
    }
}
