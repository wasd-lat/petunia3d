{
  "id": "feature-standard",
  "name": "Standard Feature Implementation",
  "version": 1,
  "purpose": "Default multi-agent implementation flow for ordinary product and feature work with independent cross-model review.",
  "preconditions": [
    "Active Goal in LOCKED or PLANNED state",
    "Initial codebase context index available"
  ],
  "inputs": [
    "Active Goal",
    "Task specifications",
    "Acceptance criteria"
  ],
  "agents": [
    "explorer",
    "architect",
    "implementer",
    "tester",
    "reviewer",
    "documentation-maintainer"
  ],
  "skills": [
    "prumo-navigation",
    "lean-progressive-context",
    "clean-code",
    "refactoring",
    "testing-quality",
    "code-review",
    "documentation"
  ],
  "gates": [
    "tests",
    "review"
  ],
  "artifacts": [
    "Implementation changeset",
    "Test suite evidence",
    "Review report",
    "Documentation delta"
  ],
  "stop_conditions": [
    "Goal acceptance criteria met and verified with evidence",
    "Reviewer approval granted"
  ],
  "steps": [
    {
      "id": "explore",
      "name": "Map impact and dependencies",
      "agent_role": "explorer",
      "skills": [
        "prumo-navigation",
        "lean-progressive-context"
      ],
      "input": "Active Goal & docs/PRUMO.md",
      "output": "Impact map and context plan",
      "required_evidence": [
        "review"
      ]
    },
    {
      "id": "plan",
      "name": "Design minimal task plan",
      "depends_on": [
        "explore"
      ],
      "agent_role": "architect",
      "skills": [
        "clean-code",
        "architecture-quality"
      ],
      "input": "Impact map",
      "output": "Approved Plan DAG",
      "required_evidence": [
        "review"
      ]
    },
    {
      "id": "implement",
      "name": "Implement scoped changes",
      "depends_on": [
        "plan"
      ],
      "agent_role": "implementer",
      "skills": [
        "clean-code",
        "refactoring",
        "error-handling"
      ],
      "input": "Task ContextPack",
      "output": "Source code and unit tests",
      "required_evidence": [
        "lint"
      ]
    },
    {
      "id": "test",
      "name": "Execute test verification",
      "depends_on": [
        "implement"
      ],
      "agent_role": "tester",
      "skills": [
        "testing-quality"
      ],
      "input": "Changed implementation",
      "output": "Test execution report",
      "required_evidence": [
        "test"
      ],
      "gates": [
        "tests"
      ]
    },
    {
      "id": "review",
      "name": "Independent review",
      "depends_on": [
        "test"
      ],
      "agent_role": "reviewer",
      "skills": [
        "code-review",
        "clean-code"
      ],
      "input": "Changeset diff and test evidence",
      "output": "Review report and approval",
      "required_evidence": [
        "review"
      ],
      "gates": [
        "review"
      ]
    },
    {
      "id": "docs",
      "name": "Synchronize canonical documentation",
      "depends_on": [
        "review"
      ],
      "agent_role": "documentation-maintainer",
      "skills": [
        "documentation",
        "lean-progressive-context"
      ],
      "input": "Verified changeset",
      "output": "Canonical Markdown delta",
      "required_evidence": [
        "review"
      ]
    }
  ],
  "fallbacks": [
    {
      "condition": "step_failed",
      "action": "retry_with_alternate_model",
      "max_retries": 2
    },
    {
      "condition": "gate_failed",
      "action": "escalate_to_human"
    }
  ]
}
