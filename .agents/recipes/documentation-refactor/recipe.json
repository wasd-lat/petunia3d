{
  "id": "documentation-refactor",
  "name": "Documentation Refactor",
  "version": 1,
  "purpose": "Reorganize canonical docs, docs/PRUMO.md navigation, and audience split without document proliferation.",
  "select": {
    "features_any": [
      "documentation",
      "ai-assisted-development"
    ]
  },
  "requires_skills_any": [
    "documentation-for-llms",
    "documentation"
  ],
  "inputs": [
    "Current documentation set",
    "Audience definitions"
  ],
  "agents": [
    "explorer",
    "documentation-maintainer",
    "reviewer"
  ],
  "skills": [
    "prumo-navigation",
    "documentation",
    "documentation-for-llms"
  ],
  "gates": [
    "review"
  ],
  "artifacts": [
    "Synchronized canonical Markdown",
    "Updated docs/PRUMO.md"
  ],
  "stop_conditions": [
    "All documentation links valid and zero redundant files"
  ],
  "steps": [
    {
      "id": "inventory",
      "name": "Inventory current canonical documents",
      "agent_role": "explorer",
      "skills": [
        "prumo-navigation"
      ],
      "input": "docs/ directory",
      "output": "Documentation inventory",
      "required_evidence": [
        "review"
      ]
    },
    {
      "id": "structure",
      "name": "Map audience needs (user, dev, ops, agent)",
      "depends_on": [
        "inventory"
      ],
      "agent_role": "documentation-maintainer",
      "skills": [
        "documentation"
      ],
      "input": "Documentation inventory",
      "output": "Audience structure plan",
      "required_evidence": [
        "review"
      ]
    },
    {
      "id": "patch",
      "name": "Patch canonical Markdown files",
      "depends_on": [
        "structure"
      ],
      "agent_role": "documentation-maintainer",
      "skills": [
        "documentation",
        "documentation-for-llms"
      ],
      "input": "Structure plan",
      "output": "Refactored documentation files",
      "required_evidence": [
        "review"
      ]
    },
    {
      "id": "verify-links",
      "name": "Validate links and PRUMO routing",
      "depends_on": [
        "patch"
      ],
      "agent_role": "reviewer",
      "skills": [
        "documentation"
      ],
      "input": "Refactored docs",
      "output": "Link validation report",
      "required_evidence": [
        "review"
      ],
      "gates": [
        "review"
      ]
    }
  ],
  "fallbacks": [
    {
      "condition": "step_failed",
      "action": "retry_with_alternate_model",
      "max_retries": 2
    },
    {
      "condition": "gate_failed",
      "action": "escalate_to_human"
    }
  ]
}
