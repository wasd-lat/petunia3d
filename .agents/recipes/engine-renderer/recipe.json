{
  "id": "engine-renderer",
  "name": "Engine Renderer Change",
  "version": 1,
  "purpose": "Safely modify GPU, 2D/3D pipelines, and shader systems with visual fixture verification.",
  "select": {
    "project_types": [
      "game-engine"
    ],
    "features_any": [
      "rendering",
      "lighting",
      "postfx"
    ]
  },
  "requires_skills_any": [
    "rendering-2d",
    "rendering-3d",
    "shaders"
  ],
  "inputs": [
    "Render pipeline spec",
    "Visual baseline fixtures"
  ],
  "agents": [
    "explorer",
    "renderer-engineer",
    "tester",
    "reviewer"
  ],
  "skills": [
    "prumo-navigation",
    "shaders",
    "rendering-2d",
    "benchmarking",
    "performance-native",
    "architecture-quality"
  ],
  "gates": [
    "benchmark",
    "tests",
    "review"
  ],
  "artifacts": [
    "Shader pipelines",
    "Visual regression diffs",
    "GPU frame time benchmarks"
  ],
  "stop_conditions": [
    "Visual fixtures match and frame timing budget met"
  ],
  "steps": [
    {
      "id": "explore",
      "name": "Map GPU pipeline boundaries",
      "agent_role": "explorer",
      "skills": [
        "prumo-navigation"
      ],
      "input": "Render subsystem",
      "output": "Pipeline boundary map",
      "required_evidence": [
        "review"
      ]
    },
    {
      "id": "visual-fixture",
      "name": "Establish visual fixtures",
      "depends_on": [
        "explore"
      ],
      "agent_role": "renderer-engineer",
      "skills": [
        "shaders",
        "rendering-2d"
      ],
      "input": "Visual requirements",
      "output": "Baseline visual fixtures",
      "required_evidence": [
        "screenshot"
      ]
    },
    {
      "id": "implement",
      "name": "Implement renderer / shader modifications",
      "depends_on": [
        "visual-fixture"
      ],
      "agent_role": "renderer-engineer",
      "skills": [
        "rendering-2d",
        "shaders"
      ],
      "input": "Visual fixture & shader spec",
      "output": "Shader / pipeline changeset",
      "required_evidence": [
        "test"
      ]
    },
    {
      "id": "benchmark",
      "name": "Profile draw calls and GPU timings",
      "depends_on": [
        "implement"
      ],
      "agent_role": "tester",
      "skills": [
        "benchmarking",
        "performance-native"
      ],
      "input": "Modified renderer",
      "output": "GPU frame time benchmark",
      "required_evidence": [
        "benchmark"
      ],
      "gates": [
        "benchmark"
      ]
    },
    {
      "id": "review",
      "name": "Independent review of rendering architecture",
      "depends_on": [
        "benchmark"
      ],
      "agent_role": "reviewer",
      "skills": [
        "architecture-quality"
      ],
      "input": "Diff, benchmark, and visual diffs",
      "output": "Review sign-off",
      "required_evidence": [
        "review"
      ],
      "gates": [
        "review"
      ]
    }
  ],
  "fallbacks": [
    {
      "condition": "step_failed",
      "action": "retry_with_alternate_model",
      "max_retries": 2
    },
    {
      "condition": "gate_failed",
      "action": "escalate_to_human"
    }
  ]
}
