{
  "id": "compiler-change",
  "name": "Compiler/Language Change",
  "version": 1,
  "purpose": "Safely modify parsing, IR, AST, or runtime behavior with conformance test validation.",
  "select": {
    "project_types": [
      "compiler",
      "language"
    ],
    "features_any": [
      "compiler",
      "scripting"
    ]
  },
  "requires_skills_any": [
    "compiler-development"
  ],
  "inputs": [
    "Language specification / RFC",
    "Grammar"
  ],
  "agents": [
    "architect",
    "compiler-engineer",
    "tester",
    "reviewer"
  ],
  "skills": [
    "architecture-quality",
    "compiler-development",
    "clean-code",
    "testing-quality",
    "code-review"
  ],
  "gates": [
    "tests",
    "review"
  ],
  "artifacts": [
    "Language RFC",
    "AST passes",
    "Conformance test suite"
  ],
  "stop_conditions": [
    "100% language conformance test suite pass rate"
  ],
  "steps": [
    {
      "id": "spec",
      "name": "Specify syntax/semantic changes in RFC",
      "agent_role": "architect",
      "skills": [
        "architecture-quality"
      ],
      "input": "Proposed language feature",
      "output": "Language RFC specification",
      "required_evidence": [
        "review"
      ]
    },
    {
      "id": "conformance-tests",
      "name": "Write failing conformance tests",
      "depends_on": [
        "spec"
      ],
      "agent_role": "compiler-engineer",
      "skills": [
        "compiler-development"
      ],
      "input": "RFC spec",
      "output": "Failing test fixtures",
      "required_evidence": [
        "test"
      ]
    },
    {
      "id": "implement",
      "name": "Implement AST / IR transformations",
      "depends_on": [
        "conformance-tests"
      ],
      "agent_role": "compiler-engineer",
      "skills": [
        "compiler-development",
        "clean-code"
      ],
      "input": "Conformance tests and grammar",
      "output": "Compiler pass implementation",
      "required_evidence": [
        "test"
      ]
    },
    {
      "id": "test",
      "name": "Execute full conformance test suite",
      "depends_on": [
        "implement"
      ],
      "agent_role": "tester",
      "skills": [
        "testing-quality"
      ],
      "input": "Modified compiler",
      "output": "Conformance test report",
      "required_evidence": [
        "test"
      ],
      "gates": [
        "tests"
      ]
    },
    {
      "id": "review",
      "name": "Independent review of ABI & backwards compatibility",
      "depends_on": [
        "test"
      ],
      "agent_role": "reviewer",
      "skills": [
        "code-review"
      ],
      "input": "Compiler diff and test report",
      "output": "Review sign-off",
      "required_evidence": [
        "review"
      ],
      "gates": [
        "review"
      ]
    }
  ],
  "fallbacks": [
    {
      "condition": "step_failed",
      "action": "retry_with_alternate_model",
      "max_retries": 2
    },
    {
      "condition": "gate_failed",
      "action": "escalate_to_human"
    }
  ],
  "preconditions": [
    "Language RFC or specification change proposed",
    "Existing grammar and conformance test suite available"
  ]
}
