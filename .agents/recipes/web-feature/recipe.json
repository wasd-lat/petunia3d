{
  "id": "web-feature",
  "name": "Web Feature Development",
  "version": 1,
  "purpose": "Implement fullstack web features across frontend components and backend API endpoints.",
  "select": {
    "project_types": [
      "web-saas",
      "ecommerce",
      "web-app"
    ]
  },
  "requires_skills_any": [
    "frontend-web",
    "backend-api"
  ],
  "inputs": [
    "Feature requirements",
    "API contract"
  ],
  "agents": [
    "backend-engineer",
    "frontend-engineer",
    "tester",
    "reviewer"
  ],
  "skills": [
    "backend-api",
    "database-review",
    "frontend-web",
    "api-contract-testing",
    "code-review"
  ],
  "gates": [
    "tests",
    "review"
  ],
  "artifacts": [
    "API endpoints",
    "UI components",
    "Integration tests"
  ],
  "stop_conditions": [
    "Fullstack feature verified with integration tests"
  ],
  "steps": [
    {
      "id": "api-spec",
      "name": "Define API contracts and database schema",
      "agent_role": "backend-engineer",
      "skills": [
        "backend-api",
        "database-review"
      ],
      "input": "Feature requirement",
      "output": "API contract & schema migration",
      "required_evidence": [
        "test"
      ]
    },
    {
      "id": "backend",
      "name": "Implement backend endpoints",
      "depends_on": [
        "api-spec"
      ],
      "agent_role": "backend-engineer",
      "skills": [
        "backend-api",
        "clean-code"
      ],
      "input": "API contract",
      "output": "Backend service implementation",
      "required_evidence": [
        "test"
      ]
    },
    {
      "id": "frontend",
      "name": "Implement frontend components and state",
      "depends_on": [
        "backend"
      ],
      "agent_role": "frontend-engineer",
      "skills": [
        "frontend-web",
        "ui-implementation"
      ],
      "input": "API endpoints and UI design",
      "output": "Frontend components",
      "required_evidence": [
        "test"
      ]
    },
    {
      "id": "test",
      "name": "Run unit, API contract, and UI tests",
      "depends_on": [
        "frontend"
      ],
      "agent_role": "tester",
      "skills": [
        "api-contract-testing",
        "testing-quality"
      ],
      "input": "Fullstack changeset",
      "output": "Test execution report",
      "required_evidence": [
        "test"
      ],
      "gates": [
        "tests"
      ]
    },
    {
      "id": "review",
      "name": "Independent security and code review",
      "depends_on": [
        "test"
      ],
      "agent_role": "reviewer",
      "skills": [
        "code-review",
        "web-security"
      ],
      "input": "Diff and test evidence",
      "output": "Review approval",
      "required_evidence": [
        "review"
      ],
      "gates": [
        "review"
      ]
    }
  ],
  "fallbacks": [
    {
      "condition": "step_failed",
      "action": "retry_with_alternate_model",
      "max_retries": 2
    },
    {
      "condition": "gate_failed",
      "action": "escalate_to_human"
    }
  ]
}
