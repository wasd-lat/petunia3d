{
  "id": "project-bootstrap",
  "name": "Project Bootstrap",
  "version": 1,
  "purpose": "Initialize Prumo configuration, schema validation, and minimal workforce for a new repository.",
  "inputs": [
    "Project profile JSON",
    "Target directory"
  ],
  "agents": [
    "explorer",
    "architect",
    "implementer",
    "tester"
  ],
  "skills": [
    "prumo-navigation",
    "clean-code",
    "documentation",
    "goal-management",
    "testing-quality"
  ],
  "gates": [
    "tests"
  ],
  "artifacts": [
    "prumo.json",
    "docs/PRUMO.md",
    ".ai/ manifests",
    "Initial Goal"
  ],
  "stop_conditions": [
    "Project initialized and validated with prumo doctor"
  ],
  "steps": [
    {
      "id": "profile",
      "name": "Capture project preferences and stack",
      "agent_role": "explorer",
      "skills": [
        "prumo-navigation"
      ],
      "input": "Project profile",
      "output": "Validated ProjectProfile object",
      "required_evidence": [
        "review"
      ]
    },
    {
      "id": "resolve",
      "name": "Resolve smallest useful workforce",
      "depends_on": [
        "profile"
      ],
      "agent_role": "architect",
      "skills": [
        "clean-code"
      ],
      "input": "ProjectProfile",
      "output": "Resolution plan",
      "required_evidence": [
        "review"
      ]
    },
    {
      "id": "scaffold",
      "name": "Scaffold canonical directory layout and prumo.json",
      "depends_on": [
        "resolve"
      ],
      "agent_role": "implementer",
      "skills": [
        "documentation",
        "goal-management"
      ],
      "input": "Resolution plan",
      "output": "Scaffolded workspace",
      "required_evidence": [
        "test"
      ]
    },
    {
      "id": "validate",
      "name": "Validate generated configuration against schemas",
      "depends_on": [
        "scaffold"
      ],
      "agent_role": "tester",
      "skills": [
        "testing-quality"
      ],
      "input": "Scaffolded workspace",
      "output": "Validation pass report",
      "required_evidence": [
        "test"
      ],
      "gates": [
        "tests"
      ]
    }
  ],
  "fallbacks": [
    {
      "condition": "step_failed",
      "action": "retry_with_alternate_model",
      "max_retries": 2
    },
    {
      "condition": "gate_failed",
      "action": "escalate_to_human"
    }
  ]
}
