{
  "id": "ui-feature",
  "name": "UI Feature Engineering",
  "version": 1,
  "purpose": "End-to-end design, tokenization, implementation, and accessibility audit of UI features.",
  "select": {
    "features_any": [
      "ui",
      "dashboard",
      "editor"
    ]
  },
  "requires_skills_any": [
    "design-research",
    "ux-architecture",
    "wireframing",
    "design-system",
    "accessibility"
  ],
  "inputs": [
    "Product requirement",
    "Design references"
  ],
  "agents": [
    "design-researcher",
    "ux-architect",
    "design-system-engineer",
    "frontend-engineer",
    "accessibility-reviewer"
  ],
  "skills": [
    "design-research",
    "user-flows",
    "wireframing",
    "design-system",
    "frontend-web",
    "accessibility",
    "visual-regression"
  ],
  "gates": [
    "accessibility",
    "tests",
    "review"
  ],
  "artifacts": [
    "Research report",
    "Wireframe spec",
    "Design tokens",
    "Tested UI components",
    "a11y scorecard"
  ],
  "stop_conditions": [
    "UI feature implemented, visually tested, and WCAG AA compliant"
  ],
  "steps": [
    {
      "id": "research",
      "name": "Design and interaction research",
      "agent_role": "design-researcher",
      "skills": [
        "design-research",
        "website-forensics"
      ],
      "input": "Product requirement",
      "output": "Design research report",
      "required_evidence": [
        "review"
      ]
    },
    {
      "id": "ux",
      "name": "User flow and information architecture",
      "depends_on": [
        "research"
      ],
      "agent_role": "ux-architect",
      "skills": [
        "user-flows",
        "information-architecture"
      ],
      "input": "Research findings",
      "output": "User flow & layout hierarchy",
      "required_evidence": [
        "review"
      ]
    },
    {
      "id": "wireframe",
      "name": "Structured wireframing",
      "depends_on": [
        "ux"
      ],
      "agent_role": "ux-architect",
      "skills": [
        "wireframing",
        "interaction-design"
      ],
      "input": "User flow",
      "output": "Structured wireframe spec",
      "required_evidence": [
        "review"
      ]
    },
    {
      "id": "design-tokens",
      "name": "Design tokens & component spec",
      "depends_on": [
        "wireframe"
      ],
      "agent_role": "design-system-engineer",
      "skills": [
        "design-system",
        "design-tokens",
        "component-specification"
      ],
      "input": "Wireframe spec",
      "output": "Design tokens JSON & component spec",
      "required_evidence": [
        "test"
      ]
    },
    {
      "id": "implement",
      "name": "Implement UI components",
      "depends_on": [
        "design-tokens"
      ],
      "agent_role": "frontend-engineer",
      "skills": [
        "ui-implementation",
        "frontend-web"
      ],
      "input": "Tokens and wireframe spec",
      "output": "UI components and component tests",
      "required_evidence": [
        "test"
      ]
    },
    {
      "id": "accessibility-audit",
      "name": "Audit keyboard, focus, and screen readers",
      "depends_on": [
        "implement"
      ],
      "agent_role": "accessibility-reviewer",
      "skills": [
        "accessibility",
        "keyboard-accessibility",
        "contrast"
      ],
      "input": "Rendered UI views",
      "output": "WCAG 2.2 AA audit scorecard",
      "required_evidence": [
        "test"
      ],
      "gates": [
        "accessibility"
      ]
    },
    {
      "id": "visual-qa",
      "name": "Visual regression and QA review",
      "depends_on": [
        "accessibility-audit"
      ],
      "agent_role": "ux-architect",
      "skills": [
        "visual-regression",
        "visual-qa"
      ],
      "input": "UI components & snapshots",
      "output": "Visual QA sign-off",
      "required_evidence": [
        "screenshot",
        "test"
      ],
      "gates": [
        "review"
      ]
    }
  ],
  "fallbacks": [
    {
      "condition": "step_failed",
      "action": "retry_with_alternate_model",
      "max_retries": 2
    },
    {
      "condition": "gate_failed",
      "action": "escalate_to_human"
    }
  ],
  "preconditions": [
    "Product requirement or design spec available",
    "Design system tokens accessible"
  ]
}
