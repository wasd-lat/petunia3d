{
  "id": "ui-review",
  "name": "UI/UX Review",
  "version": 1,
  "purpose": "Review user interface ergonomics, visual fidelity, and accessibility standards.",
  "select": {
    "features_any": [
      "ui",
      "editor",
      "dashboard"
    ]
  },
  "requires_skills_any": [
    "ui-ux-review",
    "accessibility",
    "visual-regression"
  ],
  "inputs": [
    "Rendered UI views",
    "Design tokens"
  ],
  "agents": [
    "ux-architect",
    "accessibility-reviewer",
    "reviewer"
  ],
  "skills": [
    "visual-regression",
    "accessibility",
    "keyboard-accessibility",
    "code-review"
  ],
  "gates": [
    "accessibility",
    "review"
  ],
  "artifacts": [
    "UI review findings",
    "WCAG audit report"
  ],
  "stop_conditions": [
    "UI review completed with prioritized findings"
  ],
  "steps": [
    {
      "id": "capture",
      "name": "Capture visual snapshots",
      "agent_role": "ux-architect",
      "skills": [
        "visual-regression"
      ],
      "input": "UI views",
      "output": "Visual snapshots",
      "required_evidence": [
        "screenshot"
      ]
    },
    {
      "id": "heuristic-review",
      "name": "Review interaction heuristics",
      "depends_on": [
        "capture"
      ],
      "agent_role": "ux-architect",
      "skills": [
        "visual-qa"
      ],
      "input": "Snapshots & interaction flows",
      "output": "Ergonomics findings",
      "required_evidence": [
        "review"
      ]
    },
    {
      "id": "accessibility",
      "name": "Evaluate WCAG 2.2 AA compliance",
      "depends_on": [
        "heuristic-review"
      ],
      "agent_role": "accessibility-reviewer",
      "skills": [
        "accessibility",
        "keyboard-accessibility"
      ],
      "input": "UI components",
      "output": "a11y compliance report",
      "required_evidence": [
        "test"
      ],
      "gates": [
        "accessibility"
      ]
    },
    {
      "id": "report",
      "name": "Emit prioritized findings",
      "depends_on": [
        "accessibility"
      ],
      "agent_role": "reviewer",
      "skills": [
        "code-review"
      ],
      "input": "All audit reports",
      "output": "Prioritized UI review scorecard",
      "required_evidence": [
        "review"
      ],
      "gates": [
        "review"
      ]
    }
  ],
  "fallbacks": [
    {
      "condition": "step_failed",
      "action": "retry_with_alternate_model",
      "max_retries": 2
    },
    {
      "condition": "gate_failed",
      "action": "escalate_to_human"
    }
  ]
}
