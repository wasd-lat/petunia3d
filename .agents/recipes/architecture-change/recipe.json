{
  "id": "architecture-change",
  "name": "Architecture Change",
  "version": 1,
  "purpose": "Safely modify system boundaries, public contracts, and ADRs with staged execution.",
  "preconditions": [
    "Proposed architectural RFC or Goal"
  ],
  "inputs": [
    "RFC / Goal",
    "System architecture",
    "Dependency graph"
  ],
  "agents": [
    "explorer",
    "architect",
    "implementer",
    "tester",
    "reviewer"
  ],
  "skills": [
    "prumo-navigation",
    "architecture-quality",
    "clean-code",
    "testing-quality",
    "code-review"
  ],
  "gates": [
    "adr-approval",
    "tests",
    "review"
  ],
  "artifacts": [
    "Approved ADR",
    "Staged migration DAG",
    "Verified implementation"
  ],
  "stop_conditions": [
    "ADR approved and staged tasks completed"
  ],
  "steps": [
    {
      "id": "explore",
      "name": "Map affected consumers and interfaces",
      "agent_role": "explorer",
      "skills": [
        "prumo-navigation"
      ],
      "input": "Proposed RFC",
      "output": "Interface impact map",
      "required_evidence": [
        "review"
      ]
    },
    {
      "id": "propose-adr",
      "name": "Author Architectural Decision Record",
      "depends_on": [
        "explore"
      ],
      "agent_role": "architect",
      "skills": [
        "architecture-quality"
      ],
      "input": "Interface impact map",
      "output": "Canonical ADR document",
      "required_evidence": [
        "review"
      ],
      "gates": [
        "adr-approval"
      ]
    },
    {
      "id": "plan-staged",
      "name": "Design staged DAG migration plan",
      "depends_on": [
        "propose-adr"
      ],
      "agent_role": "architect",
      "skills": [
        "architecture-quality"
      ],
      "input": "Approved ADR",
      "output": "Staged Plan DAG",
      "required_evidence": [
        "review"
      ]
    },
    {
      "id": "implement",
      "name": "Implement contract transformation",
      "depends_on": [
        "plan-staged"
      ],
      "agent_role": "implementer",
      "skills": [
        "clean-code",
        "refactoring"
      ],
      "input": "Staged tasks",
      "output": "Refactored subsystems",
      "required_evidence": [
        "test"
      ]
    },
    {
      "id": "test",
      "name": "Verify backwards compatibility",
      "depends_on": [
        "implement"
      ],
      "agent_role": "tester",
      "skills": [
        "testing-quality"
      ],
      "input": "Compatibility test suite",
      "output": "Test evidence",
      "required_evidence": [
        "test"
      ],
      "gates": [
        "tests"
      ]
    },
    {
      "id": "review",
      "name": "Cross-provider architecture review",
      "depends_on": [
        "test"
      ],
      "agent_role": "reviewer",
      "skills": [
        "architecture-quality",
        "code-review"
      ],
      "input": "Diff and evidence",
      "output": "Review sign-off",
      "required_evidence": [
        "review"
      ],
      "gates": [
        "review"
      ]
    }
  ],
  "fallbacks": [
    {
      "condition": "step_failed",
      "action": "retry_with_alternate_model",
      "max_retries": 2
    },
    {
      "condition": "gate_failed",
      "action": "escalate_to_human"
    }
  ]
}
