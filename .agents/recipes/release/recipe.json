{
  "id": "release",
  "name": "Release Verification",
  "version": 1,
  "purpose": "Produce, verify, and audit release artifacts across target matrices.",
  "preconditions": [
    "Release Goal locked",
    "Working tree clean"
  ],
  "inputs": [
    "Release candidate commit",
    "Changelog delta"
  ],
  "agents": [
    "architect",
    "release-verifier",
    "tester",
    "security-reviewer"
  ],
  "skills": [
    "goal-management",
    "release-engineering",
    "testing-quality",
    "security-review"
  ],
  "gates": [
    "build",
    "tests",
    "security-scan"
  ],
  "artifacts": [
    "Release verification scorecard",
    "Checksums",
    "Rollback plan"
  ],
  "stop_conditions": [
    "All release gates pass cleanly"
  ],
  "steps": [
    {
      "id": "freeze",
      "name": "Lock release Goal and scope",
      "agent_role": "architect",
      "skills": [
        "goal-management"
      ],
      "input": "Release scope",
      "output": "LOCKED Goal record",
      "required_evidence": [
        "review"
      ]
    },
    {
      "id": "build-matrix",
      "name": "Clean build across target matrix",
      "depends_on": [
        "freeze"
      ],
      "agent_role": "release-verifier",
      "skills": [
        "release-engineering"
      ],
      "input": "Release commit",
      "output": "Release binaries / packages",
      "required_evidence": [
        "build"
      ],
      "gates": [
        "build"
      ]
    },
    {
      "id": "test-matrix",
      "name": "Execute full test matrix",
      "depends_on": [
        "build-matrix"
      ],
      "agent_role": "tester",
      "skills": [
        "testing-quality"
      ],
      "input": "Built artifacts",
      "output": "Matrix test report",
      "required_evidence": [
        "test"
      ],
      "gates": [
        "tests"
      ]
    },
    {
      "id": "security-audit",
      "name": "Audit release dependencies & CVEs",
      "depends_on": [
        "test-matrix"
      ],
      "agent_role": "security-reviewer",
      "skills": [
        "security-review",
        "supply-chain-security"
      ],
      "input": "Lockfile & packages",
      "output": "Security scan report",
      "required_evidence": [
        "security-scan"
      ],
      "gates": [
        "security-scan"
      ]
    },
    {
      "id": "verify-release",
      "name": "Verify checksums and rollback plan",
      "depends_on": [
        "security-audit"
      ],
      "agent_role": "release-verifier",
      "skills": [
        "release-engineering"
      ],
      "input": "All gate evidence",
      "output": "Signed release verification scorecard",
      "required_evidence": [
        "review"
      ]
    }
  ],
  "fallbacks": [
    {
      "condition": "step_failed",
      "action": "retry_with_alternate_model",
      "max_retries": 2
    },
    {
      "condition": "gate_failed",
      "action": "escalate_to_human"
    }
  ]
}
