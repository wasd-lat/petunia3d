{
  "id": "security-review",
  "name": "Security Review Workflow",
  "version": 1,
  "purpose": "Threat-model, audit, and remediate security-sensitive features.",
  "select": {
    "risk_any": [
      "security",
      "public-web",
      "financial",
      "privacy"
    ]
  },
  "requires_skills_any": [
    "threat-modeling",
    "security-review",
    "secure-coding"
  ],
  "preconditions": [
    "Target feature design or implementation available"
  ],
  "inputs": [
    "Feature design / diff",
    "Security policy"
  ],
  "agents": [
    "security-architect",
    "security-reviewer",
    "implementer"
  ],
  "skills": [
    "threat-modeling",
    "security-review",
    "secure-coding",
    "clean-code"
  ],
  "gates": [
    "security-scan",
    "tests",
    "review"
  ],
  "artifacts": [
    "Threat model",
    "Security audit report",
    "Remediation verification"
  ],
  "stop_conditions": [
    "Zero unresolved high/critical security findings"
  ],
  "steps": [
    {
      "id": "threat-model",
      "name": "Enumerate trust boundaries and threats",
      "agent_role": "security-architect",
      "skills": [
        "threat-modeling"
      ],
      "input": "Feature architecture",
      "output": "Threat model specification",
      "required_evidence": [
        "review"
      ]
    },
    {
      "id": "audit",
      "name": "Audit source for abuse paths",
      "depends_on": [
        "threat-model"
      ],
      "agent_role": "security-reviewer",
      "skills": [
        "security-review",
        "secure-coding"
      ],
      "input": "Source diff and threat model",
      "output": "Security findings report",
      "required_evidence": [
        "security-scan"
      ],
      "gates": [
        "security-scan"
      ]
    },
    {
      "id": "remediate",
      "name": "Remediate findings at boundary",
      "depends_on": [
        "audit"
      ],
      "agent_role": "implementer",
      "skills": [
        "secure-coding",
        "clean-code"
      ],
      "input": "Security findings",
      "output": "Remediation patch",
      "required_evidence": [
        "test"
      ]
    },
    {
      "id": "re-verify",
      "name": "Re-verify security gates",
      "depends_on": [
        "remediate"
      ],
      "agent_role": "security-reviewer",
      "skills": [
        "security-review"
      ],
      "input": "Remediated code",
      "output": "Security audit sign-off",
      "required_evidence": [
        "security-scan",
        "test"
      ],
      "gates": [
        "review"
      ]
    }
  ],
  "fallbacks": [
    {
      "condition": "step_failed",
      "action": "retry_with_alternate_model",
      "max_retries": 2
    },
    {
      "condition": "gate_failed",
      "action": "escalate_to_human"
    }
  ]
}
