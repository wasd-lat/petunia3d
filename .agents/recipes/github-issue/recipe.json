{
  "id": "github-issue",
  "name": "GitHub Issue Workflow",
  "version": 1,
  "purpose": "Standardized issue authoring, refinement, and triaging with Goal linkage.",
  "select": {
    "features_any": [
      "github",
      "issue-tracking"
    ]
  },
  "requires_skills_any": [
    "github-issue-create",
    "github-issue-triage"
  ],
  "inputs": [
    "User request / bug report",
    "Repository context"
  ],
  "agents": [
    "explorer",
    "issue-triager",
    "issue-author"
  ],
  "skills": [
    "prumo-navigation",
    "github-issue-triage",
    "github-issue-create",
    "github-issue-refine"
  ],
  "gates": [
    "review"
  ],
  "artifacts": [
    "Canonical GitHub issue record"
  ],
  "stop_conditions": [
    "Issue authored with objective acceptance criteria"
  ],
  "steps": [
    {
      "id": "context",
      "name": "Resolve repository and active Goal context",
      "agent_role": "explorer",
      "skills": [
        "prumo-navigation"
      ],
      "input": "User request",
      "output": "Context summary",
      "required_evidence": [
        "review"
      ]
    },
    {
      "id": "duplicates",
      "name": "Search for duplicate issues",
      "depends_on": [
        "context"
      ],
      "agent_role": "issue-triager",
      "skills": [
        "github-issue-triage"
      ],
      "input": "Issue repository",
      "output": "Duplicate analysis",
      "required_evidence": [
        "review"
      ]
    },
    {
      "id": "classify",
      "name": "Classify issue type, severity, and milestone",
      "depends_on": [
        "duplicates"
      ],
      "agent_role": "issue-triager",
      "skills": [
        "github-issue-triage"
      ],
      "input": "Request analysis",
      "output": "Classification metadata",
      "required_evidence": [
        "review"
      ]
    },
    {
      "id": "draft",
      "name": "Draft issue with objective acceptance criteria",
      "depends_on": [
        "classify"
      ],
      "agent_role": "issue-author",
      "skills": [
        "github-issue-create",
        "github-issue-refine"
      ],
      "input": "Classification & scope",
      "output": "Draft issue markdown",
      "required_evidence": [
        "review"
      ]
    },
    {
      "id": "publish",
      "name": "Publish canonical issue record",
      "depends_on": [
        "draft"
      ],
      "agent_role": "issue-author",
      "skills": [
        "github-issue-create"
      ],
      "input": "Draft issue",
      "output": "Canonical issue record",
      "required_evidence": [
        "review"
      ],
      "gates": [
        "review"
      ]
    }
  ],
  "fallbacks": [
    {
      "condition": "step_failed",
      "action": "retry_with_alternate_model",
      "max_retries": 2
    },
    {
      "condition": "gate_failed",
      "action": "escalate_to_human"
    }
  ],
  "preconditions": [
    "Repository context and active Goals accessible",
    "Issue tracker permissions available"
  ]
}
