{
  "id": "multiplayer-feature",
  "name": "Multiplayer Feature Development",
  "version": 1,
  "purpose": "Implement authoritative replication and network protocols with packet loss simulation.",
  "select": {
    "features_any": [
      "multiplayer",
      "networking"
    ]
  },
  "requires_skills_any": [
    "multiplayer-networking",
    "network-testing"
  ],
  "inputs": [
    "Network protocol spec",
    "Authority architecture"
  ],
  "agents": [
    "networking-engineer",
    "tester",
    "security-reviewer"
  ],
  "skills": [
    "multiplayer-networking",
    "clean-code",
    "network-testing",
    "network-security"
  ],
  "gates": [
    "tests",
    "security-scan"
  ],
  "artifacts": [
    "Replication protocol",
    "Network resilience test logs",
    "Security sign-off"
  ],
  "stop_conditions": [
    "Replication verified under simulated packet loss and jitter"
  ],
  "steps": [
    {
      "id": "authority-contract",
      "name": "Define state authority and replication contracts",
      "agent_role": "networking-engineer",
      "skills": [
        "multiplayer-networking"
      ],
      "input": "Protocol requirement",
      "output": "Replication authority contract",
      "required_evidence": [
        "review"
      ]
    },
    {
      "id": "implement",
      "name": "Implement protocol packets and serialization",
      "depends_on": [
        "authority-contract"
      ],
      "agent_role": "networking-engineer",
      "skills": [
        "multiplayer-networking",
        "clean-code"
      ],
      "input": "Authority contract",
      "output": "Networking implementation",
      "required_evidence": [
        "test"
      ]
    },
    {
      "id": "network-test",
      "name": "Simulate packet loss, jitter, and disconnects",
      "depends_on": [
        "implement"
      ],
      "agent_role": "tester",
      "skills": [
        "network-testing"
      ],
      "input": "Network implementation",
      "output": "Resilience test logs",
      "required_evidence": [
        "test"
      ],
      "gates": [
        "tests"
      ]
    },
    {
      "id": "security-review",
      "name": "Audit against packet tampering and DoS",
      "depends_on": [
        "network-test"
      ],
      "agent_role": "security-reviewer",
      "skills": [
        "network-security"
      ],
      "input": "Packet parser diff",
      "output": "Security audit sign-off",
      "required_evidence": [
        "security-scan"
      ],
      "gates": [
        "security-scan"
      ]
    }
  ],
  "fallbacks": [
    {
      "condition": "step_failed",
      "action": "retry_with_alternate_model",
      "max_retries": 2
    },
    {
      "condition": "gate_failed",
      "action": "escalate_to_human"
    }
  ]
}
