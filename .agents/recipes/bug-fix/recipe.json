{
  "id": "bug-fix",
  "name": "Evidence-Driven Bug Fix",
  "version": 1,
  "purpose": "Reproduce, isolate, and repair defects without masking regressions.",
  "preconditions": [
    "Defect report or reproduction scenario available"
  ],
  "inputs": [
    "Defect report",
    "Reproduction steps",
    "Target codebase"
  ],
  "agents": [
    "debugger",
    "tester",
    "reviewer"
  ],
  "skills": [
    "testing-quality",
    "clean-code",
    "refactoring",
    "code-review"
  ],
  "gates": [
    "tests",
    "review"
  ],
  "artifacts": [
    "Regression test",
    "Root-cause repair patch",
    "Review sign-off"
  ],
  "stop_conditions": [
    "Failing regression test passes after fix and full suite is green"
  ],
  "steps": [
    {
      "id": "reproduce",
      "name": "Author failing regression test",
      "agent_role": "debugger",
      "skills": [
        "testing-quality"
      ],
      "input": "Reproduction steps",
      "output": "Automated regression test demonstrating bug",
      "required_evidence": [
        "test"
      ]
    },
    {
      "id": "isolate-and-fix",
      "name": "Isolate causal boundary and repair",
      "depends_on": [
        "reproduce"
      ],
      "agent_role": "debugger",
      "skills": [
        "clean-code",
        "refactoring",
        "error-handling"
      ],
      "input": "Regression test and source",
      "output": "Minimal repair patch",
      "required_evidence": [
        "test"
      ]
    },
    {
      "id": "verify",
      "name": "Verify full suite without regression",
      "depends_on": [
        "isolate-and-fix"
      ],
      "agent_role": "tester",
      "skills": [
        "testing-quality"
      ],
      "input": "Full test suite",
      "output": "Clean test suite pass record",
      "required_evidence": [
        "test"
      ],
      "gates": [
        "tests"
      ]
    },
    {
      "id": "review",
      "name": "Independent review of fix",
      "depends_on": [
        "verify"
      ],
      "agent_role": "reviewer",
      "skills": [
        "code-review"
      ],
      "input": "Fix diff and regression evidence",
      "output": "Review approval",
      "required_evidence": [
        "review"
      ],
      "gates": [
        "review"
      ]
    }
  ],
  "fallbacks": [
    {
      "condition": "step_failed",
      "action": "retry_with_alternate_model",
      "max_retries": 2
    },
    {
      "condition": "gate_failed",
      "action": "escalate_to_human"
    }
  ]
}
