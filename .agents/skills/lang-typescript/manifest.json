    "Active task acceptance criteria"
  ],
  "outputs": [
    "Strictly sound TypeScript source implementations",
    "Nominal branded domain models and schemas",
    "Type check and compiler diagnostic evidence",
    "TypeScript Verification Report"
  ],
  "requires": [
    "clean-code",
    "testing-quality"
  ],
  "conflicts": [],
  "capabilities": [
    "filesystem.read",
    "filesystem.write",
    "process.spawn"
  ],
  "references": [
    "references/typescript-soundness.md"
  ],
  "templates": [
    "templates/typescript-verification-report.md"
  ],
  "checks": [
    "checks/typescript-rules.md"
  ],
  "scripts": [
    "scripts/verify.sh"
  ],
  "examples": [
    "examples/safe_schema.ts"
  ],
  "required_evidence": [
    "test",
    "lint"
  ],
  "stop_conditions": [
