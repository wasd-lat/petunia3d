{
  "id": "lang-sql",
  "name": "SQL Dialect Precision, Parameterization & Index Safety",
  "version": 2,
  "schema_version": 3,
  "purpose": "Enforce explicit SQL dialect semantics (PostgreSQL, MySQL, SQLite, SQL Server), zero string concatenation, mandatory parameterization, explicit projection (prohibit SELECT * in production), transactional isolation, and index-backed query plans.",
