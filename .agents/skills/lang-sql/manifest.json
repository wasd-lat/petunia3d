  "modes": [
    "implementation",
    "review",
    "testing"
  ],
  "inputs": [
    "Source code",
    "Schema/Configuration",
    "Task acceptance criteria"
  ],
  "outputs": [
    "Conforming source code/configuration",
    "Verification evidence"
  ],
  "requires": [
    "clean-code",
    "testing-quality"
  ],
  "conflicts": [],
  "capabilities": [
    "filesystem.read",
    "filesystem.write",
    "process.spawn"
  ],
  "references": [
    "references/sql-indexing-transactions.md"
  ],
  "templates": [
    "templates/sql-migration-report.md"
  ],
  "checks": [
    "checks/sql-safety.md"
  ],
  "scripts": [
    "scripts/verify.sh"
  ],
  "examples": [
    "examples/safe_migration.sql"
  ],
  "required_evidence": [
    "test",
    "migration-verify",
    "query-plan"
  ],
  "stop_conditions": [
