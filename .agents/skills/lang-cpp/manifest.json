{
  "id": "lang-cpp",
  "name": "Modern C++ Engineering & Extreme Safety",
  "version": 2,
  "schema_version": 3,
  "purpose": "Enforce modern C++ (C++20/C++23) standards, RAII ownership, zero raw pointer bugs, sanitizers, static analysis, and non-negotiable memory safety.",
  "risk_level": "critical",
  "modes": [
    "implementation",
    "review",
    "testing",
    "audit"
  ],
  "inputs": [
    "C++ source and header files",
    "Build configuration (CMake / Meson)",
    "Active task acceptance criteria"
  ],
  "outputs": [
    "Hardened modern C++ implementation",
    "Sanitizer and static analysis evidence",
    "Exhaustive test suite evidence",
    "Escape-hatch audit log"
  ],
  "requires": [
    "clean-code",
    "testing-quality"
  ],
  "conflicts": [],
  "capabilities": [
    "filesystem.read",
    "filesystem.write",
    "process.spawn"
  ],
  "references": [
    "references/memory-model-lifetime.md",
    "references/sanitizers-and-tooling.md",
    "references/ai-coding-contract.md"
  ],
  "templates": [
    "templates/escape-hatch-waiver.md",
    "templates/cpp-verification-report.md"
  ],
  "checks": [
    "checks/forbidden-patterns.md",
    "checks/compiler-flags.md",
    "checks/clang-tidy-rules.md"
  ],
  "scripts": [
    "scripts/verify.sh"
  ],
  "examples": [
    "examples/raii-ownership.cpp"
  ],
  "required_evidence": [
    "test",
    "build",
    "lint"
  ],
  "stop_conditions": [
    "Task acceptance criteria satisfied with evidence",
    "Zero compiler warnings with -Werror",
    "Zero sanitizer findings (ASan, UBSan)",
    "Token budget exhausted",
    "Blocked on external dependency"
  ],
  "provenance": {
    "origin": "framework",
