    "modified": "2026-09-23"
  },
  "select": {
    "stack_any": [
      "cpp",
      "c++",
      "cxx",
      "clang",
      "gcc",
      "cmake"
    ]
  },
  "requires_any": [],
  "tools": [
    "check-escape-hatches"
  ]
}
