{
  "id": "visual-qa",
  "name": "Visual Quality Assurance (Visual QA)",
  "version": 2,
  "schema_version": 3,
  "purpose": "Inspect, audit, and certify the visual fidelity of implemented user interfaces against canonical design specifications (Figma), 4pt/8pt spatial rhythm, and typography scale.",
  "risk_level": "low",
  "modes": [
    "testing",
    "review",
    "audit",
    "design"
  ],
  "inputs": [
    "Product requirements",
    "Design tokens",
    "Figma / UI design specifications",
    "Target viewport breakpoints"
  ],
  "outputs": [
    "Visual QA audit report",
    "Design parity scorecard",
    "Visual bug punch list",
    "CSS remediation snippets"
  ],
  "requires": [],
  "conflicts": [],
  "capabilities": [
    "filesystem.read",
    "filesystem.write",
    "process.spawn"
  ],
  "references": [
    "references/visual-qa-guide.md"
  ],
  "templates": [
    "templates/visual-qa-report.md"
  ],
  "checks": [
    "checks/visual-qa-checklist.md"
  ],
  "scripts": [
    "scripts/verify.sh"
  ],
  "examples": [
    "examples/visual_qa_audit_sample.md"
  ],
  "required_evidence": [
    "test",
    "review"
  ],
  "stop_conditions": [
    "Task acceptance criteria satisfied with evidence",
    "Design-to-code parity reaches target threshold (>=95%)",
    "Token budget exhausted",
    "Blocked on external dependency"
  ],
