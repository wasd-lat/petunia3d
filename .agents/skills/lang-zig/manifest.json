    "filesystem.read",
    "filesystem.write",
    "process.spawn"
  ],
  "references": [
    "references/zig-allocators.md"
  ],
  "templates": [
    "templates/zig-verification-report.md"
  ],
  "checks": [
    "checks/zig-rules.md"
  ],
  "scripts": [
    "scripts/verify.sh"
  ],
  "examples": [
    "examples/safe-alloc.zig"
  ],
  "required_evidence": [
    "test",
    "build",
    "lint"
  ],
  "stop_conditions": [
