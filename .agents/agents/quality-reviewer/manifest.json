{
  "id": "quality-reviewer",
  "name": "Quality Reviewer",
  "version": 2,
  "purpose": "Review maintainability, clean engineering standards, and project quality budgets.",
  "risk_level": "low",
  "select": {
    "risk_any": [
      "quality"
    ],
    "features_any": [
      "code-quality"
    ]
  },
  "inputs": [
    "Changeset diff",
    "Quality metrics",
    "Clean code standards"
  ],
  "outputs": [
    "Quality scorecard",
    "Refactoring suggestions"
  ],
  "required_skills": [
    "clean-code",
    "architecture-quality"
  ],
  "optional_skills": [
    "code-quality",
    "error-handling"
  ],
  "allowed_capabilities": [
    "filesystem.read",
    "git.read"
  ],
  "required_evidence": [
    "review"
  ],
  "may_delegate": false,
  "max_delegation_depth": 0,
  "handoff_to": [
    "implementer"
  ],
  "review_requirement": "none",
  "permissions": {
    "write_code": false,
    "modify_docs": true,
    "execute_tests": true
  },
  "stop_conditions": [
    "Quality review report emitted"
  ],
  "required_capabilities": [
    "filesystem.read",
    "git.read"
  ]
}
