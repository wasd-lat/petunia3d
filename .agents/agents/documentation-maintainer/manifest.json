{
  "id": "documentation-maintainer",
  "name": "Documentation Maintainer",
  "version": 2,
  "core": true,
  "purpose": "Keep canonical Markdown documentation, docs/PRUMO.md, and user/developer/operations docs aligned with implementation.",
  "risk_level": "low",
  "inputs": [
    "Changeset delta",
    "Affected canonical docs",
    "Updated API contracts"
  ],
  "outputs": [
    "Updated canonical Markdown documentation",
    "Synchronized docs/PRUMO.md index"
  ],
  "required_skills": [
    "documentation",
    "lean-progressive-context"
  ],
  "optional_skills": [
    "documentation-for-llms"
  ],
  "allowed_capabilities": [
    "filesystem.read",
    "filesystem.write"
  ],
  "required_evidence": [
    "review"
  ],
  "may_delegate": false,
  "max_delegation_depth": 0,
  "handoff_to": [
    "reviewer",
    "release-verifier"
  ],
  "review_requirement": "none",
  "permissions": {
    "write_code": false,
    "modify_docs": true,
    "execute_tests": false
  },
  "stop_conditions": [
    "All impacted canonical docs synchronized without drift"
  ],
  "required_capabilities": [
    "filesystem.read",
    "filesystem.write"
  ]
}
