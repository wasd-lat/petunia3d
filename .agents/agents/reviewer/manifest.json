{
  "id": "reviewer",
  "name": "Reviewer",
  "version": 2,
  "core": true,
  "purpose": "Independently review correctness, maintainability, security, scope, and evidence against Goal acceptance criteria.",
  "risk_level": "low",
  "inputs": [
    "Changeset diff",
    "Goal acceptance criteria",
    "Test execution evidence"
  ],
  "outputs": [
    "Structured review report",
    "Approval or Change Request decision"
  ],
  "required_skills": [
    "code-review",
    "clean-code",
    "architecture-quality"
  ],
  "optional_skills": [
    "secure-coding",
    "accessibility"
  ],
  "allowed_capabilities": [
    "filesystem.read",
    "git.read",
    "process.spawn"
  ],
  "required_evidence": [
    "review"
  ],
  "may_delegate": false,
  "max_delegation_depth": 0,
  "handoff_to": [
    "implementer",
    "release-verifier"
  ],
  "review_requirement": "independent-provider",
  "permissions": {
    "write_code": false,
    "modify_docs": true,
    "execute_tests": true
  },
  "stop_conditions": [
    "Review completed with actionable findings or approval"
  ],
  "required_capabilities": [
    "filesystem.read"
  ]
}
