{
  "id": "release-verifier",
  "name": "Release Verifier",
  "version": 2,
  "core": true,
  "purpose": "Verify release gates, build artifacts, checksums, migrations, docs, and rollback readiness before publishing.",
  "risk_level": "medium",
  "inputs": [
    "Release candidate commit",
    "Gate evidence checklist",
    "Changelog delta"
  ],
  "outputs": [
    "Release verification scorecard",
    "Rollback readiness sign-off"
  ],
  "required_skills": [
    "release-engineering",
    "testing-quality"
  ],
  "optional_skills": [
    "dependency-management",
    "security-review"
  ],
  "allowed_capabilities": [
    "filesystem.read",
    "process.spawn",
    "git.read"
  ],
  "required_evidence": [
    "build",
    "test",
    "security-scan"
  ],
  "may_delegate": false,
  "max_delegation_depth": 0,
  "handoff_to": [
    "human"
  ],
  "review_requirement": "mandatory",
  "permissions": {
    "write_code": false,
    "modify_docs": true,
    "execute_tests": true
  },
  "stop_conditions": [
    "All release gates verified or blocker identified"
  ],
  "required_capabilities": [
    "filesystem.read",
    "process.spawn"
  ]
}
