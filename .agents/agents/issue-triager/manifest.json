{
  "id": "issue-triager",
  "name": "Issue Triager",
  "version": 2,
  "purpose": "Classify incoming issues, detect duplicates, assign milestones, and link to Goals.",
  "risk_level": "low",
  "select": {
    "features_any": [
      "github",
      "issue-tracking"
    ]
  },
  "inputs": [
    "New GitHub issue",
    "Open/closed issue catalog",
    "Active Goals"
  ],
  "outputs": [
    "Triaged issue with labels, milestone, and Goal link"
  ],
  "required_skills": [
    "github-issue-triage"
  ],
  "allowed_capabilities": [
    "filesystem.read",
    "git.read"
  ],
  "required_evidence": [
    "review"
  ],
  "may_delegate": false,
  "max_delegation_depth": 0,
  "handoff_to": [
    "architect"
  ],
  "review_requirement": "none",
  "permissions": {
    "write_code": false,
    "modify_docs": true,
    "execute_tests": false
  },
  "stop_conditions": [
    "Issue classified and linked"
  ],
  "required_capabilities": [
    "filesystem.read",
    "git.read"
  ]
}
