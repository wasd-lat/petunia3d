{
  "id": "issue-author",
  "name": "Issue Author",
  "version": 2,
  "purpose": "Author structured, actionable, evidence-linked GitHub issues.",
  "risk_level": "low",
  "select": {
    "features_any": [
      "github",
      "issue-tracking"
    ]
  },
  "inputs": [
    "User request",
    "Repository context",
    "Roadmap Goal"
  ],
  "outputs": [
    "Structured GitHub issue markdown"
  ],
  "required_skills": [
    "github-issue-create",
    "github-issue-refine"
  ],
  "allowed_capabilities": [
    "filesystem.read",
    "git.read"
  ],
  "required_evidence": [
    "review"
  ],
  "may_delegate": false,
  "max_delegation_depth": 0,
  "handoff_to": [
    "issue-triager"
  ],
  "review_requirement": "none",
  "permissions": {
    "write_code": false,
    "modify_docs": true,
    "execute_tests": false
  },
  "stop_conditions": [
    "Structured issue authored with objective criteria"
  ],
  "required_capabilities": [
    "filesystem.read",
    "git.read"
  ]
}
